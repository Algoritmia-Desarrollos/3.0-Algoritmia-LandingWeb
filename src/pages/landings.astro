---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logoAlgoritmia1.webp';

// Imágenes a poner en /public/images/webs/ (si faltan, hay placeholder).
const showcaseTabs = [
  { id: 'landing-page',    label: 'Página Única',        img: '/images/webs/landing-page.webp',     desc: "Una sola página, una sola misión: que la gente que entra termine comprando. Mensaje claro, cero distracción. <strong>Bajamos el costo por lead un 57%.</strong>" },
  { id: 'un-producto',     label: '1 Solo Producto',     img: '/images/webs/un-producto.webp',      desc: "Web mono-producto al estilo Apple. Pensada para escalar con pauta en frío y subir el ticket promedio. <strong>Subimos el ticket promedio un 38%.</strong>" },
  { id: 'varios-productos',label: 'Varios Productos',    img: '/images/webs/varios-productos.webp', desc: "Catálogo con foco en venta cruzada. Combos, productos relacionados y descripciones que hacen que el cliente termine llevando más de lo que pensaba." },
  { id: 'tiendas-online',  label: 'Tiendas Online',      img: '/images/webs/tiendas-online.webp',   desc: "Tienda completa en Shopify o Tiendanube. Carrito sin fricción, catálogo claro y métricas conectadas desde el día 1. <strong>+62% de conversión promedio.</strong>" },
  { id: 'institucional',   label: 'Institucionales',     img: '/images/webs/institucional.webp',    desc: "Web corporativa que transmite autoridad y carga en menos de 1 segundo. Pensada para cerrar reuniones, no para ganar premios de diseño." },
  { id: 'servicios-pro',   label: 'Servicios Profesionales', img: '/images/webs/servicios.webp',    desc: "Web para abogados, médicos, consultores y clínicas. Agenda integrada, formulario que filtra leads y posicionamiento premium." },
  { id: 'viajes',          label: 'Agencia de Viajes',   img: '/images/webs/viajes.webp',           desc: "Web para agencias de turismo con catálogo de destinos, búsqueda por presupuesto y formularios conectados a WhatsApp. <strong>Vendés experiencias, no paquetes.</strong>" },
  { id: 'mayorista',       label: 'Mayorista B2B',       img: '/images/webs/mayorista.webp',        desc: "Tienda mayorista con grilla por categoría, precios por volumen y compra fraccionada. Catálogo que convierte revendedores en clientes que vuelven." },
  { id: 'inmobiliaria',    label: 'Arquitectura',        img: '/images/webs/inmobiliaria.webp',     desc: "Web editorial premium para estudios de arquitectura e inmobiliarias. Tipografía bestial, fichas de proyecto pensadas para SEO y look internacional." }
];

const platforms = [
  { name: 'Shopify',     logo: '/images/platforms/shopify-bag.webp' },
  { name: 'Tiendanube',  logo: '/images/platforms/tiendanubeoscuro.png' },
  { name: 'WordPress',   logo: '/images/platforms/logowordpress.webp' },
  { name: 'React',       logo: '/images/platforms/react.svg' },
  { name: 'Next.js',     logo: '/images/platforms/nextjs.svg' },
  { name: 'Astro',       logo: '/images/platforms/astro.svg' },
  { name: 'TypeScript',  logo: '/images/platforms/typescript.svg' },
  { name: 'JavaScript',  logo: '/images/platforms/javascript.svg' },
  { name: 'HTML5',       logo: '/images/platforms/html5.svg' },
  { name: 'CSS3',        logo: '/images/platforms/css3.svg' },
  { name: 'Tailwind CSS',logo: '/images/platforms/tailwindcss.svg' },
  { name: 'Supabase',    logo: '/images/platforms/supabase.svg' },
  { name: 'Node.js',     logo: '/images/platforms/nodejs.svg' },
  { name: 'Vercel',      logo: '/images/platforms/vercel.svg' },
  { name: 'Figma',       logo: '/images/platforms/figma.svg' }
];

// Qué se lleva el cliente — lista de entregables concretos que vende el servicio
const entregables = [
  { icon: 'palette',       title: 'Diseño 100% custom',         desc: 'Cero templates de Themeforest. Cada sección dibujada en Figma y aprobada por vos.' },
  { icon: 'edit_note',     title: 'Copy estratégico incluido',  desc: 'Headlines, subtítulos y CTAs escritos por nosotros con frameworks probados (PAS / AIDA).' },
  { icon: 'speed',         title: 'Velocidad Lighthouse 95+',   desc: 'Optimización técnica para que tu web cargue en menos de 1.2 segundos en móvil 4G.' },
  { icon: 'analytics',     title: 'Tracking impecable',         desc: 'GA4, Meta Pixel + CAPI, eventos custom. Datos limpios para escalar pauta desde el día 1.' },
  { icon: 'auto_awesome',  title: 'SEO técnico desde el día 1', desc: 'Schema markup, sitemap, robots, OG images y meta correctos. No quedás invisible en Google.' },
  { icon: 'dns',           title: 'Hosting + dominio listo',    desc: 'Te configuramos Vercel, dominio, SSL y emails corporativos. Llegás a producción sin tocar nada.' },
  { icon: 'code_blocks',   title: 'Código tuyo, documentado',   desc: 'Repositorio en tu GitHub, README claro. Si querés cambiar de proveedor, lo hacés sin perder nada.' },
  { icon: 'handshake',     title: 'Soporte 30 días post-launch', desc: 'Primer mes de ajustes ilimitados incluido. Si algo no convierte, lo arreglamos.' }
];

const proceso = [
  { n: '01', title: 'Briefing estratégico', desc: 'Una llamada de 45 minutos. Entendemos negocio, oferta y a quién le vendés. Sin formularios infinitos.' },
  { n: '02', title: 'Diseño en Figma',      desc: 'Mockup completo antes de tocar código. Aprobás cada sección con su copy. Cero sorpresas.' },
  { n: '03', title: 'Desarrollo + Copy',    desc: 'Programación + redacción con frameworks probados (PAS / AIDA). Vos validás cada sección.' },
  { n: '04', title: 'QA y lanzamiento',     desc: 'Testing en 5 dispositivos, Lighthouse 95+, pixel y tracking conectados, dominio en producción.' },
  { n: '05', title: 'Optimización mes 1',   desc: 'Revisamos Hotjar / GA4 y ajustamos lo que no convierte. Incluido sin costo extra.' }
];



const testimonials = [
  { title: 'The Skirting Factory',   stat: '+300% ventas el 1º mes',         cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-skirting.webp',     video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/manuel-descartes.mp4', tag: 'E-commerce USA' },
  { title: 'Librería Mayorista Leo', stat: '$150K USD anuales',              cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-libreria-leo.webp', video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/libreria-leo.mp4',    tag: 'Mayorista B2B' },
  { title: 'Puertas Blindadas Jack', stat: 'x10 ventas High Ticket',         cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-jack.webp',       video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/puertas-jack.mp4',    tag: 'High Ticket' },
  { title: 'Dr. Juan Tesari',        stat: '+300 consultas / mes',           cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-juan.webp',         video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/juan-tesari.mp4',     tag: 'Salud / Servicios' },
  { title: 'Atérmicos Pinamar',      stat: '+15 contratos High Ticket / mes', cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-atermicos.webp', video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/atermicos-pinamar.mp4', tag: 'Construcción Premium' },
  { title: 'Case Rossi',             stat: 'ROAS récord 70x',                cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-case-rossi.webp',  video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/case-rossi.mp4',     tag: 'E-commerce Diseño' }
];

const faqs = [
  {
    q: '¿En cuánto tiempo está mi web lista?',
    a: '<strong class="text-zinc-900">En 7 días una web simple. 3 a 5 semanas una tienda con catálogo grande.</strong><br/><br/>La fecha exacta va cerrada en la propuesta. Sin "te aviso", sin "la semana que viene", sin "lo veo con el equipo". Fecha. Cerrada.'
  },
  {
    q: '¿Cuánto cuesta?',
    a: '<strong class="text-zinc-900">Desde USD 250.</strong><br/>Sí, leíste bien.<br/><br/>El número exacto depende de qué necesites (una web simple, una tienda con catálogo, una web corporativa). En la primera llamada salís con propuesta cerrada y número final. No "te lo paso por mail mañana". Número en la llamada.'
  },
  {
    q: '¿Y si la web no me hace vender más?',
    a: '<strong class="text-zinc-900">Te devolvemos el 100% de la plata.</strong><br/><br/>De más de 300 webs que hicimos, 1 sola pidió devolución. Se la dimos. El único que arriesga algo acá somos nosotros.'
  },
  {
    q: '¿Quién hace el copy y el diseño?',
    a: '<strong class="text-zinc-900">Nosotros.</strong><br/><br/>Venimos de gestionar más de USD 2M en Meta Ads — sabemos qué frena el scroll, qué hace clickear y qué hace cerrar la pestaña. Esa cabeza la metemos en cada headline y cada sección.<br/><br/>Vos validás cada parte antes de que toquemos código. Cero sorpresas en el live.'
  },
  {
    q: '¿Trabajan con mi marca o tengo que tener una?',
    a: '<strong class="text-zinc-900">Si ya tenés marca, la respetamos. Si no, te ayudamos a armarla.</strong><br/><br/>Diseño 100% custom. Cero plantillas. Si querías eso, hay 14.000 freelancers en Fiverr esperándote por USD 80.'
  },
  {
    q: '¿Por qué Algoritmia y no una agencia grande con 14 personas?',
    a: '<strong class="text-zinc-900">Porque venimos de pautear, no de hacer slides.</strong><br/><br/>Cada web la diseñamos pensando cómo se comporta el tráfico pago — dónde rebota, dónde se traba, dónde cliquea. Eso una agencia que solo programa no lo tiene. Y una que solo diseña, menos.<br/><br/>Además: cobramos lo que cobramos porque hacemos 10 al mes en vez de 2 sobrepreciadas. La diferencia se la queda el cliente, no LinkedIn.'
  },
  {
    q: '¿Y si soy de afuera de Argentina?',
    a: '<strong class="text-zinc-900">También.</strong> Trabajamos con clientes en USA, México, España y Chile.<br/><br/>Las llamadas son por Zoom, las firmas digitales, los pagos por transferencia o Stripe. La distancia no es problema. La indecisión sí.'
  }
];
---

<Layout
  title="Diseño y Desarrollo Web · Shopify · Tiendanube · Landings | Algoritmia"
  description="Hacemos webs, tiendas Shopify, tiendas Tiendanube y landing pages diseñadas para convertir tráfico pago en ventas reales. Más de 100 clientes."
  noindex={true}
>

  <!-- NAVBAR -->
  <header class="fixed top-0 left-0 right-0 z-[100] bg-white/90 backdrop-blur-xl border-b border-zinc-200/70">
    <div class="max-w-7xl mx-auto px-4 md:px-8 h-14 md:h-16 flex items-center justify-between">
      <a href="/landings" class="flex items-center gap-2.5">
        <Image src={logo} alt="Algoritmia" class="w-8 h-8 md:w-9 md:h-9 object-contain" />
        <span class="text-[15px] md:text-[16px] font-black tracking-tight text-zinc-900 font-display">Algoritmia</span>
      </a>
      <a href="#contacto" class="bg-indigo-600 text-white px-4 md:px-5 h-9 md:h-10 inline-flex items-center gap-2 rounded-full text-[12px] md:text-[13px] font-bold shadow-md shadow-indigo-600/25">
        Empecemos
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </header>

  <main class="bg-white text-zinc-900">

    <!-- =================== HERO =================== -->
    <section class="relative pt-28 sm:pt-48 pb-24 lg:pb-32 overflow-hidden">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-violet-400/5 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="max-w-[1400px] mx-auto px-3 sm:px-6 text-center relative z-10">
        <!-- Badge arriba del h1 -->
        <div class="flex justify-center mb-5 sm:mb-8">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-zinc-200 bg-white shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-500 animate-pulse"></span>
            <span class="text-[10.5px] md:text-[11px] font-bold text-zinc-700 uppercase tracking-[0.2em]">+300 webs que convierten realmente</span>
          </span>
        </div>

        <h1 class="font-semibold tracking-tighter max-w-4xl mx-auto mb-3 sm:mb-5 animate-in fade-in slide-in-from-bottom-5 duration-700 text-[32px] sm:text-5xl md:text-[62px] lg:text-[72px] leading-[1.1] sm:leading-[1.05] text-zinc-900">
          Tu web no vende.<br/>
          <span class="bg-violet-50 text-zinc-900 px-4 sm:px-6 py-1 sm:py-2 rounded-2xl inline-block mt-1 sm:mt-2 border border-violet-100 shadow-sm font-bold">Hacemos una que sí.</span>
        </h1>

        <p class="text-[14px] sm:text-[17px] md:text-xl max-w-2xl mx-auto leading-relaxed mb-8 sm:mb-12 text-zinc-500 font-normal whitespace-nowrap">
          Si no convierte, <strong class="text-zinc-900 font-semibold">te devolvemos la plata</strong>.
        </p>

        <div class="flex flex-col items-center gap-3 mb-12 sm:mb-20">
          <div class="flex items-center justify-center">
            <a href="#contacto" class="btn-hero-pulse group w-full sm:w-auto h-12 px-8 font-bold uppercase tracking-wider rounded-xl text-[13px] flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white transition-colors duration-300 active:scale-95">
              Quiero mi web
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>

        <!-- Showcase Hero (CAR-SaaS exact pattern) -->
        <div id="hero-showcase" class="relative max-w-6xl lg:max-w-[1400px] mx-auto mt-12 lg:mt-16 -mx-3 sm:mx-auto animate-in fade-in zoom-in-95 duration-1000">
          <div class="w-full rounded-none sm:rounded-[22px] border p-0 sm:p-1 bg-zinc-950/20 border-zinc-200/35 shadow-xl">
            <div class="rounded-none sm:rounded-[18px] border bg-white border-zinc-200/45 overflow-hidden">

              <!-- Tabs -->
              <div class="flex overflow-x-auto whitespace-nowrap border-b p-1.5 gap-1 border-zinc-200/50 bg-zinc-50/40 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                {showcaseTabs.map((tab, i) => (
                  <button
                    data-tab-id={tab.id}
                    class={`showcase-tab h-6 md:h-[25px] px-2.5 rounded-md text-[10px] md:text-[11px] font-bold transition-all flex items-center justify-center relative shrink-0 ${i === 0 ? 'is-active bg-zinc-900 text-white shadow-sm' : 'text-zinc-500 hover:text-zinc-700 hover:bg-zinc-100/80'}`}
                  >
                    {tab.label}
                    <span class="tab-dot absolute -top-0.5 -right-0.5 w-1.5 h-1.5 rounded-full bg-violet-500 animate-pulse opacity-0"></span>
                  </button>
                ))}
              </div>

              <!-- Progress bar -->
              <div class="h-[3px] overflow-hidden bg-zinc-200 relative">
                <div id="hero-progress-bar" class="h-full bg-gradient-to-r from-violet-500 via-violet-500 to-violet-400 shadow-[0_0_12px_rgba(139,92,246,0.6)]"></div>
              </div>

              <!-- Image area -->
              <div class="relative overflow-hidden bg-zinc-50" style="aspect-ratio: 1600/900;">
                {showcaseTabs.map((tab, i) => (
                  <div
                    data-pane={tab.id}
                    data-desc={tab.desc}
                    data-label={tab.label}
                    class={`showcase-pane absolute inset-0 transition-opacity duration-500 ease-out ${i === 0 ? 'opacity-100 z-20' : 'opacity-0 z-10'}`}
                  >
                    <img
                      src={tab.img}
                      alt={`Antes y después — ${tab.label}`}
                      loading="eager"
                      decoding="async"
                      class="w-full h-full object-cover object-top"
                      onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                    />
                    <!-- Placeholder simple (web próximamente) -->
                    <div class="hidden absolute inset-0 flex flex-col items-center justify-center gap-3 bg-gradient-to-br from-zinc-50 to-zinc-100 text-zinc-400">
                      <svg class="w-14 h-14 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                      <p class="text-[11px] font-black uppercase tracking-widest text-zinc-500">Vista previa próximamente</p>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Tab description -->
              <div class="h-[118px] sm:h-[98px] md:h-[86px] px-4 sm:px-5 py-2.5 border-t border-zinc-100 bg-zinc-50/60 flex items-start gap-3 text-left">
                <div class="w-1.5 h-1.5 rounded-full mt-1.5 shrink-0 bg-violet-500"></div>
                <div class="min-w-0 flex-1 md:max-w-2xl lg:max-w-3xl">
                  <p id="hero-tab-label" class="text-[11px] font-black uppercase tracking-wider mb-1 text-zinc-700">{showcaseTabs[0].label}</p>
                  <p id="hero-tab-desc" class="text-[11.5px] sm:text-[12px] leading-relaxed font-medium text-zinc-500 [&_strong]:font-black [&_strong]:text-zinc-800" set:html={showcaseTabs[0].desc}></p>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =================== LOGO MARQUEE =================== -->
    <section class="py-8 lg:py-10 border-t border-b bg-zinc-50/30 border-zinc-200/40">
      <p class="text-center text-[9px] font-bold text-zinc-400 uppercase tracking-[0.2em] font-sans mb-4 px-6">
        Stack técnico · Partners certificados · Diseño profesional
      </p>
      <div class="relative w-full flex overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
        <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>
        <div class="logo-marquee-track py-2 gap-4 sm:gap-8 md:gap-12">
          {[...platforms, ...platforms].map((p, idx) => (
            <div class="flex items-center gap-2.5 sm:gap-3.5 opacity-80 hover:opacity-100 transition-all duration-300 cursor-pointer h-10 sm:h-12 px-3.5 sm:px-5 rounded-xl sm:rounded-2xl bg-zinc-200/10 border border-transparent hover:border-violet-500/15">
              <img src={p.logo} alt={p.name} class="h-5 sm:h-7 object-contain max-w-[84px] sm:max-w-[120px]" />
              <span class="text-[11px] sm:text-[12px] font-bold tracking-tight whitespace-nowrap text-zinc-700">{p.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =================== FILOSOFÍA =================== -->
    <section class="py-24 lg:py-28 px-3 sm:px-6 md:px-12 bg-zinc-950 text-white relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-violet-500/10 blur-[160px] rounded-full pointer-events-none"></div>
      <div class="max-w-5xl mx-auto text-center space-y-7 relative z-10">
        <p class="text-[10.5px] uppercase tracking-[0.22em] text-violet-400 font-bold">Filosofía</p>
        <h2 class="text-[26px] md:text-5xl font-semibold tracking-tighter text-white leading-tight mb-7">
          Diseño con un solo fin:<br/>
          <span class="text-zinc-400">convertir tu tráfico en clientes.</span>
        </h2>
        <p class="text-white/70 text-lg leading-relaxed font-normal max-w-2xl mx-auto">
          Estructuramos cada sección con lógica de embudo. Sabemos exactamente qué hace que un usuario abandone una página y qué lo impulsa a comprar, optimizando tu web al máximo.
        </p>
      </div>
    </section>

    <!-- =================== CASO REAL: PDP =================== -->
    <section id="caso-pdp" class="py-24 lg:py-28 px-3 sm:px-6 md:px-12 bg-white relative overflow-hidden">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-violet-500/5 blur-[140px] rounded-full pointer-events-none"></div>
      <div class="max-w-[1400px] mx-auto relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-violet-200 bg-violet-50 mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-500 animate-pulse"></span>
            <span class="text-[10.5px] font-black text-violet-700 uppercase tracking-[0.18em]">Caso real · Sin tocar la pauta</span>
          </div>
          <h2 class="text-[26px] md:text-5xl font-semibold tracking-tight text-zinc-900 leading-tight mb-5">
            Conseguimos <span class="text-violet-600 font-bold">x2.7</span> de ventas.
          </h2>
          <p class="text-zinc-500/80 text-[14px] sm:text-lg leading-relaxed max-w-2xl mx-auto font-normal">
            Mismo producto. Mismo tráfico. Misma plata en ads.<br/>
            <strong class="text-zinc-900 font-semibold">Lo único que cambiamos fue la web.</strong>
          </p>
          <p class="text-zinc-900 text-[16px] md:text-xl leading-snug max-w-2xl mx-auto mt-6 font-semibold">
            Ahora imaginate esto pasando con <span class="text-violet-600 font-bold">tu negocio</span>.
          </p>
        </div>

        <div class="rounded-[22px] border border-zinc-200/60 bg-white p-1.5 shadow-2xl shadow-zinc-900/10">
          <div
            id="pdp-compare"
            class="relative rounded-[18px] overflow-hidden border border-zinc-100 select-none cursor-ew-resize touch-none aspect-[4/3] sm:aspect-[16/10] md:aspect-[1600/900]"
          >
            <!-- ANTES: imagen base full -->
            <img
              src="/images/webs/pdp-antes.webp"
              alt="Antes — ficha básica, 0,7% conversión"
              class="absolute inset-0 w-full h-full object-cover object-top pointer-events-none"
              draggable="false"
            />
            <!-- DESPUÉS: clipeada desde la derecha por --x -->
            <div
              id="pdp-compare-after"
              class="absolute inset-0 overflow-hidden pointer-events-none"
