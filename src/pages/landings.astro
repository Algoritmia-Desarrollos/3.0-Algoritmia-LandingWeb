---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logoAlgoritmia1.webp';

// Imágenes a poner en /public/images/webs/ (si faltan, hay placeholder).
const showcaseTabs = [
  { id: 'landing-page',    label: 'Landing Page',        img: '/images/webs/landing-page.webp',     desc: "Página única para tráfico frío de Meta y Google Ads. Mensaje claro, formulario calificador, cero distracción. <strong>Costo por lead ‑57%.</strong>" },
  { id: 'un-producto',     label: '1 Solo Producto',     img: '/images/webs/un-producto.webp',      desc: "Landing mono-producto al estilo Apple. Una sola misión: vender ese producto. Pensada para escalar con pauta en frío. <strong>AOV +38%.</strong>" },
  { id: 'varios-productos',label: 'Varios Productos',    img: '/images/webs/varios-productos.webp', desc: "Catálogo con foco en cross-sell. Bundles, productos relacionados y descripciones extendidas que disparan el ticket promedio." },
  { id: 'tiendas-online',  label: 'Tiendas Online',      img: '/images/webs/tiendas-online.webp',   desc: "E-commerce completo en Shopify o Tiendanube. Checkout sin fricción, catálogo claro y métricas conectadas desde el día 1. <strong>+62% conversión promedio.</strong>" },
  { id: 'institucional',   label: 'Institucionales',     img: '/images/webs/institucional.webp',    desc: "Sitio corporativo que comunica autoridad. Astro o Next.js con carga sub-segundo. <strong>Lighthouse 95+</strong> y SEO técnico cuidado." },
  { id: 'servicios-pro',   label: 'Servicios Profesionales', img: '/images/webs/servicios.webp',    desc: "Web para abogados, médicos, consultores y clínicas. Calendario integrado, formulario calificador y posicionamiento premium." },
  { id: 'viajes',          label: 'Agencia de Viajes',   img: '/images/webs/viajes.webp',           desc: "Sitio para agencias de turismo con catálogo de destinos, búsqueda por presupuesto y formularios conectados a WhatsApp. <strong>Pensado para vender experiencias.</strong>" },
  { id: 'mayorista',       label: 'Mayorista B2B',       img: '/images/webs/mayorista.webp',        desc: "Tienda mayorista con grilla editorial por categoría, precios por volumen y compra fraccionada. Catálogo claro que convierte revendedores en clientes fijos." },
  { id: 'inmobiliaria',    label: 'Arquitectura',        img: '/images/webs/inmobiliaria.webp',     desc: "Sitio editorial premium para estudios de arquitectura e inmobiliarias. Tipografía bestial, fichas de proyecto SEO-friendly y look internacional." }
];

const platforms = [
  { name: 'Shopify',     logo: '/images/platforms/shopify-bag.webp' },
  { name: 'Tiendanube',  logo: '/images/platforms/tiendanubeoscuro.png' },
  { name: 'WordPress',   logo: '/images/platforms/logowordpress.webp' },
  { name: 'React',       logo: '/images/platforms/react.svg' },
  { name: 'Next.js',     logo: '/images/platforms/nextjs.svg' },
  { name: 'Astro',       logo: '/images/platforms/astro.svg' },
  { name: 'TypeScript',  logo: '/images/platforms/typescript.svg' },
  { name: 'JavaScript',  logo: '/images/platforms/javascript.svg' },
  { name: 'HTML5',       logo: '/images/platforms/html5.svg' },
  { name: 'CSS3',        logo: '/images/platforms/css3.svg' },
  { name: 'Tailwind CSS',logo: '/images/platforms/tailwindcss.svg' },
  { name: 'Supabase',    logo: '/images/platforms/supabase.svg' },
  { name: 'Node.js',     logo: '/images/platforms/nodejs.svg' },
  { name: 'Vercel',      logo: '/images/platforms/vercel.svg' },
  { name: 'Figma',       logo: '/images/platforms/figma.svg' }
];

// Qué se lleva el cliente — lista de entregables concretos que vende el servicio
const entregables = [
  { icon: 'palette',       title: 'Diseño 100% custom',         desc: 'Cero templates de Themeforest. Cada sección dibujada en Figma y aprobada por vos.' },
  { icon: 'edit_note',     title: 'Copy estratégico incluido',  desc: 'Headlines, subtítulos y CTAs escritos por nosotros con frameworks probados (PAS / AIDA).' },
  { icon: 'speed',         title: 'Velocidad Lighthouse 95+',   desc: 'Optimización técnica para que tu web cargue en menos de 1.2 segundos en móvil 4G.' },
  { icon: 'analytics',     title: 'Tracking impecable',         desc: 'GA4, Meta Pixel + CAPI, eventos custom. Datos limpios para escalar pauta desde el día 1.' },
  { icon: 'auto_awesome',  title: 'SEO técnico desde el día 1', desc: 'Schema markup, sitemap, robots, OG images y meta correctos. No quedás invisible en Google.' },
  { icon: 'dns',           title: 'Hosting + dominio listo',    desc: 'Te configuramos Vercel, dominio, SSL y emails corporativos. Llegás a producción sin tocar nada.' },
  { icon: 'code_blocks',   title: 'Código tuyo, documentado',   desc: 'Repositorio en tu GitHub, README claro. Si querés cambiar de proveedor, lo hacés sin perder nada.' },
  { icon: 'handshake',     title: 'Soporte 30 días post-launch', desc: 'Primer mes de ajustes ilimitados incluido. Si algo no convierte, lo arreglamos.' }
];

const proceso = [
  { n: '01', title: 'Briefing estratégico', desc: 'Una llamada de 45 minutos. Entendemos negocio, oferta y a quién le vendés. Sin formularios infinitos.' },
  { n: '02', title: 'Diseño en Figma',      desc: 'Mockup completo antes de tocar código. Aprobás cada sección con su copy. Cero sorpresas.' },
  { n: '03', title: 'Desarrollo + Copy',    desc: 'Programación + redacción con frameworks probados (PAS / AIDA). Vos validás cada sección.' },
  { n: '04', title: 'QA y lanzamiento',     desc: 'Testing en 5 dispositivos, Lighthouse 95+, pixel y tracking conectados, dominio en producción.' },
  { n: '05', title: 'Optimización mes 1',   desc: 'Revisamos Hotjar / GA4 y ajustamos lo que no convierte. Incluido sin costo extra.' }
];

const testimonials = [
  { title: 'The Skirting Factory',     stat: 'Gracias a su web: +300% ventas el 1º mes',     cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-skirting.webp',     video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/manuel-descartes.mp4', tag: 'E-commerce USA' },
  { title: 'Dr. Juan Tesari',          stat: 'Gracias a su landing: +300 consultas/mes',     cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-juan.webp',         video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/juan-tesari.mp4',     tag: 'Salud / Servicios' },
  { title: 'Librería Mayorista Leo',   stat: 'Gracias a su tienda: $150K USD anuales',       cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-libreria-leo.webp', video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/libreria-leo.mp4',    tag: 'Mayorista B2B' },
  { title: 'Puertas Blindadas Jack',   stat: 'Gracias a su web: x10 ventas High Ticket',     cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-jack.webp',       video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/puertas-jack.mp4',    tag: 'High Ticket' },
  { title: 'Atérmicos Pinamar',        stat: 'Gracias a su landing: +15 contratos High Ticket/mes', cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-atermicos.webp', video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/atermicos-pinamar.mp4', tag: 'Construcción Premium' },
  { title: 'Case Rossi',               stat: 'Gracias a su tienda: ROAS récord 70x',         cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-case-rossi.webp',  video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/case-rossi.mp4',     tag: 'E-commerce Diseño' }
];

const faqs = [
  {
    q: '¿Trabajan con mi diseñador / mi marca?',
    a: '<strong class="text-zinc-900">Sí.</strong> Si ya tenés brand book, lo respetamos. Si no lo tenés, lo armamos.<br/><br/>Diseño 100% custom. Cero templates de Themeforest. Si querías eso, hay 14.000 freelancers en Fiverr esperándote por USD 80.'
  },
  {
    q: '¿Quién hace el copy?',
    a: '<strong class="text-zinc-900">Nosotros.</strong><br/><br/>Venimos de gestionar más de USD 2M en pauta — sabemos qué frenó scroll, qué hizo clickear y qué hizo cerrar la pestaña. Esa data está bakeada en cada headline.<br/><br/>El copy lo validás vos sección por sección. Cero sorpresas en el live.'
  },
  {
    q: '¿Qué pasa después del lanzamiento?',
    a: '<strong class="text-zinc-900">Primer mes de ajustes ilimitados, incluido.</strong> Si algo no convierte, lo arreglamos.<br/><br/>Después tenés dos opciones: contratar mantenimiento o quedarte con la web sin pagarnos un peso más. El código es tuyo, el repo es tuyo, el dominio es tuyo. No te encadenamos.'
  },
  {
    q: '¿Cuánto cuesta?',
    a: '<strong class="text-zinc-900">Desde USD 250.</strong><br/>Sí, leíste bien.<br/><br/>El número exacto depende del scope (landing simple, tienda con catálogo grande, web corporativa). En la primera llamada salís con propuesta cerrada y número final. No "te lo paso por mail mañana", no "te coordino con el equipo de presupuestos". Número. En la llamada.'
  },
  {
    q: '¿Y si no me convierte mejor que mi web actual?',
    a: '<strong class="text-zinc-900">Te devolvemos el 100% de la plata.</strong><br/><br/>El único que arriesga acá somos nosotros.'
  },
  {
    q: '¿Por qué Algoritmia y no una agencia grande con 14 personas?',
    a: '<strong class="text-zinc-900">Porque venimos de pautear, no de hacer slides.</strong><br/><br/>Cada web la diseñamos pensando cómo se comporta el tráfico pago — dónde rebota, dónde se traba, dónde cliquea. Eso una agencia que solo programa no lo tiene. Y una que solo diseña, menos.<br/><br/>Además: cobramos lo que cobramos porque hacemos 10 al mes en vez de 2 sobrepreciadas. La diferencia se la queda el cliente, no LinkedIn.'
  },
  {
    q: '¿Y si soy de afuera de Argentina?',
    a: '<strong class="text-zinc-900">También.</strong> Trabajamos con clientes en USA, México, España y Chile.<br/><br/>Las llamadas son por Zoom, las firmas digitales, los pagos por transferencia o Stripe. La distancia no es problema. La indecisión sí.'
  }
];
---

<Layout
  title="Diseño y Desarrollo Web · Shopify · Tiendanube · Landings | Algoritmia"
  description="Hacemos webs, tiendas Shopify, tiendas Tiendanube y landing pages diseñadas para convertir tráfico pago en ventas reales. Más de 100 clientes."
  noindex={true}
>

  <!-- NAVBAR -->
  <header class="fixed top-0 left-0 right-0 z-[100] flex justify-center pt-2 md:pt-4 px-4 pointer-events-none">
    <div class="pointer-events-auto bg-white/85 backdrop-blur-xl border border-zinc-200/70 shadow-md shadow-zinc-900/[0.04] rounded-[2rem] px-5 py-2 flex items-center justify-between w-full max-w-5xl mx-auto">
      <div class="flex items-center gap-2 pointer-events-none">
        <Image src={logo} alt="Algoritmia" class="w-8 h-8 md:w-9 md:h-9 object-contain" />
        <div class="flex flex-col leading-none">
          <span class="text-[14px] font-black tracking-tight text-zinc-900 font-display">Algoritmia</span>
          <span class="text-[8.5px] font-bold text-violet-500 tracking-[0.22em] mt-0.5 uppercase">Webs</span>
        </div>
      </div>
      <a href="#contacto" class="group bg-zinc-900 text-white px-4 md:px-5 h-9 md:h-10 inline-flex items-center gap-2 rounded-full text-[12px] md:text-[13px] font-black hover:bg-zinc-800 transition-all shadow-md shadow-zinc-900/20">
        Quiero vender más
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </header>

  <main class="bg-white text-zinc-900">

    <!-- =================== HERO =================== -->
    <section class="relative pt-32 sm:pt-44 pb-20 lg:pb-28 overflow-hidden">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-violet-400/5 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-6 text-center relative z-10">
        <!-- Badge arriba del h1 -->
        <div class="flex justify-center mb-6">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-zinc-200 bg-white shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-500 animate-pulse"></span>
            <span class="text-[10.5px] md:text-[11px] font-bold text-zinc-700 uppercase tracking-[0.2em]">+300 webs que convierten realmente</span>
          </span>
        </div>

        <h1 class="font-display tracking-tight max-w-4xl mx-auto mb-6 animate-in fade-in slide-in-from-bottom-5 duration-700 text-4xl sm:text-5xl md:text-[62px] lg:text-[72px] leading-[1.05] text-zinc-900">
          <span class="font-semibold text-zinc-900">Tu web no vende.</span><br/>
          <span class="font-black underline decoration-violet-500 decoration-[3px] underline-offset-4">La rehacemos en 7 días</span>.
        </h1>

        <p class="text-[16px] sm:text-[19px] max-w-2xl mx-auto leading-snug mb-10 text-zinc-700 font-medium">
          Si no convierte mejor que la actual, <strong class="text-zinc-900">te devolvemos los USD 250</strong>.
        </p>

        <div class="flex flex-col items-center gap-3 mb-16">
          <div class="flex items-center justify-center">
            <a href="#contacto" class="group w-full sm:w-auto h-12 px-8 font-black rounded-xl text-[13px] flex items-center justify-center gap-2 shadow-md shadow-zinc-900/20 bg-zinc-900 text-white hover:bg-zinc-800 transition-all">
              Quiero vender más
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>

        <!-- Showcase Hero (CAR-SaaS exact pattern) -->
        <div id="hero-showcase" class="relative max-w-5xl lg:max-w-6xl mx-auto mt-10 lg:mt-14 -mx-6 sm:mx-auto animate-in fade-in zoom-in-95 duration-1000">
          <div class="w-full rounded-none sm:rounded-[22px] border p-0 sm:p-1 bg-zinc-950/20 border-zinc-200/35 shadow-xl">
            <div class="rounded-none sm:rounded-[18px] border bg-white border-zinc-200/45 overflow-hidden">

              <!-- Tabs -->
              <div class="flex flex-wrap border-b p-1.5 gap-1 border-zinc-200/50 bg-zinc-50/40">
                {showcaseTabs.map((tab, i) => (
                  <button
                    data-tab-id={tab.id}
                    class={`showcase-tab h-6 md:h-[25px] px-2.5 rounded-md text-[10px] md:text-[11px] font-bold transition-all flex items-center justify-center relative ${i === 0 ? 'is-active bg-zinc-900 text-white shadow-sm' : 'text-zinc-500 hover:text-zinc-700 hover:bg-zinc-100/80'}`}
                  >
                    {tab.label}
                    <span class="tab-dot absolute -top-0.5 -right-0.5 w-1.5 h-1.5 rounded-full bg-violet-500 animate-pulse opacity-0"></span>
                  </button>
                ))}
              </div>

              <!-- Progress bar -->
              <div class="h-[6px] overflow-hidden bg-zinc-200 relative">
                <div id="hero-progress-bar" class="h-full bg-gradient-to-r from-violet-500 via-violet-500 to-violet-400 shadow-[0_0_12px_rgba(139,92,246,0.6)]"></div>
              </div>

              <!-- Image area -->
              <div class="relative overflow-hidden bg-zinc-50" style="aspect-ratio: 1600/900;">
                {showcaseTabs.map((tab, i) => (
                  <div
                    data-pane={tab.id}
                    data-desc={tab.desc}
                    data-label={tab.label}
                    class={`showcase-pane absolute inset-0 transition-opacity duration-500 ease-out ${i === 0 ? 'opacity-100 z-20' : 'opacity-0 z-10'}`}
                  >
                    <img
                      src={tab.img}
                      alt={`Antes y después — ${tab.label}`}
                      loading="eager"
                      decoding="async"
                      class="w-full h-full object-cover object-top"
                      onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                    />
                    <!-- Placeholder simple (web próximamente) -->
                    <div class="hidden absolute inset-0 flex flex-col items-center justify-center gap-3 bg-gradient-to-br from-zinc-50 to-zinc-100 text-zinc-400">
                      <svg class="w-14 h-14 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                      <p class="text-[11px] font-black uppercase tracking-widest text-zinc-500">Vista previa próximamente</p>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Tab description -->
              <div class="h-[118px] sm:h-[98px] md:h-[86px] px-4 sm:px-5 py-2.5 border-t border-zinc-100 bg-zinc-50/60 flex items-start gap-3 text-left">
                <div class="w-1.5 h-1.5 rounded-full mt-1.5 shrink-0 bg-violet-500"></div>
                <div class="min-w-0 flex-1 md:max-w-2xl lg:max-w-3xl">
                  <p id="hero-tab-label" class="text-[11px] font-black uppercase tracking-wider mb-1 text-zinc-700">{showcaseTabs[0].label}</p>
                  <p id="hero-tab-desc" class="text-[11.5px] sm:text-[12px] leading-relaxed font-medium text-zinc-500 [&_strong]:font-black [&_strong]:text-zinc-800" set:html={showcaseTabs[0].desc}></p>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =================== LOGO MARQUEE =================== -->
    <section class="py-8 lg:py-10 border-t border-b bg-zinc-50/30 border-zinc-200/40">
      <p class="text-center text-[9px] font-bold text-zinc-400 uppercase tracking-[0.2em] font-sans mb-4 px-6">
        Stack técnico · Partners certificados · Diseño profesional
      </p>
      <div class="relative w-full flex overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
        <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>
        <div class="logo-marquee-track py-2 gap-4 sm:gap-8 md:gap-12">
          {[...platforms, ...platforms].map((p, idx) => (
            <div class="flex items-center gap-2.5 sm:gap-3.5 opacity-80 hover:opacity-100 transition-all duration-300 cursor-pointer h-10 sm:h-12 px-3.5 sm:px-5 rounded-xl sm:rounded-2xl bg-zinc-200/10 border border-transparent hover:border-violet-500/15">
              <img src={p.logo} alt={p.name} class="h-5 sm:h-7 object-contain max-w-[84px] sm:max-w-[120px]" />
              <span class="text-[11px] sm:text-[12px] font-bold tracking-tight whitespace-nowrap text-zinc-700">{p.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =================== FILOSOFÍA =================== -->
    <section class="py-24 lg:py-28 px-6 md:px-12 bg-zinc-950 text-white relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-violet-500/10 blur-[160px] rounded-full pointer-events-none"></div>
      <div class="max-w-4xl mx-auto text-center space-y-7 relative z-10">
        <p class="text-[10.5px] uppercase tracking-[0.22em] text-violet-400 font-bold">Filosofía</p>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-black leading-[1.1] tracking-tight">
          No diseñamos para premios.<br/>
          <span class="text-zinc-400">Diseñamos para que tu negocio facture.</span>
        </h2>
        <p class="text-white/70 text-base md:text-[17px] max-w-2xl mx-auto leading-relaxed">
          Venimos de gestionar pauta. Sabemos exactamente dónde el usuario rebota, dónde se traba, dónde clickea. Esa data está bakeada en cada sección que construimos.
        </p>
      </div>
    </section>

    <!-- =================== CASO REAL: PDP =================== -->
    <section id="caso-pdp" class="py-24 lg:py-28 px-6 md:px-12 bg-white relative overflow-hidden">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-violet-500/5 blur-[140px] rounded-full pointer-events-none"></div>
      <div class="max-w-6xl mx-auto relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-violet-200 bg-violet-50 mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-500 animate-pulse"></span>
            <span class="text-[10.5px] font-black text-violet-700 uppercase tracking-[0.18em]">Caso real · Sin tocar la pauta</span>
          </div>
          <h2 class="font-display text-3xl sm:text-4xl md:text-[52px] font-black tracking-tight text-zinc-900 leading-[1.05] mb-5">
            Subimos la conversión <span class="text-violet-600">2.7×</span>.
          </h2>
          <p class="text-zinc-600 text-[16px] md:text-[19px] leading-relaxed max-w-2xl mx-auto font-medium">
            Mismo producto. Mismo tráfico. Mismo todo.<br/>
            <strong class="text-zinc-900">Solo arreglamos la web.</strong>
          </p>
          <p class="text-zinc-900 text-[18px] md:text-[22px] leading-snug max-w-2xl mx-auto mt-6 font-display font-black">
            Imaginate eso pasando con <span class="underline decoration-violet-500 decoration-[3px] underline-offset-[6px]">la tuya</span>.
          </p>
        </div>

        <div class="rounded-[22px] border border-zinc-200/60 bg-white p-1.5 shadow-2xl shadow-zinc-900/10">
          <div
            id="pdp-compare"
            class="relative rounded-[18px] overflow-hidden border border-zinc-100 select-none cursor-ew-resize touch-none aspect-[4/3] sm:aspect-[16/10] md:aspect-[1600/900]"
          >
            <!-- ANTES: imagen base full -->
            <img
              src="/images/webs/pdp-antes.webp"
              alt="Antes — ficha básica, 0,7% conversión"
              class="absolute inset-0 w-full h-full object-cover object-top pointer-events-none"
              draggable="false"
            />
