  <script>
    function initShowcase() {
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.showcase-tab'));
      const panes = Array.from(document.querySelectorAll<HTMLDivElement>('.showcase-pane'));
      const labelEl = document.getElementById('hero-tab-label');
      const descEl = document.getElementById('hero-tab-desc');
      const progress = document.getElementById('hero-progress-bar');
      if (!tabs.length || !panes.length) return;

      let activeIdx = 0;
      let autoCycle = true;
      let timer: number | undefined;

      const meta = panes.map(p => ({
        id: p.getAttribute('data-pane') || '',
        label: p.getAttribute('data-label') || '',
        desc: p.getAttribute('data-desc') || ''
      }));

      const activate = (idx: number) => {
        activeIdx = idx;
        tabs.forEach((t, i) => {
          const active = i === idx;
          t.classList.toggle('is-active', active);
          t.classList.toggle('bg-zinc-900', active);
          t.classList.toggle('text-white', active);
          t.classList.toggle('shadow-sm', active);
          t.classList.toggle('text-zinc-500', !active);
        });
        panes.forEach((p, i) => {
          p.style.opacity = i === idx ? '1' : '0';
          p.style.zIndex = i === idx ? '20' : '10';
        });
        if (labelEl) labelEl.textContent = meta[idx].label;
        if (descEl) descEl.innerHTML = meta[idx].desc;

        if (progress) {
          progress.classList.remove('running');
          // Force reflow so removing+adding the class restarts the animation
          void progress.offsetWidth;
          if (autoCycle) progress.classList.add('running');
        }
      };

      const cycle = () => activate((activeIdx + 1) % tabs.length);

      const startTimer = () => {
        if (timer) window.clearInterval(timer);
        if (autoCycle) timer = window.setInterval(cycle, 4000);
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
          autoCycle = false;
          if (timer) window.clearInterval(timer);
          if (progress) progress.classList.remove('running');
          activate(i);
        });
      });

      activate(0);
      startTimer();
    }

    function initTestimonialPlayers() {
      document.querySelectorAll('.testimonial-card').forEach(card => {
        const video = card.querySelector('.hero-testimonial-video') as HTMLVideoElement | null;
        const overlay = card.querySelector('.video-overlay') as HTMLElement | null;
        const coverImg = card.querySelector('.video-cover-img') as HTMLImageElement | null;
        if (!video || !overlay || video.dataset.playerSetup) return;
        video.dataset.playerSetup = 'true';

        const play = () => {
          if (video.paused) {
            document.querySelectorAll<HTMLVideoElement>('.hero-testimonial-video').forEach(v => { if (v !== video && !v.paused) v.pause(); });
            coverImg?.classList.add('hidden');
            video.classList.remove('hidden');
            video.play();
            overlay.classList.add('hidden');
            video.setAttribute('controls', 'true');
          } else { video.pause(); }
        };
        overlay.addEventListener('click', play);
        video.addEventListener('pause', () => overlay.classList.remove('hidden'));
        video.addEventListener('ended', () => {
          video.classList.add('hidden');
          video.removeAttribute('controls');
          coverImg?.classList.remove('hidden');
          overlay.classList.remove('hidden');
        });
      });
    }

    function initForm() {
      const form = document.getElementById('landingContactForm') as HTMLFormElement | null;
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
      const btnText = document.getElementById('btn-text');
      const success = document.getElementById('success-message');
      const error = document.getElementById('error-message');
      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        success?.classList.add('hidden');
        error?.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Enviando...';

        const data = Object.fromEntries(new FormData(form).entries());
        try {
          const res = await fetch('/api/landing-lead', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data) });
          if (!res.ok) throw new Error('server');
          form.classList.add('hidden');
          success?.classList.remove('hidden');
          form.reset();
        } catch {
          error?.classList.remove('hidden');
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Quiero mi propuesta';
        }
      });
    }

    function initPdpCompare() {
      const container = document.getElementById('pdp-compare');
      const after = document.getElementById('pdp-compare-after');
      const divider = document.getElementById('pdp-compare-divider');
      const hint = document.getElementById('pdp-compare-hint');
      if (!container || !after || !divider) return;

      let dragging = false;

      const setPos = (clientX: number) => {
        const rect = container.getBoundingClientRect();
        let pct = ((clientX - rect.left) / rect.width) * 100;
        pct = Math.max(2, Math.min(98, pct));
        after.style.clipPath = `inset(0 0 0 ${pct}%)`;
        divider.style.left = `${pct}%`;
        if (hint && hint.style.opacity !== '0') {
          hint.style.opacity = '0';
        }
      };

      const onDown = (e: PointerEvent) => {
        dragging = true;
        container.setPointerCapture?.(e.pointerId);
        setPos(e.clientX);
      };
      const onMove = (e: PointerEvent) => {
        if (!dragging) return;
        setPos(e.clientX);
      };
      const onUp = (e: PointerEvent) => {
        dragging = false;
        try { container.releasePointerCapture?.(e.pointerId); } catch {}
      };

      container.addEventListener('pointerdown', onDown);
      container.addEventListener('pointermove', onMove);
      container.addEventListener('pointerup', onUp);
      container.addEventListener('pointercancel', onUp);
      container.addEventListener('pointerleave', onUp);

      // Animación de bienvenida: pasa de 50% → 35% → 65% → 50% para invitar a jugar
      const sequence = async () => {
        const steps = [50, 30, 70, 50];
        for (const s of steps) {
          const rect = container.getBoundingClientRect();
          setPos(rect.left + rect.width * (s/100));
          await new Promise(r => setTimeout(r, 600));
        }
      };
      setTimeout(sequence, 800);
    }

    function initLeadTracking() {
      // Listener delegado para capturar clicks en cualquier link de WhatsApp
      // y disparar el evento Lead de Meta Pixel
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const link = target.closest('a[href*="wa.me"]') as HTMLAnchorElement | null;
        if (!link) return;
        const fbq = (window as any).fbq;
        if (typeof fbq === 'function') {
          fbq('track', 'Lead', {
            content_name: 'WhatsApp CTA — Landing webs',
            content_category: 'web-services'
          });
          fbq('trackCustom', 'WhatsAppClick', { source: 'landings-page' });
        }
      });
    }

    function bootLanding() {
      initShowcase();
      initTestimonialPlayers();
      initForm();
      initPdpCompare();
      initLeadTracking();
    }
    document.addEventListener('astro:page-load', bootLanding);
  </script>
</Layout>
