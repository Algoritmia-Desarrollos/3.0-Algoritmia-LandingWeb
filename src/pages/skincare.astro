---

<Layout
  title="Más ventas para marcas de cosmética — Algoritmia"
  description="Publicidad, email marketing y atención con IA para aumentar las ventas de tu marca de cosmética."
  noindex={true}
  disableZoom={true}
>
  <noscript>
    <img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=989984603929968&ev=PageView&noscript=1" alt="" />
  </noscript>
  <Fragment slot="head">
    <link rel="preconnect" href="https://czocbnyoenjbpxmcqobn.supabase.co" crossorigin />
    <link rel="dns-prefetch" href="https://czocbnyoenjbpxmcqobn.supabase.co" />
    <link rel="preconnect" href="https://link.1prompt.com" crossorigin />
    <link rel="dns-prefetch" href="https://link.1prompt.com" />
    <link
      rel="preload"
      as="image"
      href="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/skincare/vsl-poster-1280-v2.jpg"
      fetchpriority="high"
    />
  </Fragment>
  <main>
    <section class="hero-section" aria-labelledby="page-title">
      <div id="inicio" class="hero-copy">
        <p class="eyebrow"><span></span> Publicidad + Email marketing + Atención con IA</p>
        <h1 id="page-title"><span class="subtle-underline">Más ventas</span> para tu marca de <span class="subtle-underline">cosmética</span>.</h1>
        <p class="hero-subtitle">Mirá el video: te mostramos cómo hacemos crecer tu negocio con el Sistema C.A.R. 👇</p>
      </div>

      <div class="vsl-wrap">
        <div class="vsl-frame">
          <video
            id="vsl-video"
            class="vsl-video"
            autoplay
            muted
            loop
            playsinline
            preload="none"
            data-full-src="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/skincare/vsl-final-1080p.mp4"
            poster="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/skincare/vsl-poster-1280-v2.jpg"
            aria-label="Presentación del sistema de crecimiento para marcas de cosmética"
          >
            <source data-src="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/skincare/vsl-teaser-5s-720p.mp4" type="video/mp4" />
            Tu navegador no soporta la reproducción de video.
          </video>
          <button id="vsl-unmute" class="vsl-unmute" type="button" aria-label="Ver video completo con sonido">
            <span class="vsl-unmute-pill">
              <span class="vsl-unmute-icon material-symbols-outlined">volume_up</span>
              <strong>Activar sonido</strong>
            </span>
          </button>
        </div>
        <a class="video-cta" href="#formulario">Quiero aumentar mis ventas <span aria-hidden="true">↓</span></a>
        <div class="cta-rating-wrap">
          <div class="rating-stars">
            <div class="avatars-group">
              <img class="rating-avatar-img" src="https://tryholo.ai/rootPage/assets/SocialProof/footer-1.webp" alt="User 1" decoding="async" loading="lazy" />
              <img class="rating-avatar-img" src="https://tryholo.ai/rootPage/assets/SocialProof/footer-2.webp" alt="User 2" decoding="async" loading="lazy" />
              <img class="rating-avatar-img" src="https://tryholo.ai/rootPage/assets/SocialProof/footer-3.webp" alt="User 3" decoding="async" loading="lazy" />
              <img class="rating-avatar-img" src="https://tryholo.ai/rootPage/assets/SocialProof/footer-4.webp" alt="User 4" decoding="async" loading="lazy" />
            </div>
            <span class="rating-text"><strong>4.9</strong>/5 de más de <strong>92</strong> negocios</span>
            <svg class="rating-star-icon" viewBox="0 0 24 24" width="18" height="18" fill="url(#starGrad)">
              <defs>
                <linearGradient id="starGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#f59e0b"></stop>
                  <stop offset="100%" stop-color="#fbbf24"></stop>
                </linearGradient>
              </defs>
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section class="form-section" id="formulario" aria-labelledby="form-title">
      <div class="form-heading">
        <p class="eyebrow"><span></span> Cupos limitados por mes</p>
        <h2 id="form-title">¿Tu marca califica?</h2>
        <p>Completá el formulario. Si calificás, te contactamos en menos de 24 horas.</p>
      </div>

      <div class="form-embed-card" aria-busy="true">
        <iframe
          data-src="https://link.1prompt.com/widget/survey/QRU7dBIDhhv78Ir66Mv9"
          class="survey-embed"
          style="border:none;width:100%;"
          scrolling="no"
          id="QRU7dBIDhhv78Ir66Mv9"
          title="Formulario de aplicación"
        ></iframe>
      </div>
      <script is:inline>
        (() => {
          const iframe = document.getElementById('QRU7dBIDhhv78Ir66Mv9');
          if (!(iframe instanceof HTMLIFrameElement)) return;

          const formUrl = iframe.dataset.src;
          if (!formUrl) return;
          const formOrigin = new URL(formUrl).origin;
          const qualifiedRedirectUrl = 'https://sistema.car.fluyent.cc/thank-you';
          const formCard = iframe.closest('.form-embed-card');
          const formSection = document.getElementById('formulario');
          let formLoaded = false;
          let formLoadTracked = false;

          const track = (eventName, parameters = {}, standard = false) => {
            if (typeof window.skincareTrack === 'function') {
              window.skincareTrack(eventName, parameters, standard);
            }
          };

          const loadForm = () => {
            if (formLoaded) return;
            formLoaded = true;
            track('FormLoadRequested');
            iframe.src = formUrl;

            const embedScript = document.createElement('script');
            embedScript.src = 'https://link.1prompt.com/js/form_embed.js';
            embedScript.async = true;
            document.head.appendChild(embedScript);
          };

          iframe.addEventListener('load', () => {
            formCard?.classList.add('is-loaded');
            formCard?.setAttribute('aria-busy', 'false');
            if (!formLoaded || formLoadTracked || !iframe.src.startsWith(formOrigin)) return;
            formLoadTracked = true;
            track('FormLoaded');
          });

          if ('IntersectionObserver' in window && formSection) {
            const observer = new IntersectionObserver((entries) => {
              if (!entries.some(entry => entry.isIntersecting)) return;
              observer.disconnect();
              loadForm();
            }, { rootMargin: '240px 0px' });
            observer.observe(formSection);
          }

          document.querySelector('.video-cta')?.addEventListener('pointerdown', loadForm, { once: true });
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadForm, { timeout: 1400 });
          } else {
            window.setTimeout(loadForm, 700);
          }

          window.addEventListener('message', (event) => {
            if (event.origin !== formOrigin || event.source !== iframe.contentWindow) return;
            formCard?.classList.add('is-loaded');
            formCard?.setAttribute('aria-busy', 'false');
            if (!Array.isArray(event.data) || event.data[0] !== 'set-sticky-contacts') return;

            track('Lead', { content_name: 'Aplicación Sistema C.A.R', content_category: 'Skincare' }, true);
            track('ApplicationQualified', { destination: qualifiedRedirectUrl });
            window.location.assign(qualifiedRedirectUrl);
          });
        })();
      </script>
    </section>

    <section class="testimonials-section" aria-labelledby="testimonials-title">
      <div class="testimonials-heading">
        <p class="eyebrow"><span></span> Resultados reales</p>
        <h2 id="testimonials-title">Historias de crecimiento</h2>
      </div>
      <div class="carousel-controls" aria-label="Controles del carrusel">
        <button id="testimonials-prev" type="button" aria-label="Testimonio anterior"><span class="material-symbols-outlined">arrow_back</span></button>
        <button id="testimonials-next" type="button" aria-label="Testimonio siguiente"><span class="material-symbols-outlined">arrow_forward</span></button>
      </div>
      <div class="marquee" aria-label="Testimonios de clientes">
        <div class="marquee-track">
          {testimonials.map((testimonial, index) => (
            <article class="testimonial-card" data-testimonial-index={index + 1} data-result={testimonial.highlight}>
              <div class="testimonial-video">
                <img class="video-cover" src={testimonial.cover} alt="" loading="lazy" decoding="async" fetchpriority="low" />
                <video class="testimonial-player hidden" preload="none" playsinline data-src={testimonial.video}></video>
                <button class="video-overlay" type="button" aria-label="Reproducir testimonio">
                  <span class="material-symbols-outlined">play_arrow</span>
                </button>
              </div>
              <p class="testimonial-result">
                <span>{testimonial.before}</span>{' '}<strong>{testimonial.highlight}</strong>{testimonial.after && <>{' '}<span>{testimonial.after}</span></>}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; touch-action: pan-x pan-y; }
  :global(body) { margin: 0; background: #fffaf8; touch-action: pan-x pan-y; }
  main { min-height: 100vh; overflow: hidden; color: #191518; background: #fffaf8; }
  .hero-section { min-height: 100vh; box-sizing: border-box; padding: 28px 24px 88px; position: relative; background: radial-gradient(circle at 50% 8%, rgba(255,204,214,.45), transparent 34%), linear-gradient(180deg, #fffaf8 0%, #fff 100%); }
  .hero-copy { max-width: 920px; margin: 48px auto 52px; text-align: center; }
  .hero-copy h1 { max-width: 860px; margin: 0 auto; font-size: clamp(42px, 5.8vw, 76px); line-height: 1.01; letter-spacing: -.055em; font-weight: 750; text-wrap: balance; }
  .subtle-underline { padding-bottom: .01em; background-image: linear-gradient(transparent 86%, rgba(244,63,94,.66) 86%, rgba(244,63,94,.66) 89%, transparent 89%); background-repeat: no-repeat; }
  .hero-subtitle { max-width: 640px; margin: 22px auto 0; color: #746c70; font-size: clamp(16px, 1.8vw, 19px); line-height: 1.5; text-wrap: balance; }
  .vsl-wrap { max-width: 960px; margin: 0 auto; text-align: center; }
  .vsl-frame { position: relative; padding: 7px; border: 1px solid rgba(24,19,22,.1); border-radius: 27px; background: rgba(255,255,255,.72); box-shadow: 0 30px 90px rgba(65,26,40,.13); }
  .vsl-video { width: 100%; aspect-ratio: 16 / 9; border-radius: 21px; display: block; object-fit: contain; background: #090708; }
  .vsl-unmute { position: absolute; inset: 7px; z-index: 2; padding: 0; border: 0; border-radius: 21px; color: white; background: transparent; cursor: pointer; font: inherit; }
  .vsl-unmute-pill { position: absolute; left: 50%; bottom: 15px; min-height: 44px; padding: 6px 16px 6px 7px; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; display: inline-flex; align-items: center; gap: 9px; background: rgba(16,12,14,.82); backdrop-filter: blur(12px); box-shadow: 0 10px 28px rgba(0,0,0,.28); transform: translateX(-50%); white-space: nowrap; transition: transform .2s ease, background .2s ease; }
  .vsl-unmute:hover .vsl-unmute-pill { background: rgba(16,12,14,.94); transform: translate(-50%, -2px); }
  .vsl-unmute-icon { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; color: #171315; background: white; font-size: 18px; }
  .vsl-unmute strong { font-size: 12px; letter-spacing: .01em; }
  .video-cta { position: relative; min-height: 54px; margin: 38px auto 0; padding: 0 28px; width: fit-content; display: inline-flex; align-items: center; gap: 13px; border-radius: 999px; color: white; background: #f43f5e; text-decoration: none; font-size: 14px; font-weight: 800; box-shadow: 0 12px 32px rgba(244,63,94,.28); isolation: isolate; animation: cta-breathe 3.2s ease-in-out infinite; }
  .video-cta::before { content: ''; position: absolute; inset: 0; border-radius: 999px; background: rgba(244, 63, 94, 0.35); z-index: -1; pointer-events: none; animation: cta-glow-pulse 3.2s ease-in-out infinite; }
  @keyframes cta-breathe {
    0%, 100% { transform: scale(1); box-shadow: 0 12px 32px rgba(244,63,94,.25); }
    50% { transform: scale(1.02); box-shadow: 0 14px 38px rgba(244,63,94,.35); }
  }
  @keyframes cta-glow-pulse {
    0%, 100% { transform: scale(1); opacity: 0.15; filter: blur(4px); }
    50% { transform: scale(1.03, 1.1); opacity: 0.45; filter: blur(7px); }
  }
  .cta-rating-wrap { margin-top: 44px; display: flex; justify-content: center; }
  .rating-stars { display: inline-flex; align-items: center; gap: 8px; padding: 5px 13px; background: #ffffff; border-radius: 99px; border: 1px solid rgba(24,19,22,.1); box-shadow: 0 4px 16px rgba(0,0,0,.04); }
  .avatars-group { display: flex; }
  .rating-avatar-img { width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid #ffffff; margin-right: -6px; object-fit: cover; }
  .rating-avatar-img:last-child { margin-right: 0; }
  .rating-text { font-size: 12px; font-weight: 500; color: #1d1d1f; }
  .rating-text strong { font-weight: 700; }
  .rating-star-icon { width: 15px; height: 15px; }
  .form-section { min-height: 100vh; box-sizing: border-box; padding: 100px 22px 110px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 0%, rgba(255,198,212,.32), transparent 35%); }
  .form-heading { max-width: 630px; margin-bottom: 34px; text-align: center; }
  .eyebrow { margin: 0 0 16px; display: flex; align-items: center; justify-content: center; gap: 9px; color: #e62d58; font-size: 11px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 5px rgba(230,45,88,.1); }
  .form-heading h2 { margin: 0; font-size: clamp(42px, 6vw, 66px); line-height: .98; letter-spacing: -.06em; font-weight: 760; }
  .form-heading > p:last-child { margin: 20px auto 0; max-width: 510px; color: #766d72; font-size: 16px; line-height: 1.55; }
  .form-embed-card { position: relative; width: 100%; max-width: 720px; box-sizing: border-box; padding: 12px; overflow: hidden; border: 1px solid rgba(35,23,29,.08); border-radius: 28px; background: white; box-shadow: 0 28px 80px rgba(74,31,48,.13); }
  .form-embed-card::before { position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; color: #9b8e94; background: linear-gradient(110deg, #fff 30%, #fff5f7 50%, #fff 70%); background-size: 220% 100%; content: 'Preparando el formulario…'; font-size: 13px; font-weight: 700; animation: form-loading 1.2s linear infinite; transition: opacity .2s ease; pointer-events: none; }
  .form-embed-card.is-loaded::before { opacity: 0; pointer-events: none; animation: none; }
  .survey-embed { width: 100%; height: 510px; display: block; opacity: 0; transition: opacity .22s ease; overflow: hidden !important; }
  .form-embed-card.is-loaded .survey-embed { opacity: 1; }
  @keyframes form-loading { to { background-position: -220% 0; } }
  .hidden { display: none !important; }

  .testimonials-section { padding: 100px 0 86px; color: white; background: #171315; }
  .testimonials-heading { margin: 0 auto 44px; padding: 0 22px; text-align: center; }
  .testimonials-heading .eyebrow { color: #ff6d8c; }
  .testimonials-heading h2 { margin: 0; font-size: clamp(36px, 5vw, 58px); line-height: 1; letter-spacing: -.055em; font-weight: 750; }
  .carousel-controls { margin: -23px auto 18px; padding: 0 24px; display: flex; justify-content: flex-end; gap: 9px; max-width: 1240px; box-sizing: border-box; }
  .carousel-controls button { width: 42px; height: 42px; padding: 0; border: 1px solid rgba(255,255,255,.16); border-radius: 50%; display: grid; place-items: center; color: white; background: rgba(255,255,255,.07); cursor: pointer; transition: background .2s ease, transform .2s ease; }
  .carousel-controls button:hover { background: rgba(255,255,255,.15); transform: translateY(-1px); }
  .carousel-controls span { font-size: 19px; }
  .marquee { width: 100%; padding: 8px 0 30px; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; scroll-snap-type: x mandatory; overscroll-behavior-inline: contain; -webkit-overflow-scrolling: touch; mask-image: linear-gradient(90deg, transparent, black 7%, black 93%, transparent); }
  .marquee::-webkit-scrollbar { display: none; }
  .marquee-track { width: max-content; display: flex; }
  .testimonial-card { width: min(410px, 80vw); margin: 0 9px; flex: 0 0 auto; overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 22px; background: #241d21; scroll-snap-align: center; }
  .testimonial-video { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #090708; }
  .video-cover { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #000; z-index: 1; }
  .testimonial-player { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #000; z-index: 2; }
  .video-overlay { position: absolute; inset: 0; z-index: 3; padding: 0; border: 0; display: grid; place-items: center; color: #191518; background: rgba(0,0,0,.18); cursor: pointer; transition: background .2s ease; }
  .video-overlay:hover { background: rgba(0,0,0,.08); }
  .video-overlay span { width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: white; box-shadow: 0 10px 32px rgba(0,0,0,.28); font-size: 32px; transition: transform .2s ease; }
  .video-overlay:hover span { transform: scale(1.08); }
  .testimonial-result { min-height: 94px; box-sizing: border-box; margin: 0; padding: 20px 22px; color: rgba(255,255,255,.8); font-size: 15px; font-weight: 650; line-height: 1.45; }
  .testimonial-result strong { display: inline; margin-inline: .2em; color: #ff7894; font-size: 1.18em; font-weight: 900; letter-spacing: -.02em; text-shadow: 0 0 24px rgba(255,120,148,.25); }
  @media (max-width: 640px) {
    .hero-section { min-height: auto; padding: 22px 18px 70px; }
    .hero-copy { margin: 30px auto 38px; }
    .hero-copy > .eyebrow { margin-bottom: 14px; gap: 6px; font-size: 9px; letter-spacing: .07em; white-space: nowrap; }
    .hero-copy > .eyebrow span { width: 5px; height: 5px; box-shadow: 0 0 0 3px rgba(230,45,88,.1); }
    .hero-copy h1 { max-width: 370px; font-size: clamp(33px, 9.4vw, 44px); line-height: 1.04; letter-spacing: -.05em; text-wrap: balance; }
    .hero-subtitle { max-width: 340px; margin-top: 17px; font-size: 14px; line-height: 1.45; }
    .vsl-frame { padding: 5px; border-radius: 20px; }
    .vsl-video { border-radius: 15px; }
    .vsl-unmute { inset: 5px; border-radius: 15px; }
    .vsl-unmute-pill { bottom: 8px; min-height: 39px; padding: 5px 13px 5px 6px; gap: 7px; }
    .vsl-unmute-icon { width: 29px; height: 29px; font-size: 17px; }
    .vsl-unmute strong { font-size: 11px; }
    .form-section { min-height: 100svh; padding: 52px 16px 70px; justify-content: flex-start; }
    .form-heading { margin-bottom: 27px; }
    .form-heading h2 { font-size: clamp(36px, 10.5vw, 44px); line-height: 1.02; }
    .form-heading > p:last-child { font-size: 14px; }
    .form-embed-card { padding: 6px; border-radius: 22px; }
    .survey-embed { height: 600px; }
    .testimonials-section { padding: 76px 0 64px; }
    .testimonials-heading h2 { font-size: clamp(34px, 9.5vw, 42px); line-height: 1.03; }
    .carousel-controls { margin: -20px auto 14px; padding: 0 18px; }
    .marquee { mask-image: linear-gradient(90deg, transparent, black 3%, black 97%, transparent); }
  }
</style>

<script>
  const META_PIXEL_ID = '989984603929968';
  type PixelParameters = Record<string, string | number | boolean>;
  type SkincarePixelWindow = Window & {
    fbq?: (...args: unknown[]) => void;
    skincareTrack?: (eventName: string, parameters?: PixelParameters, standard?: boolean) => void;
    __skincarePixelInitialized?: boolean;
    __skincareTrackingAbort?: AbortController;
  };
  const pixelWindow = window as SkincarePixelWindow;
  const trackSkincare = (eventName: string, parameters: PixelParameters = {}, standard = false) => {
    if (typeof pixelWindow.fbq !== 'function') return;
    pixelWindow.fbq(
      standard ? 'trackSingle' : 'trackSingleCustom',
      META_PIXEL_ID,
      eventName,
      parameters,
    );
  };
  pixelWindow.skincareTrack = trackSkincare;

  document.addEventListener('astro:page-load', () => {
    const vsl = document.getElementById('vsl-video') as HTMLVideoElement | null;
    const vslUnmute = document.getElementById('vsl-unmute') as HTMLButtonElement | null;
    if (!vsl) return;

    if (typeof pixelWindow.fbq === 'function') {
      if (!pixelWindow.__skincarePixelInitialized) {
        pixelWindow.fbq('init', META_PIXEL_ID);
        pixelWindow.__skincarePixelInitialized = true;
      }
      trackSkincare('PageView', {}, true);
      trackSkincare('ViewContent', {
        content_name: 'Landing Sistema C.A.R para cosmética',
        content_category: 'Skincare',
      }, true);
    }

    pixelWindow.__skincareTrackingAbort?.abort();
    const trackingAbort = new AbortController();
    pixelWindow.__skincareTrackingAbort = trackingAbort;
    const trackingOptions = { signal: trackingAbort.signal };

    if (vsl && vslUnmute && vsl.dataset.initialized !== 'true') {
      vsl.dataset.initialized = 'true';
      let teaserMode = true;
      let fullPlaybackStarted = false;
      const reachedVslMilestones = new Set<string>();
      const teaserSource = vsl.querySelector<HTMLSourceElement>('source[data-src]');

      const playMutedTeaser = () => {
        if (!teaserMode) return;
        vsl.muted = true;
        vsl.loop = true;
        vsl.controls = false;
        vsl.play().catch(() => {});
      };

      vsl.addEventListener('loadedmetadata', playMutedTeaser);

      const loadTeaserAfterFirstPaint = () => {
        if (!teaserMode || !teaserSource?.dataset.src || teaserSource.src) return;
        teaserSource.src = teaserSource.dataset.src;
        vsl.load();
      };

      requestAnimationFrame(() => requestAnimationFrame(loadTeaserAfterFirstPaint));

      vslUnmute.addEventListener('click', async () => {
        teaserMode = false;
        vsl.pause();
        vsl.loop = false;
        vsl.muted = true;
        vsl.controls = true;
        vsl.preload = 'auto';
        vslUnmute.classList.add('hidden');
        const fullSrc = vsl.dataset.fullSrc;
        if (fullSrc && vsl.currentSrc !== fullSrc) {
          vsl.src = fullSrc;
          vsl.load();
        }
        try {
          await vsl.play();
          vsl.muted = false;
          if (!fullPlaybackStarted) {
            fullPlaybackStarted = true;
            trackSkincare('VSLStarted', { sound: true });
          }
        } catch {
          vslUnmute.classList.remove('hidden');
          vsl.controls = true;
        }
      });

      vsl.addEventListener('timeupdate', () => {
        if (!fullPlaybackStarted) return;

        const secondMilestones = [
          { seconds: 5, event: 'VSL5Seconds' },
          { seconds: 10, event: 'VSL10Seconds' },
        ];
        secondMilestones.forEach(({ seconds, event }) => {
          if (vsl.currentTime < seconds || reachedVslMilestones.has(event)) return;
          reachedVslMilestones.add(event);
          trackSkincare(event, { seconds });
        });

        if (!Number.isFinite(vsl.duration) || vsl.duration <= 0) return;
        const percent = (vsl.currentTime / vsl.duration) * 100;
        [25, 50, 75, 90].forEach(milestone => {
          const event = `VSL${milestone}Percent`;
          if (percent < milestone || reachedVslMilestones.has(event)) return;
          reachedVslMilestones.add(event);
          trackSkincare(event, { percent: milestone });
        });
      });

      vsl.addEventListener('ended', () => {
        if (!fullPlaybackStarted || reachedVslMilestones.has('VSLCompleted')) return;
        reachedVslMilestones.add('VSLCompleted');
        trackSkincare('VSLCompleted', { percent: 100 });
      });

      playMutedTeaser();
    }

    document.querySelector<HTMLAnchorElement>('.video-cta')?.addEventListener('click', () => {
      trackSkincare('PrimaryCTAClick', { destination: 'formulario' });
    }, trackingOptions);

    const formSection = document.getElementById('formulario');
    if (formSection && 'IntersectionObserver' in window) {
      const formObserver = new IntersectionObserver((entries) => {
        if (!entries.some(entry => entry.isIntersecting && entry.intersectionRatio >= .35)) return;
        trackSkincare('FormViewed', { visible_percent: 35 });
        formObserver.disconnect();
      }, { threshold: [.35] });
      formObserver.observe(formSection);
      trackingAbort.signal.addEventListener('abort', () => formObserver.disconnect(), { once: true });
    }

    const reachedScrollDepth = new Set<number>();
    let scrollFramePending = false;
    const measureScrollDepth = () => {
      scrollFramePending = false;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return;
      const depth = Math.round((window.scrollY / scrollable) * 100);
      [25, 50, 75, 90].forEach(milestone => {
        if (depth < milestone || reachedScrollDepth.has(milestone)) return;
        reachedScrollDepth.add(milestone);
        trackSkincare('ScrollDepth', { percent: milestone });
      });
    };
    window.addEventListener('scroll', () => {
      if (scrollFramePending) return;
      scrollFramePending = true;
      requestAnimationFrame(measureScrollDepth);
    }, { passive: true, signal: trackingAbort.signal });

    const marquee = document.querySelector<HTMLElement>('.marquee');
    const marqueeTrack = document.querySelector<HTMLElement>('.marquee-track');
    if (marquee && marqueeTrack && marquee.dataset.manualReady !== 'true') {
      marquee.dataset.manualReady = 'true';
      const originalCards = Array.from(marqueeTrack.children);
      const before = document.createDocumentFragment();
      const after = document.createDocumentFragment();
      originalCards.forEach(card => {
        const previousClone = card.cloneNode(true) as HTMLElement;
        const nextClone = card.cloneNode(true) as HTMLElement;
        previousClone.setAttribute('aria-hidden', 'true');
        nextClone.setAttribute('aria-hidden', 'true');
        before.appendChild(previousClone);
        after.appendChild(nextClone);
      });
      marqueeTrack.prepend(before);
      marqueeTrack.append(after);
      let setWidth = 0;
      let normalizeTimer: number | undefined;

      const centerCarousel = () => {
        setWidth = marqueeTrack.scrollWidth / 3;
        marquee.scrollLeft = setWidth;
      };

      requestAnimationFrame(centerCarousel);
      window.addEventListener('resize', centerCarousel);
      marquee.addEventListener('scroll', () => {
        if (!setWidth) return;
        window.clearTimeout(normalizeTimer);
        normalizeTimer = window.setTimeout(() => {
          if (marquee.scrollLeft < setWidth) marquee.scrollLeft += setWidth;
          else if (marquee.scrollLeft >= setWidth * 2) marquee.scrollLeft -= setWidth;
        }, 90);
      }, { passive: true });

      const moveCarousel = (direction: number) => {
        const card = marqueeTrack.querySelector<HTMLElement>('.testimonial-card');
        if (!card) return;
        marquee.scrollBy({ left: direction * (card.offsetWidth + 18), behavior: 'smooth' });
      };

      document.getElementById('testimonials-prev')?.addEventListener('click', () => {
        moveCarousel(-1);
        trackSkincare('TestimonialCarouselNavigate', { direction: 'previous' });
      });
      document.getElementById('testimonials-next')?.addEventListener('click', () => {
        moveCarousel(1);
        trackSkincare('TestimonialCarouselNavigate', { direction: 'next' });
      });
    }

    const syncCarouselWithVideos = () => {
      const isAnyVideoPlaying = Array.from(document.querySelectorAll<HTMLVideoElement>('.testimonial-player'))
        .some(player => !player.paused && !player.ended);
      marquee?.classList.toggle('is-video-playing', isAnyVideoPlaying);
    };

    document.querySelectorAll<HTMLElement>('.testimonial-card').forEach(card => {
      const video = card.querySelector<HTMLVideoElement>('.testimonial-player');
      const cover = card.querySelector<HTMLImageElement>('.video-cover');
      const overlay = card.querySelector<HTMLButtonElement>('.video-overlay');
      if (!video || !cover || !overlay || video.dataset.ready === 'true') return;
      video.dataset.ready = 'true';

      overlay.addEventListener('click', async () => {
        trackSkincare('TestimonialPlay', {
          position: Number(card.dataset.testimonialIndex || 0),
          result: card.dataset.result || '',
        });
        document.querySelectorAll<HTMLVideoElement>('.testimonial-player').forEach(other => {
          if (other !== video && !other.paused) other.pause();
        });
        cover.classList.add('hidden');
        video.classList.remove('hidden');
        video.controls = true;
        overlay.classList.add('hidden');
        if (!video.src && video.dataset.src) {
          video.src = video.dataset.src;
          video.load();
        }
        try { await video.play(); } catch { overlay.classList.remove('hidden'); }
      });

      video.addEventListener('play', () => {
        overlay.classList.add('hidden');
        syncCarouselWithVideos();
      });
      video.addEventListener('pause', () => {
        if (!video.ended) overlay.classList.remove('hidden');
        syncCarouselWithVideos();
      });
      video.addEventListener('ended', () => {
        video.controls = false;
        video.classList.add('hidden');
        cover.classList.remove('hidden');
        overlay.classList.remove('hidden');
        video.currentTime = 0;
        syncCarouselWithVideos();
      });
    });
  });
</script>
