---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logoAlgoritmia1.webp';
---

<Layout
  title="Sistema C.A.R para Cosméticas — Algoritmia"
  description="Duplicamos la facturación de marcas de cosméticas y skincare en Argentina. Captación con Meta Ads + Atención con IA por WhatsApp + Retención automatizada. Un sistema completo."
  noindex={true}
>
  <Fragment slot="head">
    <!-- OG específico para esta landing -->
    <meta property="og:title" content="Sistema C.A.R para Cosméticas — Algoritmia" />
    <meta property="og:description" content="Duplicamos la facturación de tu marca. Captación con Meta Ads + Atención con IA + Retención automatizada." />
    <meta property="og:image" content="https://algoritmiadesarrollos.com.ar/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="https://algoritmiadesarrollos.com.ar/skincare" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Algoritmia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Sistema C.A.R para Cosméticas — Algoritmia" />
    <meta name="twitter:description" content="Duplicamos la facturación de tu marca. Captación + Atención IA + Retención." />
    <meta name="twitter:image" content="https://algoritmiadesarrollos.com.ar/og-image.jpg" />
  </Fragment>

<!-- ════════════ NAV ════════════ -->
<header class="fixed top-0 left-0 right-0 z-50 flex justify-center pt-2 md:pt-4 px-4 pointer-events-none">
  <!-- Mobile: full width, logo left + button right -->
  <div class="md:hidden pointer-events-auto glass-nav border border-white/20 shadow-lg shadow-black/5 rounded-[2rem] px-4 py-2 flex items-center justify-between transition-all duration-300 ring-1 ring-black/5 w-full">
    <a href="#hero" class="flex items-center hover:opacity-80 transition-opacity">
      <Image src={logo} alt="Algoritmia" class="w-8 h-8 object-contain" />
    </a>
    <a href="#contacto" class="cta-btn text-white px-5 py-2 rounded-full text-[13px] font-semibold transition-all">
      Quiero aplicar
    </a>
  </div>
  <!-- Desktop: mismo estilo que HeaderAds (auto width, 3 columnas, gap-16) -->
  <div class="hidden md:flex pointer-events-auto glass-nav border border-white/20 shadow-lg shadow-black/5 rounded-[2rem] px-6 md:px-8 py-2 flex-row items-center gap-16 transition-all duration-300 ring-1 ring-black/5">
    <div class="flex items-center justify-center w-[120px]">
      <a href="#hero" class="flex items-center text-primary hover:opacity-80 transition-opacity">
        <Image src={logo} alt="Algoritmia" class="w-10 h-10 object-contain" />
      </a>
    </div>
    <nav class="flex items-center gap-1">
      <a href="#sistema" class="text-[13px] font-medium text-primary/80 hover:text-primary transition-all px-4 py-2 rounded-full hover:bg-black/5 flex items-center justify-center">El sistema</a>
      <a href="#contacto" class="text-[13px] font-medium text-primary/80 hover:text-primary transition-all px-4 py-2 rounded-full hover:bg-black/5 flex items-center justify-center">Contacto</a>
    </nav>
    <div class="flex items-center justify-center">
      <a href="#contacto" class="cta-btn text-white px-5 py-2 rounded-full text-[13px] font-semibold transition-all whitespace-nowrap">
        Quiero aplicar
      </a>
    </div>
  </div>
</header>

<main class="bg-white">

  <!-- ════════════ HERO ════════════ -->
  <section id="hero" class="pt-32 md:pt-44 pb-20 px-6 md:px-12 text-center">
    <div class="max-w-4xl mx-auto">

      <div class="inline-flex items-center gap-2 bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold px-4 py-2 rounded-full mb-6 reveal">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
        C.A.R para Cosméticas
      </div>

      <h1 class="text-[38px] md:text-6xl lg:text-7xl font-semibold tracking-tighter leading-[1.05] text-primary mb-6 reveal delay-100">
        Duplicamos la facturación<br class="hidden md:block" /> de marcas de skincare
      </h1>

      <p class="text-base md:text-lg text-primary/50 mb-10 reveal delay-200">
        Captación con Meta Ads <span class="mx-1">+</span> Atención con IA <span class="mx-1">+</span> Retención Automatizada
      </p>

      <div class="flex justify-center reveal delay-300">
        <a href="#contacto" class="cta-btn h-12 px-8 text-white rounded-full text-sm font-semibold flex items-center justify-center gap-2">
          Quiero que me contacten
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>

      <!-- VIDEO -->
      <div id="video" class="mt-8 md:mt-12 reveal delay-300">
        <p class="text-xs md:text-sm text-primary/40 mb-5 font-medium">
          👇 Mirá este video para que veas cómo funciona
        </p>
        <div class="rounded-3xl overflow-hidden bg-gray-900 shadow-2xl shadow-primary/10 border border-primary/5 relative">
          <!--
            REEMPLAZÁ este bloque con tu embed de video:
            Wistia:  <script src="...player.js" async></script><wistia-player media-id="TU_ID"></wistia-player>
            YouTube: <iframe src="https://www.youtube.com/embed/TU_ID?rel=0" class="w-full aspect-video" allowfullscreen></iframe>
          -->
          <div class="aspect-video flex flex-col items-center justify-center gap-4 bg-gray-50 border border-primary/5 rounded-3xl">
            <div class="w-16 h-16 bg-primary/5 border border-primary/10 rounded-full flex items-center justify-center">
              <span class="material-symbols-outlined text-3xl text-primary/30">play_circle</span>
            </div>
            <p class="text-sm text-primary/30">Tu video va acá — reemplazá este bloque con el embed</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ════════════ PROBLEMA ════════════ -->
  <section class="py-24 px-6 md:px-12 bg-surface">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-14 reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary/40 mb-3">El problema</p>
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight text-primary mb-4">
          Lo que le pasa a la mayoría<br class="hidden md:block" /> de las marcas de skincare
        </h2>
        <p class="text-primary/60 text-base md:text-lg max-w-xl mx-auto">
          No es el producto. Es el sistema.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 reveal delay-100">
        {[
          {
            letter: 'C',
            color: 'emerald',
            title: 'Sin sistema de captación seguro',
            desc: 'No tienen una máquina predecible que traiga clientes nuevos cada mes. Dependen del orgánico, del boca en boca, o de ads que a veces funcionan y a veces no. Sin consistencia, no hay crecimiento.',
          },
          {
            letter: 'A',
            color: 'violet',
            title: 'Atención que pierde ventas',
            desc: 'Cada consulta por WhatsApp requiere a alguien que responda. Las preguntas básicas llegan tarde, los interesados se enfrían. Ventas que podrían cerrarse solas se pierden por demora.',
          },
          {
            letter: 'R',
            color: 'pink',
            title: 'Clientes que compran solo una vez',
            desc: 'El costo de conseguir un cliente nuevo es cada vez más alto. Sin un sistema que haga volver a quien ya compró, el negocio depende del 100% de publicidad para sobrevivir.',
          },
        ].map((item, i) => (
          <div class={`bg-white p-7 rounded-3xl border border-primary/5 hover:border-primary/10 hover:-translate-y-0.5 hover:shadow-lg transition-all duration-300 reveal delay-${(i+1)*100}`}>
            <div class={`w-10 h-10 rounded-xl flex items-center justify-center mb-5 bg-${item.color}-50 border border-${item.color}-100`}>
              <span class={`text-sm font-black text-${item.color}-600`}>{item.letter}</span>
            </div>
            <h3 class="text-base font-bold text-primary mb-2">{item.title}</h3>
            <p class="text-sm text-primary/60 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-6 bg-primary rounded-2xl p-6 text-white leading-relaxed reveal delay-200">
        <p class="text-base font-semibold mb-1">El Sistema CAR resuelve los tres a la vez.</p>
        <p class="text-sm text-white/60">Captación predecible con Meta Ads + Atención que cierra con IA + Retención automática. No son servicios sueltos — es un sistema que trabaja junto para que el negocio crezca.</p>
      </div>

    </div>
  </section>

  <!-- ════════════ SISTEMA CAR ════════════ -->
  <section class="py-24 px-6 md:px-12 bg-white" id="sistema">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-14 reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary/40 mb-3">La solución</p>
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight text-primary mb-4">El Sistema CAR</h2>
        <p class="text-primary/60 text-base md:text-lg max-w-xl mx-auto">
          Tres palancas integradas. No son servicios sueltos — cada parte alimenta a la siguiente.
        </p>
      </div>

      <div class="flex flex-col gap-4">

        <!-- C -->
        <div class="bg-surface p-7 rounded-3xl border border-primary/5 hover:border-emerald-200 hover:shadow-lg transition-all duration-300 reveal">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-11 h-11 bg-emerald-100 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-base font-black text-emerald-700">C</span>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-emerald-600">Captación</p>
              <h3 class="text-lg font-bold text-primary">Meta Ads que convierten</h3>
            </div>
          </div>
          <p class="text-primary/60 text-sm leading-relaxed mb-4">
            Más clientes nuevos cada mes — el sistema aprende qué convierte y escala lo que funciona sin quemar presupuesto.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Escalado seguro', 'Anuncios probados', 'Creativos frescos cada mes', 'Sin quemar presupuesto'].map(t => (
              <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700">{t}</span>
            ))}
          </div>
        </div>

        <!-- A -->
        <div class="bg-surface p-7 rounded-3xl border border-primary/5 hover:border-violet-200 hover:shadow-lg transition-all duration-300 reveal delay-100">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-11 h-11 bg-violet-100 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-base font-black text-violet-700">A</span>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">Atención</p>
              <h3 class="text-lg font-bold text-primary">WhatsApp con IA — 24 hs</h3>
            </div>
          </div>
          <p class="text-primary/60 text-sm leading-relaxed mb-4">
            La IA responde, cierra ventas y hace seguimiento post-compra. Si la consulta es compleja, transfiere al equipo humano sin perder la venta.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Consultas de producto', 'Cierre de venta', 'Post-compra', 'Transferencia a humano'].map(t => (
              <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-violet-50 border border-violet-200 text-violet-700">{t}</span>
            ))}
          </div>
        </div>

        <!-- R -->
        <div class="bg-surface p-7 rounded-3xl border border-primary/5 hover:border-pink-200 hover:shadow-lg transition-all duration-300 reveal delay-200">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-11 h-11 bg-pink-100 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-base font-black text-pink-700">R</span>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-pink-600">Retención</p>
              <h3 class="text-lg font-bold text-primary">Recompra automática</h3>
            </div>
          </div>
          <p class="text-primary/60 text-sm leading-relaxed mb-4">
            El sistema detecta cuándo el cliente está listo para volver a comprar y le escribe solo. Más ingresos sin más publicidad.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Más ventas sin más ads', 'Clientes que vuelven solos', 'LTV más alto', 'Sin trabajo manual'].map(t => (
              <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-pink-50 border border-pink-200 text-pink-700">{t}</span>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════ PORTAL ════════════ -->
  <section class="py-24 px-6 md:px-12 bg-surface">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-12 reveal">
        <div class="inline-flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-700 text-xs font-semibold px-4 py-2 rounded-full mb-5">
          ✦ Portal del Cliente
        </div>
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight text-primary mb-3">Tu negocio, en tiempo real</h2>
        <p class="text-primary/50 text-base max-w-sm mx-auto">Sin pedirle reportes a nadie. Sin entrar al Administrador de Meta.</p>
      </div>

      <!-- Mock dashboard -->
      <div class="bg-[#0f0f11] rounded-3xl overflow-hidden shadow-2xl shadow-primary/20 border border-white/5 reveal delay-100">

        <!-- Top bar -->
        <div class="flex items-center gap-2 px-5 py-4 border-b border-white/5">
          <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-500/70"></div>
          <div class="ml-4 flex-1 h-6 rounded-full bg-white/5 max-w-xs"></div>
        </div>

        <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-3 gap-4">

          <!-- Metric cards -->
          <div class="bg-white/5 rounded-2xl p-5 border border-white/5">
            <p class="text-xs text-white/30 font-medium mb-2">ROAS</p>
            <p class="text-3xl font-bold text-white mb-1">4.8x</p>
            <p class="text-xs text-emerald-400 font-semibold">↑ +12% esta semana</p>
            <div class="mt-4 flex items-end gap-1 h-10">
              {[40,55,48,70,65,80,90].map(h => (
                <div class="flex-1 rounded-sm bg-emerald-500/40" style={`height:${h}%`}></div>
              ))}
            </div>
          </div>

          <div class="bg-white/5 rounded-2xl p-5 border border-white/5">
            <p class="text-xs text-white/30 font-medium mb-2">Inversión del mes</p>
            <p class="text-3xl font-bold text-white mb-1">$1.240</p>
            <p class="text-xs text-white/30 font-semibold">USD · Meta Ads</p>
            <div class="mt-4 flex items-end gap-1 h-10">
              {[30,45,40,60,55,70,65].map(h => (
                <div class="flex-1 rounded-sm bg-violet-500/40" style={`height:${h}%`}></div>
              ))}
            </div>
          </div>

          <div class="bg-white/5 rounded-2xl p-5 border border-white/5">
            <p class="text-xs text-white/30 font-medium mb-2">IA — Estado</p>
            <div class="flex items-center gap-2 mt-1 mb-3">
              <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></div>
              <p class="text-sm font-semibold text-white">Activa</p>
            </div>
            <div class="flex flex-col gap-2 mt-2">
              <div class="h-7 rounded-xl bg-white/5 border border-white/5 px-3 flex items-center gap-2">
                <div class="w-4 h-4 rounded-full bg-violet-500/50 flex-shrink-0"></div>
                <div class="h-2 rounded-full bg-white/10 flex-1"></div>
              </div>
              <div class="h-7 rounded-xl bg-emerald-500/10 border border-emerald-500/20 px-3 flex items-center gap-2">
                <div class="w-4 h-4 rounded-full bg-emerald-500/50 flex-shrink-0"></div>
                <div class="h-2 rounded-full bg-white/10 w-3/4"></div>
              </div>
              <div class="h-7 rounded-xl bg-white/5 border border-white/5 px-3 flex items-center gap-2">
                <div class="w-4 h-4 rounded-full bg-violet-500/50 flex-shrink-0"></div>
                <div class="h-2 rounded-full bg-white/10 w-1/2"></div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Feature chips below dashboard -->
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3 reveal delay-200">
        {[
          { icon: 'bar_chart', label: 'Métricas en tiempo real' },
          { icon: 'chat', label: 'Inbox de la IA' },
          { icon: 'toggle_on', label: 'Pausá la IA con un click' },
          { icon: 'auto_awesome', label: 'Mejoras sin costo extra' },
        ].map(f => (
          <div class="bg-white border border-primary/5 rounded-2xl px-4 py-3 flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-lg text-amber-500">{f.icon}</span>
            <p class="text-xs font-semibold text-primary leading-tight">{f.label}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ════════════ CONTACTO ════════════ -->
  <section class="py-24 px-6 md:px-12 bg-surface" id="contacto">
    <div class="max-w-lg mx-auto">

      <div class="text-center mb-8 reveal">
        <div class="inline-flex items-center gap-2 bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold px-4 py-2 rounded-full mb-5">
          <span class="w-1.5 h-1.5 bg-rose-500 rounded-full animate-pulse"></span>
          Cupos limitados por mes
        </div>
        <h2 class="text-2xl md:text-4xl font-semibold tracking-tight text-primary mb-2">¿Tu marca califica?</h2>
        <p class="text-sm text-primary/50">Respondé 2 preguntas. Si calificás, te contactamos en menos de 24 hs.</p>
      </div>

      <div class="bg-white rounded-3xl shadow-apple border border-primary/5 p-8 md:p-10 reveal delay-100">

        <!-- Progress bar -->
        <div class="flex items-center gap-2 mb-8" id="progress-bar">
          <div class="h-1.5 flex-1 rounded-full bg-rose-500 transition-all duration-500" id="prog-1"></div>
          <div class="h-1.5 flex-1 rounded-full bg-gray-100 transition-all duration-500" id="prog-2"></div>
          <div class="h-1.5 flex-1 rounded-full bg-gray-100 transition-all duration-500" id="prog-3"></div>
        </div>

        <!-- STEP 1: Tienda online -->
        <div id="step-1">
          <p class="text-xs font-semibold uppercase tracking-widest text-primary/40 mb-2">Paso 1 de 3</p>
          <h3 class="text-lg font-bold text-primary mb-6">¿Tu marca vende por tienda online?</h3>
          <div class="flex flex-col gap-3">
            {[
              { label: 'Sí, en TiendaNube', value: 'tiendanube', ok: true },
              { label: 'Sí, en Shopify', value: 'shopify', ok: true },
              { label: 'Sí, en otra plataforma', value: 'otra', ok: true },
              { label: 'No, solo por WhatsApp / Instagram', value: 'no', ok: false },
            ].map(opt => (
              <button type="button" class="store-opt w-full text-left px-5 py-4 rounded-2xl border-2 border-primary/8 hover:border-rose-400 hover:bg-rose-50 transition-all duration-200 text-sm font-semibold text-primary flex items-center justify-between group" data-value={opt.value} data-ok={opt.ok ? 'true' : 'false'}>
                {opt.label}
                <span class="material-symbols-outlined text-lg text-primary/20 group-hover:text-rose-500 transition-colors">chevron_right</span>
              </button>
            ))}
          </div>
        </div>

        <!-- STEP 2: Facturación -->
        <div id="step-2" class="hidden">
          <p class="text-xs font-semibold uppercase tracking-widest text-primary/40 mb-2">Paso 2 de 3</p>
          <h3 class="text-lg font-bold text-primary mb-6">¿Cuánto facturás por mes con tu tienda?</h3>
          <div class="flex flex-col gap-3">
            {[
              { label: 'Menos de USD 3.000 / mes', value: 'low', ok: false },
              { label: 'USD 3.000 – 15.000 / mes', value: 'med', ok: true },
              { label: 'USD 15.000 – 50.000 / mes', value: 'high', ok: true },
              { label: 'Más de USD 50.000 / mes', value: 'top', ok: true },
            ].map(opt => (
              <button type="button" class="rev-opt w-full text-left px-5 py-4 rounded-2xl border-2 border-primary/8 hover:border-rose-400 hover:bg-rose-50 transition-all duration-200 text-sm font-semibold text-primary flex items-center justify-between group" data-value={opt.value} data-ok={opt.ok ? 'true' : 'false'}>
                {opt.label}
                <span class="material-symbols-outlined text-lg text-primary/20 group-hover:text-rose-500 transition-colors">chevron_right</span>
              </button>
            ))}
          </div>
          <button type="button" id="back-1" class="mt-4 text-xs text-primary/40 hover:text-primary transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver
          </button>
        </div>

        <!-- STEP 3: Datos -->
        <div id="step-3" class="hidden">
          <p class="text-xs font-semibold uppercase tracking-widest text-primary/40 mb-2">Paso 3 de 3</p>
          <h3 class="text-lg font-bold text-primary mb-6">¿A dónde te contactamos?</h3>
          <form id="lp-form" class="space-y-6">
            <input type="hidden" id="lp-store" name="tienda" />
            <input type="hidden" id="lp-revenue" name="facturacion" />
            <div class="relative group">
              <input class="peer w-full border-0 border-b border-gray-200 bg-transparent py-3 px-1 text-sm text-primary placeholder-transparent focus:border-rose-500 focus:ring-0 transition-colors" id="lp-nombre" name="nombre" placeholder="Nombre" type="text" required />
              <label class="absolute left-1 -top-3.5 text-xs text-primary/40 transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-sm peer-placeholder-shown:text-primary/40 peer-focus:-top-3.5 peer-focus:text-xs peer-focus:text-rose-500 pointer-events-none" for="lp-nombre">Tu nombre</label>
            </div>
            <div class="relative group">
              <input class="peer w-full border-0 border-b border-gray-200 bg-transparent py-3 px-1 text-sm text-primary placeholder-transparent focus:border-rose-500 focus:ring-0 transition-colors" id="lp-marca" name="marca" placeholder="Marca" type="text" required />
              <label class="absolute left-1 -top-3.5 text-xs text-primary/40 transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-sm peer-placeholder-shown:text-primary/40 peer-focus:-top-3.5 peer-focus:text-xs peer-focus:text-rose-500 pointer-events-none" for="lp-marca">Nombre de tu marca</label>
            </div>
            <div class="relative group">
              <input class="peer w-full border-0 border-b border-gray-200 bg-transparent py-3 px-1 text-sm text-primary placeholder-transparent focus:border-rose-500 focus:ring-0 transition-colors" id="lp-wa" name="whatsapp" placeholder="WhatsApp" type="tel" required />
              <label class="absolute left-1 -top-3.5 text-xs text-primary/40 transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-sm peer-placeholder-shown:text-primary/40 peer-focus:-top-3.5 peer-focus:text-xs peer-focus:text-rose-500 pointer-events-none" for="lp-wa">WhatsApp</label>
            </div>
            <button type="submit" id="lp-submit" class="cta-btn w-full text-white py-4 px-8 rounded-full font-semibold transition-all duration-300 text-sm mt-2">
              Quiero que me contacten →
            </button>
            <p class="text-xs text-primary/40 text-center">Te respondemos por WhatsApp en menos de 24 hs. Sin compromiso.</p>
          </form>
          <button type="button" id="back-2" class="mt-2 text-xs text-primary/40 hover:text-primary transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver
          </button>
        </div>

        <!-- DISQUALIFY -->
        <div id="step-disqualify" class="hidden text-center py-4">
          <div class="w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined text-2xl text-primary/30">schedule</span>
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">Todavía no es el momento</h3>
          <p class="text-sm text-primary/50 leading-relaxed mb-6" id="disqualify-msg">El Sistema C.A.R está diseñado para marcas con tienda online activa.</p>
          <button type="button" id="back-disq" class="text-xs text-primary/40 hover:text-primary transition-colors flex items-center gap-1 mx-auto">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver
          </button>
        </div>

        <!-- SUCCESS -->
        <div id="step-success" class="hidden text-center py-4">
          <div class="w-14 h-14 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined text-2xl text-rose-600">check_circle</span>
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">¡Listo! Recibimos tu solicitud</h3>
          <p class="text-sm text-primary/50 leading-relaxed">Revisamos tu perfil y te escribimos por WhatsApp en las próximas 24 hs.</p>
        </div>

      </div>


    </div>
  </section>

</main>


<style>
  .glass-nav {
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  select option { color: #1d1d1f; background: white; }
  .lp-select {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: none;
    background-color: transparent;
    border-top: none;
    border-left: none;
    border-right: none;
  }

  /* CTA button — rosa fucsia con shimmer */
  .cta-btn {
    background: linear-gradient(135deg, #f43f5e, #ec4899);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(244, 63, 94, 0.35);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .cta-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -160%;
    width: 70%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
    transform: skewX(-15deg);
    animation: shimmer-sweep 3.5s ease-in-out infinite;
  }
  .cta-btn:hover {
    box-shadow: 0 6px 28px rgba(244, 63, 94, 0.5);
    transform: translateY(-1px);
  }
  @keyframes shimmer-sweep {
    0%        { left: -160%; }
    35%, 100% { left: 200%; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {

    // ── Multi-step form ──
    const steps = {
      s1: document.getElementById('step-1'),
      s2: document.getElementById('step-2'),
      s3: document.getElementById('step-3'),
      disq: document.getElementById('step-disqualify'),
      ok: document.getElementById('step-success'),
    };
    const prog = [
      document.getElementById('prog-1'),
      document.getElementById('prog-2'),
      document.getElementById('prog-3'),
    ];
    const progressBar = document.getElementById('progress-bar');

    function showOnly(el: HTMLElement | null) {
      Object.values(steps).forEach(s => s?.classList.add('hidden'));
      el?.classList.remove('hidden');
    }

    function setProgress(n: number) {
      prog.forEach((p, i) => {
        if (!p) return;
        p.classList.toggle('bg-rose-500', i < n);
        p.classList.toggle('bg-gray-100', i >= n);
      });
      if (progressBar) progressBar.classList.toggle('hidden', n === 0);
    }

    // Step 1 — tienda
    document.querySelectorAll('.store-opt').forEach(btn => {
      btn.addEventListener('click', () => {
        const ok = (btn as HTMLElement).dataset.ok === 'true';
        const val = (btn as HTMLElement).dataset.value ?? '';
        const hidden = document.getElementById('lp-store') as HTMLInputElement | null;
        if (hidden) hidden.value = val;
        if (ok) { showOnly(steps.s2); setProgress(2); }
        else {
          const msg = document.getElementById('disqualify-msg');
          if (msg) msg.textContent = 'El Sistema C.A.R necesita una tienda online para funcionar. Guardá este link — cuando la tengas, volvé.';
          showOnly(steps.disq); setProgress(0);
        }
      });
    });

    // Step 2 — facturación
    document.querySelectorAll('.rev-opt').forEach(btn => {
      btn.addEventListener('click', () => {
        const ok = (btn as HTMLElement).dataset.ok === 'true';
        const val = (btn as HTMLElement).dataset.value ?? '';
        const hidden = document.getElementById('lp-revenue') as HTMLInputElement | null;
        if (hidden) hidden.value = val;
        if (ok) { showOnly(steps.s3); setProgress(3); }
        else {
          const msg = document.getElementById('disqualify-msg');
          if (msg) msg.textContent = 'Todavía no estás en el volumen ideal para el sistema. Guardá este link — cuando llegues a ese punto, el C.A.R puede multiplicar tus resultados.';
          showOnly(steps.disq); setProgress(0);
        }
      });
    });

    // Backs
    document.getElementById('back-1')?.addEventListener('click', () => { showOnly(steps.s1); setProgress(1); });
    document.getElementById('back-2')?.addEventListener('click', () => { showOnly(steps.s2); setProgress(2); });
    document.getElementById('back-disq')?.addEventListener('click', () => { showOnly(steps.s1); setProgress(1); });

    // Submit
    const form = document.getElementById('lp-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('lp-submit') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) { submitBtn.textContent = 'Enviando...'; submitBtn.disabled = true; }
      const data = { ...Object.fromEntries(new FormData(form)), source: 'landing-cosmeticas' };
      try {
        await fetch('/api/send-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
      } catch {}
      showOnly(steps.ok);
      setProgress(0);
      if ((window as any).fbq) (window as any).fbq('track', 'Lead', { content_name: 'Landing Cosmeticas CAR' });
    });

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const id = (a as HTMLAnchorElement).getAttribute('href')?.replace('#', '');
        const el = id ? document.getElementById(id) : null;
        if (el) { e.preventDefault(); el.scrollIntoView({ behavior: 'smooth' }); }
      });
    });
  });
</script>

</Layout>
