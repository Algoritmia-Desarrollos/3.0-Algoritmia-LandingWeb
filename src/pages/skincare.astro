<script>
  document.addEventListener('astro:page-load', () => {
    // Form
    const form = document.getElementById('lp-form') as HTMLFormElement | null;
    const success = document.getElementById('form-success');
    const btn = document.getElementById('lp-submit') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn) { btn.textContent = 'Enviando...'; btn.disabled = true; }
      const data = { ...Object.fromEntries(new FormData(form)), source: 'landing-skincare' };
      try {
        await fetch('/api/send-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
      } catch {}
      if (form) form.style.display = 'none';
      if (success) success.style.display = 'block';
      if ((window as any).fbq) (window as any).fbq('track', 'Lead', { content_name: 'Landing Skincare CAR' });
    });

    // Smooth scroll for nav links
    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const id = (a as HTMLAnchorElement).getAttribute('href')?.replace('#', '');
        const el = id ? document.getElementById(id) : null;
        if (el) { e.preventDefault(); el.scrollIntoView({ behavior: 'smooth' }); }
      });
    });
  });
</script>

