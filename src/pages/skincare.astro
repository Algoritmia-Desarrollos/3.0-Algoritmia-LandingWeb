---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logoAlgoritmia1.webp';
---

<Layout
  title="Sistema CAR para Skincare — Algoritmia"
  description="Duplicamos la facturación de marcas de skincare en Argentina con el Sistema CAR: Meta Ads + IA por WhatsApp + Retención automatizada."
  noindex={true}
>

<!-- ════════════ NAV ════════════ -->
<header class="fixed top-0 left-0 right-0 z-50 flex justify-center pt-2 md:pt-4 px-4 pointer-events-none">
  <!-- Mobile: full width, logo left + button right -->
  <div class="md:hidden pointer-events-auto glass-nav border border-white/20 shadow-lg shadow-black/5 rounded-[2rem] px-4 py-2 flex items-center justify-between transition-all duration-300 ring-1 ring-black/5 w-full">
    <a href="#hero" class="flex items-center hover:opacity-80 transition-opacity">
      <Image src={logo} alt="Algoritmia" class="w-8 h-8 object-contain" />
    </a>
    <a href="#contacto" class="bg-primary text-white px-5 py-2 rounded-full text-[13px] font-medium hover:bg-[#2c2c2e] transition-all shadow-md shadow-primary/10">
      Quiero aplicar
    </a>
  </div>
  <!-- Desktop: mismo estilo que HeaderAds (auto width, 3 columnas, gap-16) -->
  <div class="hidden md:flex pointer-events-auto glass-nav border border-white/20 shadow-lg shadow-black/5 rounded-[2rem] px-6 md:px-8 py-2 flex-row items-center gap-16 transition-all duration-300 ring-1 ring-black/5">
    <div class="flex items-center justify-center w-[120px]">
      <a href="#hero" class="flex items-center text-primary hover:opacity-80 transition-opacity">
        <Image src={logo} alt="Algoritmia" class="w-10 h-10 object-contain" />
      </a>
    </div>
    <nav class="flex items-center gap-1">
      <a href="#sistema" class="text-[13px] font-medium text-primary/80 hover:text-primary transition-all px-4 py-2 rounded-full hover:bg-black/5 flex items-center justify-center">Sistema</a>
      <a href="#precios" class="text-[13px] font-medium text-primary/80 hover:text-primary transition-all px-4 py-2 rounded-full hover:bg-black/5 flex items-center justify-center">Inversión</a>
      <a href="#contacto" class="text-[13px] font-medium text-primary/80 hover:text-primary transition-all px-4 py-2 rounded-full hover:bg-black/5 flex items-center justify-center">Contacto</a>
    </nav>
    <div class="flex items-center justify-center">
      <a href="#contacto" class="bg-primary text-white px-5 py-2 rounded-full text-[13px] font-medium hover:bg-[#2c2c2e] transition-all shadow-md shadow-primary/10 whitespace-nowrap">
        Quiero aplicar
      </a>
    </div>
  </div>
</header>

<main class="bg-white">

  <!-- ════════════ HERO ════════════ -->
  <section id="hero" class="pt-32 md:pt-44 pb-20 px-6 md:px-12 text-center">
    <div class="max-w-4xl mx-auto">

      <div class="inline-flex items-center gap-2 bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold px-4 py-2 rounded-full mb-6 reveal">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
        C.A.R para Cosméticas
      </div>

      <h1 class="text-[38px] md:text-6xl lg:text-7xl font-semibold tracking-tighter leading-[1.05] text-primary mb-6 reveal delay-100">
        Duplicamos la facturación<br class="hidden md:block" /> de marcas de skincare
      </h1>

      <p class="text-base md:text-lg text-primary/50 mb-10 reveal delay-200">
        Captación con Meta Ads <span class="mx-1">+</span> Atención con IA <span class="mx-1">+</span> Retención Automatizada
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center reveal delay-300">
        <a href="#contacto" class="h-12 px-8 bg-primary text-white rounded-full text-sm font-medium hover:bg-[#2c2c2e] transition-all shadow-xl shadow-primary/10 flex items-center justify-center gap-2">
          Quiero aplicar al sistema
          <span class="material-symbols-outlined text-lg">arrow_forward</span>
        </a>
        <a href="#video" class="h-12 px-8 bg-white border border-primary/10 text-primary rounded-full text-sm font-medium hover:bg-surface transition-all flex items-center justify-center">
          Ver cómo funciona
        </a>
      </div>

      <!-- VIDEO -->
      <div id="video" class="mt-8 md:mt-12 reveal delay-300">
        <p class="text-xs md:text-sm text-primary/40 mb-5 font-medium">
          👇 Mirá este video para que veas cómo funciona
        </p>
        <div class="rounded-3xl overflow-hidden bg-gray-900 shadow-2xl shadow-primary/10 border border-primary/5 relative">
          <!--
            REEMPLAZÁ este bloque con tu embed de video:
            Wistia:  <script src="...player.js" async></script><wistia-player media-id="TU_ID"></wistia-player>
            YouTube: <iframe src="https://www.youtube.com/embed/TU_ID?rel=0" class="w-full aspect-video" allowfullscreen></iframe>
          -->
          <div class="aspect-video flex flex-col items-center justify-center gap-4 bg-gray-50 border border-primary/5 rounded-3xl">
            <div class="w-16 h-16 bg-primary/5 border border-primary/10 rounded-full flex items-center justify-center">
              <span class="material-symbols-outlined text-3xl text-primary/30">play_circle</span>
            </div>
            <p class="text-sm text-primary/30">Tu video va acá — reemplazá este bloque con el embed</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ════════════ PROBLEMA ════════════ -->
  <section class="py-24 px-6 md:px-12 bg-surface">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-14 reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary/40 mb-3">El problema</p>
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight text-primary mb-4">
          Lo que le pasa a la mayoría<br class="hidden md:block" /> de las marcas de skincare
        </h2>
        <p class="text-primary/60 text-base md:text-lg max-w-xl mx-auto">
          No es el producto. Es el sistema.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 reveal delay-100">
        {[
          {
            letter: 'C',
            color: 'emerald',
            title: 'Sin sistema de captación seguro',
            desc: 'No tienen una máquina predecible que traiga clientes nuevos cada mes. Dependen del orgánico, del boca en boca, o de ads que a veces funcionan y a veces no. Sin consistencia, no hay crecimiento.',
          },
          {
            letter: 'A',
            color: 'violet',
            title: 'Atención que pierde ventas',
            desc: 'Cada consulta por WhatsApp requiere a alguien que responda. Las preguntas básicas llegan tarde, los interesados se enfrían. Ventas que podrían cerrarse solas se pierden por demora.',
          },
          {
            letter: 'R',
            color: 'pink',
            title: 'Clientes que compran solo una vez',
            desc: 'El costo de conseguir un cliente nuevo es cada vez más alto. Sin un sistema que haga volver a quien ya compró, el negocio depende del 100% de publicidad para sobrevivir.',
          },
        ].map((item, i) => (
          <div class={`bg-white p-7 rounded-3xl border border-primary/5 hover:border-primary/10 hover:-translate-y-0.5 hover:shadow-lg transition-all duration-300 reveal delay-${(i+1)*100}`}>
            <div class={`w-10 h-10 rounded-xl flex items-center justify-center mb-5 bg-${item.color}-50 border border-${item.color}-100`}>
              <span class={`text-sm font-black text-${item.color}-600`}>{item.letter}</span>
            </div>
            <h3 class="text-base font-bold text-primary mb-2">{item.title}</h3>
            <p class="text-sm text-primary/60 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-6 bg-primary rounded-2xl p-6 text-white leading-relaxed reveal delay-200">
        <p class="text-base font-semibold mb-1">El Sistema CAR resuelve los tres a la vez.</p>
        <p class="text-sm text-white/60">Captación predecible con Meta Ads + Atención que cierra con IA + Retención automática. No son servicios sueltos — es un sistema que trabaja junto para que el negocio crezca.</p>
      </div>

    </div>
  </section>

  <!-- ════════════ SISTEMA CAR ════════════ -->
  <section class="py-24 px-6 md:px-12 bg-white" id="sistema">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-14 reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary/40 mb-3">La solución</p>
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight text-primary mb-4">El Sistema CAR</h2>
        <p class="text-primary/60 text-base md:text-lg max-w-xl mx-auto">
          Tres palancas integradas. No son servicios sueltos — cada parte alimenta a la siguiente.
        </p>
      </div>

      <div class="flex flex-col gap-4">

        <!-- C -->
        <div class="bg-surface p-7 rounded-3xl border border-primary/5 hover:border-emerald-200 hover:shadow-lg transition-all duration-300 reveal">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-11 h-11 bg-emerald-100 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-base font-black text-emerald-700">C</span>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-emerald-600">Captación</p>
              <h3 class="text-lg font-bold text-primary">Meta Ads que convierten</h3>
            </div>
          </div>
          <p class="text-primary/60 text-sm leading-relaxed mb-4">
            Más clientes nuevos cada mes — el sistema aprende qué convierte y escala lo que funciona sin quemar presupuesto.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Escalado seguro', 'Anuncios probados', 'Creativos frescos cada mes', 'Sin quemar presupuesto'].map(t => (
              <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700">{t}</span>
            ))}
          </div>
        </div>

        <!-- A -->
        <div class="bg-surface p-7 rounded-3xl border border-primary/5 hover:border-violet-200 hover:shadow-lg transition-all duration-300 reveal delay-100">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-11 h-11 bg-violet-100 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-base font-black text-violet-700">A</span>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-violet-600">Atención</p>
              <h3 class="text-lg font-bold text-primary">WhatsApp con IA — 24 hs</h3>
            </div>
          </div>
          <p class="text-primary/60 text-sm leading-relaxed mb-4">
            La IA responde, cierra ventas y hace seguimiento post-compra. Si la consulta es compleja, transfiere al equipo humano sin perder la venta.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Consultas de producto', 'Cierre de venta', 'Post-compra', 'Transferencia a humano'].map(t => (
              <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-violet-50 border border-violet-200 text-violet-700">{t}</span>
            ))}
          </div>
        </div>

        <!-- R -->
        <div class="bg-surface p-7 rounded-3xl border border-primary/5 hover:border-pink-200 hover:shadow-lg transition-all duration-300 reveal delay-200">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-11 h-11 bg-pink-100 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-base font-black text-pink-700">R</span>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-pink-600">Retención</p>
              <h3 class="text-lg font-bold text-primary">Recompra automática</h3>
            </div>
          </div>
          <p class="text-primary/60 text-sm leading-relaxed mb-4">
            El sistema detecta cuándo el cliente está listo para volver a comprar y le escribe solo. Más ingresos sin más publicidad.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Más ventas sin más ads', 'Clientes que vuelven solos', 'LTV más alto', 'Sin trabajo manual'].map(t => (
              <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-pink-50 border border-pink-200 text-pink-700">{t}</span>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════ PORTAL ════════════ -->
  <section class="py-24 px-6 md:px-12 bg-surface">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-12 reveal">
        <div class="inline-flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-700 text-xs font-semibold px-4 py-2 rounded-full mb-5">
          ✦ Portal del Cliente
        </div>
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight text-primary mb-3">Tu negocio, en tiempo real</h2>
        <p class="text-primary/50 text-base max-w-sm mx-auto">Sin pedirle reportes a nadie. Sin entrar al Administrador de Meta.</p>
      </div>

      <!-- Mock dashboard -->
      <div class="bg-[#0f0f11] rounded-3xl overflow-hidden shadow-2xl shadow-primary/20 border border-white/5 reveal delay-100">

        <!-- Top bar -->
        <div class="flex items-center gap-2 px-5 py-4 border-b border-white/5">
          <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-500/70"></div>
          <div class="ml-4 flex-1 h-6 rounded-full bg-white/5 max-w-xs"></div>
        </div>

        <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-3 gap-4">

          <!-- Metric cards -->
          <div class="bg-white/5 rounded-2xl p-5 border border-white/5">
            <p class="text-xs text-white/30 font-medium mb-2">ROAS</p>
            <p class="text-3xl font-bold text-white mb-1">4.8x</p>
            <p class="text-xs text-emerald-400 font-semibold">↑ +12% esta semana</p>
            <div class="mt-4 flex items-end gap-1 h-10">
              {[40,55,48,70,65,80,90].map(h => (
                <div class="flex-1 rounded-sm bg-emerald-500/40" style={`height:${h}%`}></div>
              ))}
            </div>
          </div>

          <div class="bg-white/5 rounded-2xl p-5 border border-white/5">
            <p class="text-xs text-white/30 font-medium mb-2">Inversión del mes</p>
            <p class="text-3xl font-bold text-white mb-1">$1.240</p>
            <p class="text-xs text-white/30 font-semibold">USD · Meta Ads</p>
            <div class="mt-4 flex items-end gap-1 h-10">
              {[30,45,40,60,55,70,65].map(h => (
                <div class="flex-1 rounded-sm bg-violet-500/40" style={`height:${h}%`}></div>
              ))}
            </div>
          </div>

          <div class="bg-white/5 rounded-2xl p-5 border border-white/5">
            <p class="text-xs text-white/30 font-medium mb-2">IA — Estado</p>
            <div class="flex items-center gap-2 mt-1 mb-3">
              <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></div>
              <p class="text-sm font-semibold text-white">Activa</p>
            </div>
            <div class="flex flex-col gap-2 mt-2">
              <div class="h-7 rounded-xl bg-white/5 border border-white/5 px-3 flex items-center gap-2">
                <div class="w-4 h-4 rounded-full bg-violet-500/50 flex-shrink-0"></div>
                <div class="h-2 rounded-full bg-white/10 flex-1"></div>
              </div>
              <div class="h-7 rounded-xl bg-emerald-500/10 border border-emerald-500/20 px-3 flex items-center gap-2">
                <div class="w-4 h-4 rounded-full bg-emerald-500/50 flex-shrink-0"></div>
                <div class="h-2 rounded-full bg-white/10 w-3/4"></div>
              </div>
              <div class="h-7 rounded-xl bg-white/5 border border-white/5 px-3 flex items-center gap-2">
                <div class="w-4 h-4 rounded-full bg-violet-500/50 flex-shrink-0"></div>
                <div class="h-2 rounded-full bg-white/10 w-1/2"></div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Feature chips below dashboard -->
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3 reveal delay-200">
        {[
          { icon: 'bar_chart', label: 'Métricas en tiempo real' },
          { icon: 'chat', label: 'Inbox de la IA' },
          { icon: 'toggle_on', label: 'Pausá la IA con un click' },
          { icon: 'auto_awesome', label: 'Mejoras sin costo extra' },
        ].map(f => (
          <div class="bg-white border border-primary/5 rounded-2xl px-4 py-3 flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-lg text-amber-500">{f.icon}</span>
            <p class="text-xs font-semibold text-primary leading-tight">{f.label}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ════════════ PRICING ════════════ -->
  <section class="py-24 px-6 md:px-12 bg-surface" id="precios">
    <div class="max-w-2xl mx-auto">

      <div class="text-center mb-10 reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary/40 mb-3">Inversión</p>
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight text-primary mb-4">La mensualidad sube<br />con tu facturación</h2>
        <p class="text-primary/60 text-base max-w-md mx-auto leading-relaxed">
          Según tu facturación.
        </p>
      </div>

      <div class="bg-white rounded-3xl border border-primary/5 shadow-apple overflow-hidden reveal delay-100">

        <!-- Setup -->
        <div class="p-7 flex items-center justify-between gap-6 border-b border-primary/5">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-emerald-600 mb-1">Pago único al inicio</p>
            <p class="text-sm text-primary font-semibold">Setup, instalación del Sistema CAR + onboarding</p>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-3xl font-bold text-primary tracking-tight">USD 600</p>
            <p class="text-xs text-primary/40">setup único</p>
          </div>
        </div>

        <!-- Label -->
        <div class="px-7 pt-6 pb-2">
          <p class="text-xs font-semibold uppercase tracking-widest text-primary/40">Mensualidad — según facturación</p>
        </div>

        <!-- Tiers -->
        {[
          { label: 'Tier 1 — Arranque', range: 'Hasta USD 20.000 / mes facturado', price: 'USD 600', note: 'Mientras el sistema toma velocidad.', accent: 'text-primary/50' },
          { label: 'Tier 2 — Crecimiento', range: 'USD 20.000 – 50.000 / mes', price: 'USD 1.200', note: 'Sistema con datos y creativos optimizados.', accent: 'text-emerald-600' },
          { label: 'Tier 3 — Escala', range: 'USD 50.000 – 100.000 / mes', price: 'USD 2.000', note: 'Operación de alto volumen.', accent: 'text-violet-600' },
          { label: 'Tier 4 — Alto impacto', range: 'USD 100.000+ / mes', price: 'USD 3.000', note: 'Máxima expresión del Sistema CAR.', accent: 'text-amber-600' },
        ].map((t, i) => (
          <div class={`px-7 py-5 flex items-center justify-between gap-4 ${i < 3 ? 'border-b border-primary/5' : ''}`}>
            <div>
              <p class={`text-xs font-bold uppercase tracking-wider mb-1 ${t.accent}`}>{t.label}</p>
              <p class="text-sm font-semibold text-primary">{t.range}</p>
              <p class="text-xs text-primary/40 mt-0.5">{t.note}</p>
            </div>
            <div class="text-right flex-shrink-0">
              <p class="text-2xl font-bold text-primary tracking-tight">{t.price}</p>
              <p class="text-xs text-primary/40">/mes</p>
            </div>
          </div>
        ))}

        <!-- Footer note -->
        <div class="px-7 py-5 bg-surface border-t border-primary/5 flex items-center gap-2">
          <span class="material-symbols-outlined text-sm text-primary/50">info</span>
          <p class="text-xs text-primary/60">La inversión en publicidad va aparte — mínimo recomendado USD 800/mes en Meta Ads.</p>
        </div>

      </div>

      <div class="mt-5 bg-primary rounded-2xl p-6 text-white reveal delay-200">
        <p class="text-sm font-semibold mb-2">¿Cómo funciona el precio?</p>
        <p class="text-sm text-white/70 leading-relaxed">
          La mensualidad se ajusta automáticamente según lo que factures. Si facturás menos de USD 20.000, pagás el tier más bajo. Si crezcés a USD 20K–50K, subís al siguiente, y así. Cobramos más solo cuando vos ganás más.
        </p>
      </div>

    </div>
  </section>

  <!-- ════════════ CONTACTO ════════════ -->
  <section class="py-24 px-6 md:px-12 bg-white" id="contacto">
    <div class="max-w-xl mx-auto reveal">

      <div class="bg-white p-8 md:p-12 rounded-3xl shadow-apple border border-primary/5">
        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-700 text-xs font-medium px-4 py-2 rounded-full mb-5">
            <span class="w-1.5 h-1.5 bg-amber-500 rounded-full animate-pulse"></span>
            Cupos limitados por mes
          </div>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mb-2">¿Tu marca califica?</h2>
          <p class="text-sm text-primary/50">Completá el formulario. Si tu negocio califica, te contactamos en menos de 24 hs.</p>
        </div>

        <div id="form-success" class="hidden mb-8 p-6 bg-green-50 border border-green-200 rounded-2xl text-center">
          <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="material-symbols-outlined text-2xl text-green-600">check_circle</span>
          </div>
          <p class="text-green-800 font-bold text-lg">¡Solicitud enviada!</p>
          <p class="text-green-600 text-sm mt-1">Revisamos tu perfil y te escribimos por WhatsApp en las próximas 24 hs.</p>
        </div>

        <form id="lp-form" class="space-y-8">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="relative group">
              <input class="peer w-full border-0 border-b border-gray-200 bg-transparent py-3 px-1 text-sm text-primary placeholder-transparent focus:border-primary focus:ring-0 transition-colors" id="lp-nombre" name="nombre" placeholder="Nombre" type="text" required />
              <label class="absolute left-1 -top-3.5 text-xs text-primary/40 transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-base peer-placeholder-shown:text-primary/40 peer-focus:-top-3.5 peer-focus:text-xs peer-focus:text-primary pointer-events-none" for="lp-nombre">Nombre</label>
            </div>
            <div class="relative group">
              <input class="peer w-full border-0 border-b border-gray-200 bg-transparent py-3 px-1 text-sm text-primary placeholder-transparent focus:border-primary focus:ring-0 transition-colors" id="lp-marca" name="marca" placeholder="Marca" type="text" required />
