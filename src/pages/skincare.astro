---
import Layout from '../layouts/Layout.astro';

const testimonials = [
  {
    cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-skirting.webp',
    video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/manuel-descartes.mp4',
    before: 'Aumentó sus ventas un', highlight: '+300%', after: 'en el primer mes',
  },
  {
    cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-jack.webp',
    video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/puertas-jack.mp4',
    before: 'Multiplicó sus ventas', highlight: '×10', after: 'en 6 meses',
  },
  {
    cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-libreria-leo.webp',
    video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/libreria-leo.mp4',
    before: 'Pasó de 2 pedidos por semana a', highlight: 'USD 150K al año', after: '',
  },
  {
    cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-atermicos.webp',
    video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/atermicos-pinamar.mp4',
    before: 'Consiguió', highlight: '+200% en ventas', after: 'en solo 2 meses',
  },
  {
    cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-rocio.webp',
    video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/psicologa-rocio.mp4',
    before: 'Aumentó su clientela un', highlight: '+400%', after: 'en 1 mes',
  },
  {
    cover: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-case-rossi.webp',
    video: 'https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/case-rossi.mp4',
    before: 'Duplicó su facturación:', highlight: '+100%', after: 'en 1 mes',
  },
];
---

<Layout
  title="Más ventas para marcas de cosmética — Algoritmia"
  description="Publicidad, email marketing y atención con IA para aumentar las ventas de tu marca de cosmética."
  noindex={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://czocbnyoenjbpxmcqobn.supabase.co" crossorigin />
    <link rel="dns-prefetch" href="https://czocbnyoenjbpxmcqobn.supabase.co" />
  </Fragment>
  <main>
    <section class="hero-section" aria-labelledby="page-title">
      <div id="inicio" class="hero-copy">
        <p class="eyebrow"><span></span> Publicidad + Email marketing + Atención con IA</p>
        <h1 id="page-title"><span class="subtle-underline">Más ventas</span> para tu marca de <span class="subtle-underline">cosmética</span>.</h1>
        <p class="hero-subtitle">Mirá el video de abajo: te explicamos cómo trabajamos con el Sistema C.A.R para hacer crecer tu negocio. 👇</p>
      </div>

      <div class="vsl-wrap">
        <div class="vsl-frame">
          <video
            id="vsl-video"
            class="vsl-video"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            data-full-src="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/skincare/vsl-final-1080p.mp4"
            poster="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/skincare/vsl-poster-1280-v2.jpg"
            aria-label="Presentación del sistema de crecimiento para marcas de cosmética"
          >
            <source src="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/skincare/vsl-teaser-5s-720p.mp4" type="video/mp4" />
            Tu navegador no soporta la reproducción de video.
          </video>
          <button id="vsl-unmute" class="vsl-unmute" type="button" aria-label="Ver video completo con sonido">
            <span class="vsl-unmute-pill">
              <span class="vsl-unmute-icon material-symbols-outlined">volume_up</span>
              <strong>Activar sonido</strong>
            </span>
          </button>
        </div>
        <a class="video-cta" href="#formulario">Quiero aumentar mis ventas <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="form-section" id="formulario" aria-labelledby="form-title">
      <div class="form-heading">
        <p class="eyebrow"><span></span> Cupos limitados por mes</p>
        <h2 id="form-title">¿Tu marca califica?</h2>
        <p>Completá el formulario. Si calificás, te contactamos en menos de 24 horas.</p>
      </div>

      <div class="form-embed-card">
        <iframe
          src="https://link.1prompt.com/widget/survey/QRU7dBIDhhv78Ir66Mv9"
          class="survey-embed"
          style="border:none;width:100%;"
          scrolling="no"
          id="QRU7dBIDhhv78Ir66Mv9"
          title="Formulario de aplicación"
          loading="lazy"
        ></iframe>
      </div>
      <script is:inline src="https://link.1prompt.com/js/form_embed.js"></script>
      <script is:inline>
        (() => {
          const iframe = document.getElementById('QRU7dBIDhhv78Ir66Mv9');
          if (!(iframe instanceof HTMLIFrameElement)) return;

          const formOrigin = new URL(iframe.src).origin;
          const qualifiedRedirectUrl = 'https://sistema.car.fluyent.cc/thank-you';

          window.addEventListener('message', (event) => {
            if (event.origin !== formOrigin || event.source !== iframe.contentWindow) return;
            if (!Array.isArray(event.data) || event.data[0] !== 'set-sticky-contacts') return;

            window.location.assign(qualifiedRedirectUrl);
          });

          const compactHeight = () => {
            const reportedHeight = Number.parseFloat(iframe.style.height);
            const lastApplied = Number.parseFloat(iframe.dataset.compactHeight || '');
            if (!Number.isFinite(reportedHeight) || Math.abs(reportedHeight - lastApplied) < 1) return;

            const isMobile = window.matchMedia('(max-width: 640px)').matches;
            const minimumHeight = isMobile ? 520 : 430;
            const verticalTrim = isMobile ? 65 : 95;
            const nextHeight = Math.max(minimumHeight, reportedHeight - verticalTrim);
            iframe.dataset.compactHeight = String(nextHeight);
            iframe.style.height = `${nextHeight}px`;
          };

          new MutationObserver(compactHeight).observe(iframe, { attributes: true, attributeFilter: ['style'] });
          window.addEventListener('resize', compactHeight, { passive: true });
          compactHeight();
        })();
      </script>
    </section>

    <section class="testimonials-section" aria-labelledby="testimonials-title">
      <div class="testimonials-heading">
        <p class="eyebrow"><span></span> Resultados reales</p>
        <h2 id="testimonials-title">Historias de crecimiento</h2>
      </div>
      <div class="carousel-controls" aria-label="Controles del carrusel">
        <button id="testimonials-prev" type="button" aria-label="Testimonio anterior"><span class="material-symbols-outlined">arrow_back</span></button>
        <button id="testimonials-next" type="button" aria-label="Testimonio siguiente"><span class="material-symbols-outlined">arrow_forward</span></button>
      </div>
      <div class="marquee" aria-label="Testimonios de clientes">
        <div class="marquee-track">
          {[...testimonials, ...testimonials, ...testimonials].map((testimonial, index) => (
            <article class="testimonial-card" aria-hidden={index < testimonials.length || index >= testimonials.length * 2 ? 'true' : undefined}>
              <div class="testimonial-video">
                <img class="video-cover" src={testimonial.cover} alt="" loading="lazy" decoding="async" />
                <video class="testimonial-player hidden" preload="none" playsinline data-src={testimonial.video}></video>
                <button class="video-overlay" type="button" aria-label="Reproducir testimonio">
                  <span class="material-symbols-outlined">play_arrow</span>
                </button>
              </div>
              <p class="testimonial-result">
                <span>{testimonial.before}</span>{' '}<strong>{testimonial.highlight}</strong>{testimonial.after && <>{' '}<span>{testimonial.after}</span></>}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #fffaf8; }
  main { min-height: 100vh; overflow: hidden; color: #191518; background: #fffaf8; }
  .hero-section { min-height: 100vh; box-sizing: border-box; padding: 28px 24px 88px; position: relative; background: radial-gradient(circle at 50% 8%, rgba(255,204,214,.45), transparent 34%), linear-gradient(180deg, #fffaf8 0%, #fff 100%); }
  .hero-copy { max-width: 920px; margin: 48px auto 38px; text-align: center; }
  .hero-copy h1 { max-width: 920px; margin: 0 auto; font-size: clamp(44px, 6.4vw, 82px); line-height: .98; letter-spacing: -.065em; font-weight: 750; text-wrap: balance; }
  .subtle-underline { padding-bottom: .01em; background-image: linear-gradient(transparent 86%, rgba(244,63,94,.66) 86%, rgba(244,63,94,.66) 89%, transparent 89%); background-repeat: no-repeat; }
  .hero-subtitle { max-width: 690px; margin: 25px auto 0; color: #746c70; font-size: clamp(16px, 2vw, 20px); line-height: 1.55; text-wrap: balance; }
  .vsl-wrap { max-width: 960px; margin: 0 auto; text-align: center; }
  .vsl-frame { position: relative; padding: 7px; border: 1px solid rgba(24,19,22,.1); border-radius: 27px; background: rgba(255,255,255,.72); box-shadow: 0 30px 90px rgba(65,26,40,.13); }
  .vsl-video { width: 100%; aspect-ratio: 16 / 9; border-radius: 21px; display: block; object-fit: contain; background: #090708; }
  .vsl-unmute { position: absolute; inset: 7px; z-index: 2; padding: 0; border: 0; border-radius: 21px; color: white; background: transparent; cursor: pointer; font: inherit; }
  .vsl-unmute-pill { position: absolute; left: 50%; bottom: 15px; min-height: 44px; padding: 6px 16px 6px 7px; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; display: inline-flex; align-items: center; gap: 9px; background: rgba(16,12,14,.82); backdrop-filter: blur(12px); box-shadow: 0 10px 28px rgba(0,0,0,.28); transform: translateX(-50%); white-space: nowrap; transition: transform .2s ease, background .2s ease; }
  .vsl-unmute:hover .vsl-unmute-pill { background: rgba(16,12,14,.94); transform: translate(-50%, -2px); }
  .vsl-unmute-icon { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; color: #171315; background: white; font-size: 18px; }
  .vsl-unmute strong { font-size: 12px; letter-spacing: .01em; }
  .video-cta { min-height: 54px; margin: 24px auto 0; padding: 0 28px; width: fit-content; display: inline-flex; align-items: center; gap: 13px; border-radius: 999px; color: white; background: #f43f5e; text-decoration: none; font-size: 14px; font-weight: 800; box-shadow: 0 12px 32px rgba(244,63,94,.28); transition: transform .2s ease, box-shadow .2s ease; }
  .video-cta:hover { transform: translateY(-2px); box-shadow: 0 16px 38px rgba(244,63,94,.36); }
  .form-section { min-height: 100vh; box-sizing: border-box; padding: 100px 22px 110px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 0%, rgba(255,198,212,.32), transparent 35%); }
  .form-heading { max-width: 630px; margin-bottom: 34px; text-align: center; }
  .eyebrow { margin: 0 0 16px; display: flex; align-items: center; justify-content: center; gap: 9px; color: #e62d58; font-size: 11px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 5px rgba(230,45,88,.1); }
  .form-heading h2 { margin: 0; font-size: clamp(42px, 6vw, 66px); line-height: .98; letter-spacing: -.06em; font-weight: 760; }
  .form-heading > p:last-child { margin: 20px auto 0; max-width: 510px; color: #766d72; font-size: 16px; line-height: 1.55; }
  .form-embed-card { width: 100%; max-width: 720px; box-sizing: border-box; padding: 12px; overflow: hidden; border: 1px solid rgba(35,23,29,.08); border-radius: 28px; background: white; box-shadow: 0 28px 80px rgba(74,31,48,.13); }
  .survey-embed { width: 100%; height: 510px; display: block; }
  .hidden { display: none !important; }

  .testimonials-section { padding: 100px 0 86px; color: white; background: #171315; }
  .testimonials-heading { margin: 0 auto 44px; padding: 0 22px; text-align: center; }
  .testimonials-heading .eyebrow { color: #ff6d8c; }
  .testimonials-heading h2 { margin: 0; font-size: clamp(36px, 5vw, 58px); line-height: 1; letter-spacing: -.055em; font-weight: 750; }
  .carousel-controls { margin: -23px auto 18px; padding: 0 24px; display: flex; justify-content: flex-end; gap: 9px; max-width: 1240px; box-sizing: border-box; }
  .carousel-controls button { width: 42px; height: 42px; padding: 0; border: 1px solid rgba(255,255,255,.16); border-radius: 50%; display: grid; place-items: center; color: white; background: rgba(255,255,255,.07); cursor: pointer; transition: background .2s ease, transform .2s ease; }
  .carousel-controls button:hover { background: rgba(255,255,255,.15); transform: translateY(-1px); }
  .carousel-controls span { font-size: 19px; }
  .marquee { width: 100%; padding: 8px 0 30px; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; scroll-snap-type: x mandatory; overscroll-behavior-inline: contain; -webkit-overflow-scrolling: touch; mask-image: linear-gradient(90deg, transparent, black 7%, black 93%, transparent); }
  .marquee::-webkit-scrollbar { display: none; }
  .marquee-track { width: max-content; display: flex; }
  .testimonial-card { width: min(410px, 80vw); margin: 0 9px; flex: 0 0 auto; overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 22px; background: #241d21; scroll-snap-align: center; }
  .testimonial-video { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #090708; }
  .video-cover, .testimonial-player { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .testimonial-player { z-index: 1; background: #000; }
  .video-overlay { position: absolute; inset: 0; z-index: 2; padding: 0; border: 0; display: grid; place-items: center; color: #191518; background: rgba(0,0,0,.18); cursor: pointer; transition: background .2s ease; }
  .video-overlay:hover { background: rgba(0,0,0,.08); }
  .video-overlay span { width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: white; box-shadow: 0 10px 32px rgba(0,0,0,.28); font-size: 32px; transition: transform .2s ease; }
  .video-overlay:hover span { transform: scale(1.08); }
  .testimonial-result { min-height: 94px; box-sizing: border-box; margin: 0; padding: 20px 22px; color: rgba(255,255,255,.8); font-size: 15px; font-weight: 650; line-height: 1.45; }
  .testimonial-result strong { display: inline; margin-inline: .2em; color: #ff7894; font-size: 1.18em; font-weight: 900; letter-spacing: -.02em; text-shadow: 0 0 24px rgba(255,120,148,.25); }
  @media (max-width: 640px) {
    .hero-section { min-height: auto; padding: 22px 18px 70px; }
    .hero-copy { margin: 34px auto 30px; }
    .hero-copy h1 { font-size: clamp(42px, 13vw, 62px); }
    .hero-subtitle { font-size: 16px; }
    .vsl-frame { padding: 5px; border-radius: 20px; }
    .vsl-video { border-radius: 15px; }
    .vsl-unmute { inset: 5px; border-radius: 15px; }
    .vsl-unmute-pill { bottom: 8px; min-height: 39px; padding: 5px 13px 5px 6px; gap: 7px; }
    .vsl-unmute-icon { width: 29px; height: 29px; font-size: 17px; }
    .vsl-unmute strong { font-size: 11px; }
    .form-section { min-height: 100svh; padding: 52px 16px 70px; justify-content: flex-start; }
    .form-heading { margin-bottom: 27px; }
    .form-heading h2 { font-size: 46px; }
    .form-heading > p:last-child { font-size: 14px; }
    .form-embed-card { padding: 6px; border-radius: 22px; }
    .survey-embed { height: 600px; }
    .testimonials-section { padding: 76px 0 64px; }
    .carousel-controls { margin: -20px auto 14px; padding: 0 18px; }
    .marquee { mask-image: linear-gradient(90deg, transparent, black 3%, black 97%, transparent); }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const vsl = document.getElementById('vsl-video') as HTMLVideoElement | null;
    const vslUnmute = document.getElementById('vsl-unmute') as HTMLButtonElement | null;
    if (vsl && vslUnmute && vsl.dataset.initialized !== 'true') {
      vsl.dataset.initialized = 'true';
      let teaserMode = true;

      const playMutedTeaser = () => {
        if (!teaserMode) return;
        vsl.muted = true;
        vsl.loop = true;
        vsl.controls = false;
        vsl.play().catch(() => {});
      };

      vsl.addEventListener('loadedmetadata', playMutedTeaser);

      vslUnmute.addEventListener('click', async () => {
        teaserMode = false;
        vsl.pause();
        vsl.loop = false;
        vsl.muted = true;
        vsl.controls = true;
        vsl.preload = 'auto';
        vslUnmute.classList.add('hidden');
        const fullSrc = vsl.dataset.fullSrc;
        if (fullSrc && vsl.currentSrc !== fullSrc) {
          vsl.src = fullSrc;
          vsl.load();
        }
        try {
          await vsl.play();
          vsl.muted = false;
        } catch {
          vslUnmute.classList.remove('hidden');
          vsl.controls = true;
        }
      });

      playMutedTeaser();
    }

    const marquee = document.querySelector<HTMLElement>('.marquee');
    const marqueeTrack = document.querySelector<HTMLElement>('.marquee-track');
    if (marquee && marqueeTrack && marquee.dataset.manualReady !== 'true') {
      marquee.dataset.manualReady = 'true';
      let setWidth = 0;
      let normalizeTimer: number | undefined;

      const centerCarousel = () => {
        setWidth = marqueeTrack.scrollWidth / 3;
        marquee.scrollLeft = setWidth;
      };

      requestAnimationFrame(centerCarousel);
      window.addEventListener('resize', centerCarousel);
      marquee.addEventListener('scroll', () => {
        if (!setWidth) return;
        window.clearTimeout(normalizeTimer);
        normalizeTimer = window.setTimeout(() => {
          if (marquee.scrollLeft < setWidth) marquee.scrollLeft += setWidth;
          else if (marquee.scrollLeft >= setWidth * 2) marquee.scrollLeft -= setWidth;
        }, 90);
      }, { passive: true });

      const moveCarousel = (direction: number) => {
        const card = marqueeTrack.querySelector<HTMLElement>('.testimonial-card');
        if (!card) return;
        marquee.scrollBy({ left: direction * (card.offsetWidth + 18), behavior: 'smooth' });
      };

      document.getElementById('testimonials-prev')?.addEventListener('click', () => moveCarousel(-1));
      document.getElementById('testimonials-next')?.addEventListener('click', () => moveCarousel(1));
    }

    const syncCarouselWithVideos = () => {
      const isAnyVideoPlaying = Array.from(document.querySelectorAll<HTMLVideoElement>('.testimonial-player'))
        .some(player => !player.paused && !player.ended);
      marquee?.classList.toggle('is-video-playing', isAnyVideoPlaying);
    };

    document.querySelectorAll<HTMLElement>('.testimonial-card').forEach(card => {
      const video = card.querySelector<HTMLVideoElement>('.testimonial-player');
      const cover = card.querySelector<HTMLImageElement>('.video-cover');
      const overlay = card.querySelector<HTMLButtonElement>('.video-overlay');
      if (!video || !cover || !overlay || video.dataset.ready === 'true') return;
      video.dataset.ready = 'true';

      overlay.addEventListener('click', async () => {
        document.querySelectorAll<HTMLVideoElement>('.testimonial-player').forEach(other => {
          if (other !== video && !other.paused) other.pause();
        });
        cover.classList.add('hidden');
        video.classList.remove('hidden');
        video.controls = true;
        overlay.classList.add('hidden');
        if (!video.src && video.dataset.src) {
          video.src = video.dataset.src;
          video.load();
        }
        try { await video.play(); } catch { overlay.classList.remove('hidden'); }
      });

      video.addEventListener('play', () => {
        overlay.classList.add('hidden');
        syncCarouselWithVideos();
      });
      video.addEventListener('pause', () => {
        if (!video.ended) overlay.classList.remove('hidden');
        syncCarouselWithVideos();
      });
      video.addEventListener('ended', () => {
        video.controls = false;
        video.classList.add('hidden');
        cover.classList.remove('hidden');
        overlay.classList.remove('hidden');
        video.currentTime = 0;
        syncCarouselWithVideos();
      });
    });
  });
</script>
