	.floating-cube {
		animation: floatCube 4s ease-in-out infinite alternate;
	}

	.rotating-ring {
		transform-origin: center;
		animation: spinRing 12s linear infinite;
	}

	.rotating-ring-reverse {
		transform-origin: center;
		animation: spinRingReverse 16s linear infinite;
	}

