	.member-avatar {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		overflow: hidden;
		background: #F0EDF3;
		margin-bottom: 16px;
	}

	.member-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.team-card-member h4 {
		font-size: 15px;
		font-weight: bold;
		margin: 0 0 4px;
	}

	.member-role {
		font-size: 12px;
		color: var(--text-grey);
	}

	.team-story {
		max-width: 760px;
		margin: 0 auto;
		text-align: left;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.team-story p {
		font-size: 15px;
		line-height: 1.6;
		color: var(--text-grey);
		margin: 0;
	}

	/* ==========================================
	   TESTIMONIALS SECTION
	   ========================================== */
	.testimonials-section {
		padding: 100px 20px;
		max-width: 1200px;
		margin: 0 auto;
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 20px;
		margin-top: 50px;
	}

	@media (min-width: 768px) {
		.testimonials-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.testimonials-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.testimonial-card {
		background: #FFF;
		border: 1px solid var(--border-color);
		border-radius: 20px;
		padding: 24px;
		box-shadow: 0 4px 20px rgba(0,0,0,0.01);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.testimonial-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 16px;
	}

	.testimonial-header h4 {
		font-size: 15px;
		font-weight: 700;
		margin: 0;
	}

	.testimonial-header small {
		font-size: 11px;
