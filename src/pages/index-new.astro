		0% { transform: translateY(0px); }
		100% { transform: translateY(-12px); }
	}

	@keyframes spinRing {
		0% { transform: rotate(0deg); }
		100% { transform: rotate(360deg); }
	}

	@keyframes spinRingReverse {
		0% { transform: rotate(0deg); }
		100% { transform: rotate(-360deg); }
	}

	@keyframes pulseGlow {
		0% { opacity: 0.6; transform: scale(0.95); }
		100% { opacity: 1; transform: scale(1.05); }
