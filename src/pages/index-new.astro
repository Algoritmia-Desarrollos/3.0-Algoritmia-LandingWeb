	}

	.stars {
		color: #ffbd2e;
		font-size: 12px;
	}

	.testimonial-text {
		font-size: 14px;
		line-height: 1.5;
		color: var(--text-dark);
		margin: 0;
		font-style: italic;
	}

	/* ==========================================
	   PRICING SECTION
	   ========================================== */
	.pricing-section {
		padding: 100px 20px;
		background: #FFF;
	}

	/* Opción sin suscripción: pago por imagen + galería */
	.pay-per-use {
		max-width: 1000px;
		margin: 36px auto 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		padding: 28px 32px;
		border: 1px solid var(--border-color);
		border-radius: 24px;
		background: var(--bg-light);
	}

	.ppu-tag {
		display: inline-block;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: rgb(236, 68, 146);
		margin-bottom: 10px;
	}

	.ppu-text h3 {
		font-size: clamp(18px, 2.4vw, 22px);
		font-weight: 700;
		color: var(--text-dark);
		margin: 0 0 8px;
		letter-spacing: -0.01em;
	}

	.ppu-text p {
		font-size: 15px;
		line-height: 1.55;
		color: var(--text-grey);
		margin: 0;
		max-width: 62ch;
	}

	.ppu-cta {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 52px;
		padding: 0 26px;
		border-radius: 26px;
		background: var(--holo-gradient);
		color: #FFF;
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 6px 18px rgba(236, 68, 146, 0.22);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.ppu-cta:hover {
		transform: scale(1.03);
		box-shadow: 0 10px 26px rgba(236, 68, 146, 0.32);
	}

	@media (max-width: 700px) {
		.pay-per-use {
			flex-direction: column;
			align-items: flex-start;
			padding: 24px;
		}
		.ppu-cta {
			width: 100%;
			justify-content: center;
		}
	}

	.plans-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 24px;
		max-width: 1200px;
		margin: 60px auto 0;
		align-items: stretch;
	}

	@media (min-width: 768px) {
		.plans-grid {
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		}
	}

	@media (min-width: 1100px) {
		.plans-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.plan-card {
		background: #FFF;
		border: 1px solid var(--border-color);
		border-radius: 32px;
		padding: 40px 32px;
		position: relative;
		display: flex;
		flex-direction: column;
		box-shadow: 0 10px 30px rgba(0,0,0,0.02);
		transition: transform 0.2s, box-shadow 0.2s;
	}

	.plan-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-hover);
	}

	.plan-card.featured {
		border: 2px solid rgb(236, 68, 146);
		box-shadow: 0 20px 45px -10px rgba(236, 68, 146, 0.15);
	}

	.featured-badge {
		position: absolute;
		top: -12px;
		left: 50%;
		transform: translateX(-50%);
		background: linear-gradient(104deg, rgb(62, 134, 198) 0%, rgb(166, 102, 170) 22%, rgb(236, 68, 146) 50%, rgb(238, 68, 84) 76%, rgb(240, 84, 39) 100%);
		color: #FFF;
		font-size: 10px;
		font-weight: 800;
		padding: 4px 12px;
		border-radius: 99px;
		letter-spacing: 0.05em;
	}

	.plan-card h3 {
		font-size: 24px;
		font-weight: 800;
		margin: 0 0 10px;
	}

	.plan-desc {
		font-size: 13px;
		color: var(--text-grey);
		line-height: 1.5;
		margin: 0 0 30px;
		min-height: 40px;
	}

	.plan-price {
		display: flex;
		align-items: flex-end;
		gap: 6px;
		margin-bottom: 20px;
	}

	.plan-price .currency {
		font-size: 14px;
		font-weight: bold;
		color: var(--text-grey);
		margin-bottom: 8px;
	}

	.plan-price .amount {
		font-size: 54px;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.plan-price .period {
		font-size: 14px;
		color: var(--text-grey);
		margin-bottom: 8px;
	}

	.plan-credits {
		display: block;
		font-size: 16px;
		font-weight: 700;
		margin-bottom: 24px;
	}

	.plan-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 52px;
		padding: 0 24px;
		border-radius: 26px;
		background: var(--text-dark);
		color: #FFF;
		font-weight: bold;
		text-decoration: none;
		font-size: 14px;
		margin-bottom: 30px;
		transition: opacity 0.2s;
	}

	.plan-card.featured .plan-cta {
		background: linear-gradient(104deg, rgb(62, 134, 198) 0%, rgb(166, 102, 170) 22%, rgb(236, 68, 146) 50%, rgb(238, 68, 84) 76%, rgb(240, 84, 39) 100%);
	}

	.plan-cta:hover {
		opacity: 0.95;
	}

	.plan-features {
		list-style: none;
		padding: 24px 0 0;
		margin: 0;
		border-top: 1px solid var(--border-color);
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.plan-features li {
		font-size: 13px;
		font-weight: 500;
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--text-dark);
	}

	.plan-features li i {
		width: 18px;
		height: 18px;
		background: #F0EDF3;
		color: #744bde;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 9px;
		font-style: normal;
		font-weight: bold;
	}

	/* ==========================================
	   FAQ SECTION
	   ========================================== */
	.faq-section {
		padding: 100px 20px;
		max-width: 800px;
		margin: 0 auto;
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin-top: 50px;
	}

	.faq-item {
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 16px;
	}

	.faq-question {
		font-size: 17px;
		font-weight: 700;
		padding: 16px 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		cursor: pointer;
		user-select: none;
		list-style: none;
	}

	.faq-question::-webkit-details-marker {
		display: none;
	}

	.faq-toggle-icon {
		width: 32px;
		height: 32px;
		background: #FAF9FB;
		border: 1px solid var(--border-color);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 16px;
		font-weight: bold;
		color: #744bde;
		transition: transform 0.2s;
	}

	.faq-item[open] .faq-toggle-icon {
		transform: rotate(45deg);
	}

	.faq-answer {
		padding: 0 0 16px;
		font-size: 15px;
		line-height: 1.6;
		color: var(--text-grey);
	}

	/* ==========================================
	   FINAL CTA SECTION
	   ========================================== */
	.final-cta-section {
		margin: 80px 20px 100px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 16px;
		background: #FFF;
	}

	.final-cta-section h2 {
		font-size: clamp(28px, 4vw, 42px);
		font-weight: 700;
		color: #1D1D1F;
		margin: 0;
		letter-spacing: -0.02em;
	}

	.final-cta-sub {
		font-size: 20px;
		color: #6E6E73;
		font-weight: 450;
		margin: 0 0 10px;
	}

	.final-cta-button {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 48px;
		padding: 0 24px;
		background-image: linear-gradient(104deg, rgb(62, 134, 198) 0%, rgb(166, 102, 170) 22%, rgb(236, 68, 146) 50%, rgb(238, 68, 84) 76%, rgb(240, 84, 39) 100%);
		color: #FFF;
		font-weight: 700;
		text-decoration: none;
		border-radius: 99px;
		font-size: 15px;
		position: relative;
		overflow: hidden;
		transition: transform 0.2s ease;
	}

	.final-cta-button:hover {
		transform: scale(1.05);
	}

	.inset-shadow-overlay {
		position: absolute;
		inset: 0;
		border-radius: 99px;
		box-shadow: inset 0 0 12px 2px rgba(255,255,255,0.6);
		pointer-events: none;
	}

	.final-cta-mascot {
		position: absolute;
		right: 40px;
		bottom: -50px;
		width: 140px;
		opacity: 0.15;
		pointer-events: none;
	}

	@media (min-width: 810px) {
		.final-cta-mascot {
			opacity: 0.85;
			bottom: -30px;
			width: 180px;
		}
	}

	.final-cta-mascot img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/* ==========================================
	   FOOTER
	   ========================================== */
	.main-footer {
		background: #FFF;
		padding: 80px 20px 40px;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 40px;
		max-width: 1100px;
		margin: 0 auto;
	}

	.footer-brand {
		grid-column: 1 / -1;
		text-align: left;
	}

	@media (min-width: 768px) {
		.main-footer {
			grid-template-columns: 1.5fr repeat(3, 1fr);
		}
		.footer-brand {
			grid-column: span 1;
		}
	}

	.footer-logo {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		color: var(--text-dark);
		margin-bottom: 20px;
	}

	.footer-logo img {
		width: 32px;
		height: 32px;
		object-fit: cover;
		border-radius: 50%;
	}

	.footer-logo strong {
		font-size: 20px;
		font-weight: 800;
	}

	.footer-brand p {
		font-size: 13px;
		color: var(--text-grey);
		line-height: 1.5;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 12px;
		text-align: left;
	}

	.footer-col h4 {
		font-size: 14px;
		font-weight: bold;
		margin: 0 0 8px;
		color: var(--text-grey);
	}

	.footer-col a {
		font-size: 13px;
		color: var(--text-dark);
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-col a:hover {
		color: #744bde;
	}

	.footer-bottom {
		grid-column: 1 / -1;
		border-top: 1px solid var(--border-color);
		padding-top: 30px;
		text-align: center;
		font-size: 12px;
		color: var(--text-grey);
	}

	/* ==========================================
	   PRODUCT WALKTHROUGH VIDEO
	   ========================================== */
	.walkthrough-video-section {
		background: #FFF;
		padding: 40px 20px 80px;
		display: flex;
		justify-content: center;
	}

	.walkthrough-video-wrapper {
		width: 100%;
		max-width: 960px;
		margin: 0 auto;
	}

	.walkthrough-video-container {
		position: relative;
		aspect-ratio: 16/9;
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 0 0 6px white, 0 15px 40px 0 rgba(173, 181, 190, 0.5);
		background: #000;
	}

	.walkthrough-video-container video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

/* Performance Optimizations: content-visibility for off-screen sections */
.manifesto-section,
.walkthrough-video-section,
