---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/ads/HeaderAds.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import adsResults from '../../assets/clients/clinically/CLINICALLY ADS RESULTADOS FRIOS.png';

const title = "Clinically - Caso de Éxito | Algoritmia";
const description = "Cómo lanzamos Clinically desde cero y logramos 10-20 pacientes diarios en 3 meses.";
---

<Layout title={title} description={description}>
  <Header />
  
  <main class="bg-white text-black selection:bg-gray-200">
    <!-- Hero Section -->
    <section class="relative pt-32 md:pt-48 pb-20 px-6 md:px-12 overflow-hidden">
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col lg:flex-row gap-10 lg:gap-12 items-center">
          <div class="flex-1 space-y-8 w-full">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 bg-gray-50">
              <span class="w-2 h-2 rounded-full bg-green-500"></span>
              <span class="text-xs font-medium text-gray-600 uppercase tracking-wide">Caso de Éxito</span>
            </div>
            
            <h1 class="text-4xl md:text-6xl lg:text-5xl font-bold tracking-tight leading-tight text-black mb-8">
              De 0 a 20 pacientes diarios y agenda completa en 90 días.
            </h1>
            
            <p class="text-xl text-gray-500 max-w-xl leading-relaxed">
              Construimos una clínica estética desde cero con flujo constante de pacientes.
            </p>
            
            <!-- Buttons for Desktop -->
            <div class="hidden lg:flex flex-col lg:flex-row gap-4 items-start lg:items-center">
              <a href="https://clinicallyestetica.com.ar/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-black text-white font-medium hover:bg-gray-800 transition-colors">
                Ver sitio web
                <span class="material-symbols-outlined text-[18px]">arrow_outward</span>
              </a>

              <div class="flex items-center gap-3 px-4 py-2 rounded-full bg-gray-50 border border-gray-100">
                <span class="text-green-600 font-bold">10-20</span>
                <span class="text-sm text-gray-600 font-medium">Pacientes/día</span>
              </div>
            </div>
          </div>
          
          <div class="flex-1 w-full space-y-6">
            <div class="relative aspect-[4/3] rounded-3xl overflow-hidden border border-gray-100 bg-black shadow-2xl shadow-gray-200/50 group">
              <!-- Testimonial Video -->
              <video 
                id="hero-testimonial-video"
                class="w-full h-full object-contain"
                controls
                poster=""
              >
                <source src="https://res.cloudinary.com/dfixkx6yi/video/upload/v1769626335/clinically_medicinaestetica_1724511115_3441763933075753507_48672420330_li7a3b.mp4" type="video/mp4">
                Tu navegador no soporta videos HTML5.
              </video>
            </div>
            
            <!-- Buttons for Mobile -->
            <div class="flex lg:hidden flex-col gap-4 items-start">
              <a href="https://clinicallyestetica.com.ar/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-black text-white font-medium hover:bg-gray-800 transition-colors">
                Ver sitio web
                <span class="material-symbols-outlined text-[18px]">arrow_outward</span>
              </a>

              <div class="flex items-center gap-3 px-4 py-2 rounded-full bg-gray-50 border border-gray-100">
                <span class="text-green-600 font-bold">10-20</span>
                <span class="text-sm text-gray-600 font-medium">Pacientes/día</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Challenge Section -->
    <section class="py-24 px-6 md:px-12 bg-gray-50 relative">
      <div class="max-w-4xl mx-auto text-center space-y-8">
        <blockquote class="text-2xl md:text-4xl font-medium text-black leading-tight max-w-5xl mx-auto">
          "Abrimos una nueva clínica y nadie nos conoce. Necesitamos llenar la agenda de turnos desde cero."
        </blockquote>
        <p class="text-gray-400 mt-6 font-medium">— El Problema Inicial</p>
      </div>
    </section>



    <!-- Results Section -->
    <section class="py-32 px-6 md:px-12 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div class="space-y-8">
            <h2 class="text-3xl md:text-5xl font-bold text-black">Resultados Reales</h2>
            <p class="text-gray-500 text-lg">
              Los números no mienten.
            </p>
            
            <div class="space-y-6">
              <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-sm">
                <p class="text-xs text-gray-400 uppercase mb-2 tracking-wider">Inicio</p>
                <div class="flex items-end gap-4">
                  <span class="text-4xl font-bold text-gray-300">1-2</span>
                  <span class="text-sm text-gray-400 mb-2">Pacientes/día</span>
                </div>
                <p class="text-gray-400 text-sm mt-2">Marca nueva, sin reconocimiento</p>
              </div>
              
              <div class="p-6 rounded-2xl bg-white border border-black shadow-lg">
                <p class="text-xs text-black uppercase mb-2 font-bold tracking-wider">Mes 3</p>
                <div class="flex items-end gap-4">
                  <span class="text-5xl font-bold text-black">10-20</span>
                  <span class="text-sm text-gray-500 mb-2">Pacientes/día</span>
                </div>
                <p class="text-green-600 font-medium mt-2 text-sm flex items-center gap-1">
                  <span class="material-symbols-outlined text-[18px]">trending_up</span>
                  Agenda completa
                </p>
              </div>
            </div>
            
            <div class="p-6 rounded-2xl bg-gradient-to-br from-green-50 to-green-100 border border-green-200">
              <p class="text-xs text-green-700 uppercase mb-2 font-bold tracking-wider">Reconocimiento</p>
              <p class="text-green-900 font-medium text-lg">
                Hoy mucha gente conoce y elige Clinically por su reputación y presencia digital.
              </p>
            </div>
          </div>
          
          <!-- Results Images -->
          <div class="flex flex-col gap-6 w-full">
            <div class="rounded-3xl overflow-hidden border border-gray-200 shadow-xl shadow-gray-200/50">
              <Image 
                src={adsResults} 
                alt="Resultados Ads Clinically" 
                class="w-full h-auto object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 text-center bg-black text-white">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-4xl font-bold mb-6">¿Listo para escalar?</h2>
        <p class="text-white/60 text-lg mb-10">
          Llevamos tu negocio al siguiente nivel.
        </p>
        <a href="/#contact" class="inline-flex items-center gap-2 bg-white text-black px-6 py-3 rounded-full font-medium text-sm hover:bg-gray-200 transition-colors shadow-lg hover:shadow-xl">
          Solicitar Consultoría
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
