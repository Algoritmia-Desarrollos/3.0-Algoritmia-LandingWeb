---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/ads/HeaderAds.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import yearEndResults from '../../assets/clients/atermicos-pinamar/Resultados Atermicos Fin de año.png';

const title = "Atermicos Pinamar - Caso de Éxito | Algoritmia";
const description = "Expansión geográfica y generación de leads High-Ticket mediante publicidad digital.";
---
<Layout title={title} description={description}>
  <Header />
  
  <main class="bg-white text-black selection:bg-gray-200">
    <section class="relative pt-32 md:pt-48 pb-20 px-6 md:px-12 overflow-hidden">
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col lg:flex-row gap-10 lg:gap-12 items-center">
          <div class="flex-1 space-y-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 bg-gray-50">
              <span class="w-2 h-2 rounded-full bg-green-500"></span>
              <span class="text-xs font-medium text-gray-600 uppercase tracking-wide">Caso de Éxito</span>
            </div>
            
            <h1 class="text-3xl md:text-5xl lg:text-5xl font-bold tracking-tight leading-tight text-black mb-8">
              De tener presencia digital a cerrar +15 Contratos High Ticket al mes.
            </h1>
            
            <p class="text-xl text-gray-500 max-w-xl leading-relaxed mb-8">
              Potenciamos su estrategia digital y lograron cerrar <strong class='text-black'>más de 15 contratos High Ticket</strong> mensuales en sus primeros 3 meses.
            </p>

            <div class="flex flex-col lg:flex-row gap-6 items-start lg:items-center">
              <div class="flex items-center gap-3 px-4 py-2 rounded-full bg-gray-50 border border-gray-100">
                <span class="text-green-600 font-bold">+15</span>
                <span class="text-sm text-gray-600 font-medium">Contratos/mes</span>
              </div>
            </div>
          </div>
          
          <div class="flex-1 w-full">
           <div class="relative rounded-3xl overflow-hidden border border-gray-100 bg-black shadow-2xl shadow-gray-200/50 group">
              <!-- Testimonial Video -->
              <script src="https://fast.wistia.com/player.js" async></script><script src="https://fast.wistia.com/embed/xd4owsfosr.js" async type="module"></script><style>wistia-player[media-id='xd4owsfosr']:not(:defined) { background: center / contain no-repeat url('https://fast.wistia.com/embed/medias/xd4owsfosr/swatch'); display: block; filter: blur(5px); padding-top:56.25%; }</style> <wistia-player media-id="xd4owsfosr" aspect="1.7777777777777777"></wistia-player>
            </div>


          </div>
        </div>
      </div>
    </section>

    <section class="py-24 px-6 md:px-12 bg-gray-50 relative">
      <div class="max-w-4xl mx-auto text-center space-y-8">
        <blockquote class="text-2xl md:text-4xl font-medium text-black leading-tight max-w-5xl mx-auto">
          "Fabricamos calidad premium, pero dependemos del tráfico local. Necesitamos un sistema que nos traiga obras completas todos los meses."
        </blockquote>
        <p class="text-gray-400 mt-6 font-medium">— El Desafío Inicial</p>
      </div>
    </section>



    <!-- Results Section -->
    <section class="py-32 px-6 md:px-12 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div class="space-y-8">
            <h2 class="text-3xl md:text-5xl font-bold text-black">Resultados Reales</h2>
            <p class="text-gray-500 text-lg">
              Resultados de alta intención. Generamos <strong class='text-black'>96 solicitudes de presupuesto</strong> que se transformaron en contratos cerrados.
            </p>
            
            <div class="space-y-6">
              <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-sm">
                <p class="text-xs text-gray-400 uppercase mb-2 tracking-wider">Presupuestos</p>
                <div class="flex items-end gap-4">
                  <span class="text-4xl font-bold text-black">96</span>
                  <span class="text-sm text-gray-500 mb-2">Solicitudes</span>
                </div>
                <p class="text-gray-400 text-sm mt-2">Solicitudes de cotización para obras completas.</p>
              </div>
              
              <div class="p-6 rounded-2xl bg-white border border-black shadow-lg">
                <p class="text-xs text-black uppercase mb-2 font-bold tracking-wider">Demanda</p>
                <div class="flex items-end gap-4">
                  <span class="text-5xl font-bold text-black">+123,3%</span>
                  <span class="text-sm text-gray-500 mb-2">Crecimiento</span>
                </div>
                <p class="text-green-600 font-medium mt-2 text-sm flex items-center gap-1">
                  <span class="material-symbols-outlined text-[18px]">trending_up</span>
                  Explosión de consultas en temporada alta.
                </p>
              </div>
            </div>
            
            <div class="pt-4">
              <p class="text-7xl font-bold text-black tracking-tighter">
                +15
              </p>
              <p class="text-gray-500 mt-2 text-xl font-medium">Contratos Cerrados</p>
            </div>
          </div>
          
          <!-- Results Images -->
          <div class="flex flex-col gap-6 w-full">
            <div class="rounded-3xl overflow-hidden border border-gray-200 shadow-xl shadow-gray-200/50">
              <Image 
                src={yearEndResults} 
                alt="Resultados de fin de año Atermicos Pinamar" 
                class="w-full h-auto object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 text-center bg-black text-white">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-4xl font-bold mb-6">¿Tu negocio necesita vender más?</h2>
        <p class="text-white/60 text-lg mb-10">
          Creamos sistemas de ventas predecibles, incluso si no tienes sitio web.
        </p>
        <a href="/#contact" class="inline-flex items-center gap-2 bg-white text-black px-6 py-3 rounded-full font-medium text-sm hover:bg-gray-200 transition-colors shadow-lg hover:shadow-xl">
          Solicitar Presupuesto
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>