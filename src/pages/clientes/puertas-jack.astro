---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/ads/HeaderAds.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import salesResults from '../../assets/clients/puertas-jack/Cantidad de Leads Calificados En 3 meses Puertas Blindadas.png';

const title = "Puertas Jack - Caso de Éxito | Algoritmia";
const description = "Cómo escalamos las ventas de puertas de alta seguridad de 3 a 12 unidades mensuales con Google Ads.";
---

<Layout title={title} description={description}>
  <Header />
  
  <main class="bg-white text-black selection:bg-gray-200">
    <!-- Hero Section -->
    <section class="relative pt-32 md:pt-48 pb-20 px-6 md:px-12 overflow-hidden">
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col lg:flex-row gap-10 lg:gap-12 items-center">
          <div class="flex-1 space-y-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 bg-gray-50">
              <span class="w-2 h-2 rounded-full bg-green-500"></span>
              <span class="text-xs font-medium text-gray-600 uppercase tracking-wide">Caso de Éxito</span>
            </div>
            
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight text-black mb-8">
              Multiplicamos x10 las ventas mensuales de productos High Ticket.
            </h1>
            
            <p class="text-xl text-gray-500 max-w-xl leading-relaxed mb-8">
              Escalamos su volumen de ventas High Ticket: de 2 unidades a <strong class='text-black'>más de 20 ventas mensuales</strong> en menos de 6 meses de trabajo.
            </p>

            <div class="flex flex-col lg:flex-row gap-6 items-start lg:items-center">
              <a href="https://puertasjack.com.ar/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-black text-white font-medium hover:bg-gray-800 transition-colors">
                Ver sitio web
                <span class="material-symbols-outlined text-[18px]">arrow_outward</span>
              </a>

              <div class="flex items-center gap-3 px-4 py-2 rounded-full bg-gray-50 border border-gray-100">
                <span class="text-green-600 font-bold">x10</span>
                <span class="text-sm text-gray-600 font-medium">Crecimiento en Ventas</span>
              </div>
            </div>
          </div>
          
          <div class="flex-1 w-full">
             <div class="relative aspect-[4/3] rounded-3xl overflow-hidden border border-gray-100 bg-black shadow-2xl shadow-gray-200/50 group">
              <!-- Testimonial Video -->
              <video 
                id="hero-testimonial-video"
                class="w-full h-full object-contain"
                controls
                poster=""
              >
                <source src="https://res.cloudinary.com/dfixkx6yi/video/upload/v1770320574/WhatsApp_Video_2026-02-03_at_3.47.37_PM_1_j5musp.mp4" type="video/mp4">
                Tu navegador no soporta videos HTML5.
              </video>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Challenge Section -->
    <section class="py-24 px-6 md:px-12 bg-gray-50 relative">
      <div class="max-w-4xl mx-auto text-center space-y-8">
        <blockquote class="text-2xl md:text-4xl font-medium text-black leading-tight max-w-5xl mx-auto">
          "Fabricamos puertas de alta seguridad, tenemos un producto excelente pero nos estancamos en 2 o 3 ventas mensuales."
        </blockquote>
        <p class="text-gray-400 mt-6 font-medium">— El Problema Inicial</p>
      </div>
    </section>



    <!-- Results Section -->
    <section class="py-32 px-6 md:px-12 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-16 items-center">
          <div class="space-y-8 lg:col-span-2">
            <h2 class="text-3xl md:text-5xl font-bold text-black">Resultados Reales</h2>
            <p class="text-gray-500 text-lg">
              Logramos un sistema de ventas predecible. De depender de referidos a generar más de 20 ventas mensuales de alto valor de manera constante.
            </p>
            
            <div class="space-y-6">
              <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-sm">
                <p class="text-xs text-gray-400 uppercase mb-2 tracking-wider">Leads Totales</p>
                <div class="flex items-end gap-4">
                  <span class="text-4xl font-bold text-black">1.029</span>
                  <span class="text-sm text-gray-500 mb-2">Consultas</span>
                </div>
                <p class="text-gray-400 text-sm mt-2">Consultas de personas reales interesadas en comprar puertas blindadas en los últimos meses.</p>
              </div>
              
              <div class="p-6 rounded-2xl bg-white border border-black shadow-lg">
                <p class="text-xs text-black uppercase mb-2 font-bold tracking-wider">Crecimiento</p>
                <div class="flex items-end gap-4">
                  <span class="text-5xl font-bold text-black">+35,2%</span>
                  <span class="text-sm text-gray-500 mb-2">Mensual</span>
                </div>
                <p class="text-green-600 font-medium mt-2 text-sm flex items-center gap-1">
                  <span class="material-symbols-outlined text-[18px]">trending_up</span>
                  El volumen de consultas sigue creciendo mes a mes gracias a la optimización continua.
                </p>
              </div>
            </div>
            
            <div class="pt-4">
              <p class="text-7xl font-bold text-black tracking-tighter">
                x10
              </p>
              <p class="text-gray-500 mt-2 text-xl font-medium">Escalado de Ventas</p>
            </div>
          </div>
          
          <!-- Results Images -->
          <div class="flex flex-col gap-6 w-full lg:col-span-3">
            <div class="rounded-3xl overflow-hidden border border-gray-200 shadow-xl shadow-gray-200/50">
              <Image 
                src={salesResults} 
                alt="Cantidad de leads calificados en 3 meses" 
                class="w-full h-auto object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 text-center bg-black text-white">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-4xl font-bold mb-6">¿Listo para escalar?</h2>
        <p class="text-white/60 text-lg mb-10">
          Llevamos tu negocio al siguiente nivel.
        </p>
        <a href="/#contact" class="inline-flex items-center gap-2 bg-white text-black px-6 py-3 rounded-full font-medium text-sm hover:bg-gray-200 transition-colors shadow-lg hover:shadow-xl">
          Solicitar Consultoría
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
