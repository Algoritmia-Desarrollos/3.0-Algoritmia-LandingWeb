---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/ads/HeaderAds.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';

import adsResults from '../../assets/clients/libreria-leo/ADS RESULTADOS LIBRERIA MAYORISTA LEO .png';

const title = "Librería Mayorista Leo - Caso de Éxito | Algoritmia";
const description = "Cómo automatizamos las ventas mayoristas y escalamos un negocio estacional un 400%.";
---
<Layout title={title} description={description}>
  <Header />
  
  <main class="bg-white text-black selection:bg-gray-200">
    <!-- Hero Section -->
    <section class="relative pt-32 md:pt-48 pb-20 px-6 md:px-12 overflow-hidden">
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col lg:flex-row gap-10 lg:gap-12 items-center">
          <div class="flex-1 space-y-8 w-full">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 bg-gray-50">
              <span class="w-2 h-2 rounded-full bg-green-500"></span>
              <span class="text-xs font-medium text-gray-600 uppercase tracking-wide">Caso de Éxito</span>
            </div>
            
            <h1 class="text-4xl md:text-6xl lg:text-5xl font-bold tracking-tight leading-tight text-black mb-8">
              De 2 pedidos semanales a facturar más de 150.000 USD al año.
            </h1>
            
            <p class="text-xl text-gray-500 max-w-xl leading-relaxed">
              Escalamos su facturación de manera exponencial. Invertimos 3.7 millones para generar <strong class='text-black'>164 millones de retorno</strong>, con un <strong class='text-black'>ROAS de 43</strong>.
            </p>
            
            <!-- Buttons for Desktop - shown here -->
            <div class="hidden lg:flex flex-col lg:flex-row gap-4 items-start lg:items-center">
              <a href="https://libreriamayoristaleo.com.ar/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-black text-white font-medium hover:bg-gray-800 transition-colors">
                Ver sitio web
                <span class="material-symbols-outlined text-[18px]">arrow_outward</span>
              </a>

              <div class="flex items-center gap-3 px-4 py-2 rounded-full bg-gray-50 border border-gray-100">
                <span class="text-green-600 font-bold">ROAS 43</span>
                <span class="text-sm text-gray-600 font-medium">Retorno de Inversión</span>
              </div>
            </div>
          </div>
          
          <div class="flex-1 w-full flex justify-center">
            <div class="relative group cursor-pointer rounded-3xl overflow-hidden border border-gray-100 bg-black shadow-2xl shadow-gray-200/50 w-full max-w-[540px] aspect-[3/4] lg:aspect-video mx-auto">
              <!-- Testimonial Video (Vertical 9:16 inside responsive container) -->
              <!-- Cover Image (Real img tag to guarantee object-cover occupies 100% of container) -->
              <img 
                id="video-cover-img" 
                src="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/portada-libreria-leo.webp" 
                class="absolute inset-0 w-full h-full object-cover" 
                alt="Portada Testimonio"
              />
              <!-- Testimonial Video (Vertical 9:16 inside responsive container) -->
              <video 
                id="hero-testimonial-video" 
                class="w-full h-full object-contain bg-black hidden" 
                preload="metadata"
              >
                <source src="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/testimonials/libreria-leo.mp4" type="video/mp4" />
                Tu navegador no soporta el elemento de video.
              </video>
              <!-- Play Overlay -->
              <div id="video-overlay" class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/10 transition-all duration-300">
                <button class="w-16 h-16 rounded-full bg-white text-black flex items-center justify-center shadow-2xl transform group-hover:scale-110 transition-transform duration-300" aria-label="Reproducir video">
                  <span class="material-symbols-outlined text-[36px] ml-1">play_arrow</span>
                </button>
              </div>
            </div>
          </div>
            
            <!-- Buttons for Mobile - shown here -->
            <div class="flex lg:hidden flex-col gap-4 items-start">
              <a href="https://libreriamayoristaleo.com.ar/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-black text-white font-medium hover:bg-gray-800 transition-colors">
                Ver sitio web
                <span class="material-symbols-outlined text-[18px]">arrow_outward</span>
              </a>

              <div class="flex items-center gap-3 px-4 py-2 rounded-full bg-gray-50 border border-gray-100">
                <span class="text-green-600 font-bold">ROAS 43</span>
                <span class="text-sm text-gray-600 font-medium">Retorno de Inversión</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Challenge Section -->
    <section class="py-24 px-6 md:px-12 bg-gray-50 relative">
      <div class="max-w-4xl mx-auto text-center space-y-8">
        <blockquote class="text-2xl md:text-4xl font-medium text-black leading-tight max-w-5xl mx-auto">
          "Tenemos mucha trayectoria en el rubro, pero no tenemos presencia digital. Necesitamos empezar a vender online y escalar nuestro negocio."
        </blockquote>
        <p class="text-gray-400 mt-6 font-medium">— El Desafío Inicial</p>
      </div>
    </section>



    <!-- Results Section -->
    <section class="py-32 px-6 md:px-12 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div class="space-y-8">
            <h2 class="text-3xl md:text-5xl font-bold text-black">Resultados Reales</h2>
            <p class="text-gray-500 text-lg">
              Resultados de alta eficiencia. Transformamos una inversión publicitaria de $3.7M en $164M de facturación rastreable, aprovechando las temporadas altas para escalar agresivamente.
            </p>
            
            <div class="space-y-6">
              <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-sm">
                <p class="text-xs text-gray-400 uppercase mb-2 tracking-wider">ROAS (Retorno)</p>
                <div class="flex items-end gap-4">
                  <span class="text-4xl font-bold text-black">43</span>
                  <span class="text-sm text-gray-500 mb-2">Multiplicador</span>
                </div>
                <p class="text-gray-400 text-sm mt-2">Por cada $1 invertido, facturamos $43.</p>
              </div>
              
              <div class="p-6 rounded-2xl bg-white border border-black shadow-lg">
                <p class="text-xs text-black uppercase mb-2 font-bold tracking-wider">Facturación Generada</p>
                <div class="flex items-end gap-4">
                  <span class="text-5xl font-bold text-black">$164M+</span>
                  <span class="text-sm text-gray-500 mb-2">En 12 meses</span>
                </div>
                <p class="text-green-600 font-medium mt-2 text-sm flex items-center gap-1">
                  <span class="material-symbols-outlined text-[18px]">payments</span>
                  Retorno directo de la inversión publicitaria (3.7M).
                </p>
              </div>
            </div>
            
            <div class="pt-4">
              <p class="text-7xl font-bold text-black tracking-tighter">
                +700
              </p>
              <p class="text-gray-500 mt-2 text-xl font-medium">Pedidos Online</p>
            </div>
          </div>
          
          <!-- Graph Visualization -->
          <!-- Results Images -->
          <div class="flex flex-col gap-6">
            <div class="rounded-3xl overflow-hidden border border-gray-200 shadow-xl shadow-gray-200/50">
              <Image 
                src={adsResults} 
                alt="ADS RESULTADOS LIBRERIA MAYORISTA LEO" 
                class="w-full h-auto object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 text-center bg-black text-white">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-4xl font-bold mb-6">¿Listo para escalar?</h2>
        <p class="text-white/60 text-lg mb-10">
          Llevamos tu negocio al siguiente nivel.
        </p>
        <a href="/#contact" class="inline-flex items-center gap-2 bg-white text-black px-6 py-3 rounded-full font-medium text-sm hover:bg-gray-200 transition-colors shadow-lg hover:shadow-xl">
          Solicitar Consultoría
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </section>
  </main>
  
  <Footer />
  
  <script>
    document.addEventListener('astro:page-load', () => {
      const video = document.getElementById('hero-testimonial-video') as HTMLVideoElement | null;
      const overlay = document.getElementById('video-overlay');
      const coverImg = document.getElementById('video-cover-img') as HTMLImageElement | null;
      
      if (video && overlay && !video.dataset.playerSetup) {
        video.dataset.playerSetup = "true";
        
        const handlePlay = () => {
          if (video.paused) {
            if (coverImg) coverImg.classList.add('hidden');
            video.classList.remove('hidden');
            video.play();
            overlay.classList.add('hidden');
            video.setAttribute('controls', 'true');
          } else {
            video.pause();
          }
        };
        
        overlay.addEventListener('click', handlePlay);
        
        video.addEventListener('pause', () => {
          overlay.classList.remove('hidden');
        });
        
        video.addEventListener('play', () => {
          if (coverImg) coverImg.classList.add('hidden');
          video.classList.remove('hidden');
          overlay.classList.add('hidden');
          video.setAttribute('controls', 'true');
        });
        
        video.addEventListener('ended', () => {
          video.classList.add('hidden');
          video.removeAttribute('controls');
          if (coverImg) coverImg.classList.remove('hidden');
          overlay.classList.remove('hidden');
        });
      }

      // Check if we should autoplay the video (coming from home page modal)
      const urlParams = new URLSearchParams(window.location.search);
      const shouldAutoplay = urlParams.get('autoplay') === 'true';
      
      if (video && shouldAutoplay) {
        // Scroll to the video
        video.scrollIntoView({ behavior: 'smooth', block: 'center' });
        
        // Play the video after a short delay to ensure smooth scroll
        setTimeout(() => {
          if (video) {
            if (coverImg) coverImg.classList.add('hidden');
            video.classList.remove('hidden');
            video.play().catch(err => console.log('Video autoplay error:', err));
          }
        }, 500);
        
        // Clean up URL (remove query parameter)
        if (window.history.replaceState) {
          const cleanUrl = window.location.pathname;
          window.history.replaceState({}, document.title, cleanUrl);
        }
      }
    });
  </script>
</Layout>
