---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/ads/HeaderAds.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import coverImage from '../../assets/imgwebs/FagazSa.webp';
import resultsImage from '../../assets/clients/selecta/resultados Selecta Ads.webp';

const title = "Fagaz SA - Caso de Éxito | Algoritmia";
const description = "Cómo ayudamos a Fagaz SA a consolidar sus 3 unidades de negocio y posicionarse como líder regional en servicios industriales.";
---

<Layout title={title} description={description}>
  <Header />
  
  <main class="bg-white text-black selection:bg-gray-200">
    <!-- Hero Section -->
    <section class="relative pt-32 md:pt-48 pb-20 px-6 md:px-12 overflow-hidden">
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col lg:flex-row gap-10 lg:gap-12 items-center">
          <div class="flex-1 space-y-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 bg-gray-50">
              <span class="w-2 h-2 rounded-full bg-green-500"></span>
              <span class="text-xs font-medium text-gray-600 uppercase tracking-wide">Caso de Éxito</span>
            </div>
            
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight text-black mb-8">
              Líderes en Servicios Industriales Integrales.
            </h1>
            
            <p class="text-xl text-gray-500 max-w-xl leading-relaxed mb-8">
              Posicionamiento de marca y captación de clientes potenciales para sus unidades de Limpieza, Fumigación y Recursos Humanos mediante Meta Ads.
            </p>

            <div class="flex flex-col lg:flex-row gap-6 items-start lg:items-center">
              <a href="https://fagazsa.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-black text-white font-medium hover:bg-gray-800 transition-colors">
                Ver sitio web
                <span class="material-symbols-outlined text-[18px]">arrow_outward</span>
              </a>

              <div class="flex items-center gap-3 px-4 py-2 rounded-full bg-gray-50 border border-gray-100">
                <span class="text-green-600 font-bold">Meta Ads</span>
                <span class="text-sm text-gray-600 font-medium">Estrategia Industrial</span>
              </div>
            </div>
          </div>
          
          <div class="flex-1 w-full">
            <div class="relative aspect-[4/3] rounded-3xl overflow-hidden border border-gray-100 bg-gray-50 shadow-2xl shadow-gray-200/50 group">
               <Image 
                src={coverImage} 
                alt="Fagaz SA Industrial Services" 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Challenge Section -->
    <section class="py-24 px-6 md:px-12 bg-gray-50 relative">
      <div class="max-w-4xl mx-auto text-center space-y-8">
        <blockquote class="text-2xl md:text-4xl font-medium text-black leading-tight max-w-5xl mx-auto">
          "Somos muy buenos en lo que hacemos, pero nos falta visibilidad. Necesitamos que las grandes industrias nos conozcan y nos consideren para sus licitaciones."
        </blockquote>
        <p class="text-gray-400 mt-6 font-medium">— El Desafío</p>
      </div>
    </section>

    <!-- Solution Section -->
    <section class="py-32 px-6 md:px-12 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20">
          <h2 class="text-3xl md:text-5xl font-bold mb-6 text-black">Lo que hicimos</h2>
          <p class="text-gray-500 text-lg">Estrategia de Meta Ads enfocada en Reconocimiento de Marca y Generación de Leads.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Card 1 -->
          <div class="p-8 rounded-3xl bg-gray-50 border border-gray-100 hover:border-gray-300 transition-colors group">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mb-6 border border-gray-200 group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-black">visibility</span>
            </div>
            <h3 class="text-xl font-bold text-black mb-3">Reconocimiento de Marca</h3>
            <p class="text-gray-500 text-sm leading-relaxed">
              Ejecutamos campañas de alcance masivo en la región para posicionar a Fagaz SA como la autoridad indiscutida en servicios industriales.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="p-8 rounded-3xl bg-gray-50 border border-gray-100 hover:border-gray-300 transition-colors group">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mb-6 border border-gray-200 group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-black">filter_alt</span>
            </div>
            <h3 class="text-xl font-bold text-black mb-3">Segmentación Industrial</h3>
            <p class="text-gray-500 text-sm leading-relaxed">
              Dirigimos los anuncios específicamente a gerentes de planta, encargados de mantenimiento y responsables de RRHH en la zona portuaria e industrial.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="p-8 rounded-3xl bg-gray-50 border border-gray-100 hover:border-gray-300 transition-colors group">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mb-6 border border-gray-200 group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-black">ads_click</span>
            </div>
            <h3 class="text-xl font-bold text-black mb-3">Generación de Leads</h3>
            <p class="text-gray-500 text-sm leading-relaxed">
              Implementamos formularios nativos en Facebook e Instagram para captar solicitudes de presupuesto calificadas de empresas interesadas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Results Section -->
    <section class="py-32 px-6 md:px-12 bg-gray-50">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div class="space-y-8">
            <h2 class="text-3xl md:text-5xl font-bold text-black">Resultados Reales</h2>
            <p class="text-gray-500 text-lg">
              Consolidación de marca y posicionamiento como referente regional en servicios industriales.
            </p>
            
            <div class="space-y-6">
              <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-sm">
                <p class="text-xs text-gray-400 uppercase mb-2 tracking-wider">Antes</p>
                <div class="flex items-end gap-4">
                  <span class="text-xl font-bold text-gray-400">Dependencia de Referidos</span>
                </div>
                <p class="text-gray-400 text-sm mt-2">Crecimiento limitado al boca a boca</p>
              </div>
              
              <div class="p-6 rounded-2xl bg-white border border-black shadow-lg">
                <p class="text-xs text-black uppercase mb-2 font-bold tracking-wider">Ahora</p>
                <div class="flex items-end gap-4">
                  <span class="text-3xl lg:text-4xl font-bold text-black">Flujo de Consultas B2B</span>
                </div>
                <p class="text-green-600 font-medium mt-2 text-sm flex items-center gap-1">
                  <span class="material-symbols-outlined text-[18px]">verified</span>
                  Solicitudes de presupuesto constantes
                </p>
              </div>
            </div>
            
            <div class="pt-4">
              <p class="text-5xl lg:text-6xl font-bold text-black tracking-tighter">
                Referente
              </p>
              <p class="text-gray-500 mt-2 text-xl font-medium">Autoridad Digital en el Cordón Industrial</p>
            </div>
          </div>
          
          <!-- Results Images -->
          <div class="flex flex-col gap-6 w-full">
            <div class="rounded-3xl overflow-hidden border border-gray-200 shadow-xl shadow-gray-200/50">
              <Image 
                src={resultsImage} 
                alt="Fagaz SA Resultados Industriales" 
                class="w-full h-auto object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 text-center bg-black text-white">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-4xl font-bold mb-6">¿Necesitas soluciones industriales?</h2>
        <p class="text-white/60 text-lg mb-10">
          Estamos listos para atender sus necesidades con los más altos estándares.
        </p>
        <a href="/#contact" class="inline-flex items-center gap-2 bg-white text-black px-6 py-3 rounded-full font-medium text-sm hover:bg-gray-200 transition-colors shadow-lg hover:shadow-xl">
          Contactar Ahora
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
