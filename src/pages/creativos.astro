<style>
	/* Resaltado tipo marcador: una barra bajo el texto, no una caja que lo encierra.
	   Va con background y no con border-bottom para que siga cada línea al hacer wrap. */
	.marca {
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 100% 0.085em;
		/* Justo debajo de las descendentes (q, g, j) sin llegar a tocarlas. */
		padding-bottom: 0.13em;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}
	/* sobre fondo oscuro */
	.marca-clara { background-image: linear-gradient(#fff, #fff); }
	/* sobre fondo claro */
	.marca-oscura { background-image: linear-gradient(#18181b, #18181b); }

	.faq summary::-webkit-details-marker { display: none; }

	/* Marquee continuo. El track lleva la lista DUPLICADA y `w-max`, así su ancho es la
	   suma real de las 12 tarjetas (no el del contenedor). Entonces -50% equivale exacto
	   a un set de 6, y el -0.5rem cierra el gap entre la 6ª y la 7ª: al reiniciar, el
	   fotograma es idéntico al del inicio. Sin `w-max`, el 50% se calcula sobre el ancho
	   del padre y el ciclo no cierra — ahí aparecía el salto. */
	.video-track {
		animation: videoScroll 14s linear infinite;
		will-change: transform;
		backface-visibility: hidden;
	}
	/* No frena con el mouse encima: solo se pausa al tocarlo en móvil (para poder abrir un video) */
	.video-track.paused { animation-play-state: paused; }

	@keyframes videoScroll {
		from { transform: translate3d(0, 0, 0); }
		to   { transform: translate3d(calc(-50% - 0.5rem), 0, 0); }
	}

	/* Nunca scroll manual ni barra visible: el movimiento es siempre automático */
	.video-marquee {
		overflow: hidden;
		scrollbar-width: none;
	}
	.video-marquee::-webkit-scrollbar { display: none; }
</style>

<script>
	function initCreativos() {
		// Contador rotativo: el restante siempre queda entre 3h y 7h.
		//
		// El tiempo se parte en ventanas fijas ancladas al reloj universal (no a la visita).
		// El plazo de una ventana vence COLCHON minutos después de que la ventana cierra,
		// así el restante va de (VENTANA + COLCHON) hasta COLCHON, y ahí salta a la siguiente.
		// Como todo se deriva del reloj, si el usuario recarga o vuelve más tarde, el contador
		// siguió corriendo: nunca se reinicia por entrar de nuevo.
		const cd = document.getElementById('cd');
		if (cd) {
			const MIN     = 60_000;
			const ventana = Number(cd.dataset.ventana) * MIN;
			const colchon = Number(cd.dataset.colchon) * MIN;
			const jitter  = Number(cd.dataset.jitter)  * MIN;
			const slots   = cd.querySelectorAll<HTMLElement>('[data-cd]');
			const pad     = (n: number) => String(Math.max(0, n)).padStart(2, '0');

			// Desvío estable por ventana: la misma ventana da siempre el mismo desvío,
			// pero cada ventana cae en un minuto distinto (no queda redondo).
			const desvio = (n: number) => {
				let h = n * 2654435761 % 2147483647;
				h = (h ^ (h >>> 13)) >>> 0;
				return (h % (jitter + 1));
			};

			const vence = () => {
				const ahora = Date.now();
				const i     = Math.floor(ahora / ventana);          // índice de ventana actual
				const fin   = (i + 1) * ventana + colchon + desvio(i);
				// Si por el desvío el plazo ya pasó, tomamos el de la ventana siguiente.
				return fin > ahora ? fin : (i + 2) * ventana + colchon + desvio(i + 1);
			};

			let deadline = vence();

			const tick = () => {
				let falta = deadline - Date.now();
				if (falta <= 0) {                 // se cerró la ventana: se reprograma sola
					deadline = vence();
					falta = deadline - Date.now();
				}
				const s = Math.floor(falta / 1000);
				const map: Record<string, number> = {
					h: Math.floor(s / 3600),
					m: Math.floor((s % 3600) / 60),
					s: s % 60
				};
				slots.forEach((el) => { el.textContent = pad(map[el.dataset.cd || 's']); });
			};

			tick();
			setInterval(tick, 1000);
		}

		// En móvil no hay hover: al tocar el carrusel se pausa para poder abrir un video
		const track = document.querySelector<HTMLElement>('.video-track');
		track?.addEventListener('touchstart', () => track.classList.add('paused'), { passive: true });

		// Lightbox de video
		const box   = document.getElementById('vbox');
		const video = document.getElementById('vbox-video') as HTMLVideoElement | null;
		const name  = document.getElementById('vbox-name');
		const close = document.getElementById('vbox-close');

		const cerrar = () => {
			if (!box || !video) return;
			video.pause();
			video.removeAttribute('src');
			video.load();
			box.classList.add('hidden');
			box.classList.remove('flex');
			document.body.style.overflow = '';
			track?.classList.remove('paused');   // el carrusel vuelve a andar al cerrar el video
		};

		document.querySelectorAll<HTMLButtonElement>('.video-card').forEach((card) => {
			card.addEventListener('click', () => {
				if (!box || !video) return;
				video.src = card.dataset.video || '';
				if (name) name.textContent = card.dataset.nombre || '';
				box.classList.remove('hidden');
				box.classList.add('flex');
				document.body.style.overflow = 'hidden';
				video.play().catch(() => {});
			});
		});

		close?.addEventListener('click', cerrar);
		box?.addEventListener('click', (e) => { if (e.target === box) cerrar(); });
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });

		// FAQ: abrir uno cierra el resto
		const faqs = document.querySelectorAll<HTMLDetailsElement>('.faq');
		faqs.forEach((d) => {
			d.addEventListener('toggle', () => {
				if (!d.open) return;
				faqs.forEach((o) => { if (o !== d) o.open = false; });
			});
		});
	}

	document.addEventListener('astro:page-load', initCreativos);
	document.addEventListener('DOMContentLoaded', initCreativos);
</script>

</Layout>
