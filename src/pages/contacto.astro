---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { 
  ShoppingBag, 
  Briefcase, 
  GraduationCap, 
  Laptop, 
  Store, 
  CheckCircle2, 
  Clock,
  XCircle, 
  Code2, 
  MessageSquare,
  TrendingUp, 
  Ban,
  Zap,
  DollarSign, 
  Coins,
  Wallet,
  BarChart3,
  Trophy,
  AlertTriangle, 
  ArrowLeft, 
  Send,
  MessageCircle,
  Instagram
} from 'lucide-astro';
---

<Layout title="Postulación Paso a Paso | Algoritmia" description="Completa el cuestionario interactivo para calificar tu negocio y escalar tus ventas con Meta Ads.">
  <div class="min-h-screen bg-white text-slate-900 font-sans selection:bg-blue-600 selection:text-white flex flex-col justify-start">
    
    <!-- Header Navigation (Alineado a la izquierda con el contenido) -->
    <header class="max-w-lg mx-auto w-full px-5 sm:px-8 pt-6 pb-4">
      <div class="inline-flex items-center gap-2.5">
        <img src="/logoAlgoritmia.webp" alt="Algoritmia Logo" class="w-8 h-8 object-contain" />
        <span class="font-bold text-xl tracking-tight text-slate-900">Algoritmia</span>
      </div>
    </header>

    <!-- Main Section (Fondo blanco puro, sin contenedor dentro de contenedor, alineado más a la izquierda) -->
    <main class="flex-1 w-full px-5 sm:px-8 pt-2 pb-12">
      <div class="w-full max-w-lg mx-auto">

        <!-- Progress Tracker Bar (Alineado arriba de los pasos) -->
        <div id="progress-container" class="mb-6">
          <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
            <div id="progress-bar" class="bg-blue-600 h-full w-[16%] transition-all duration-300 ease-out"></div>
          </div>
        </div>

        <!-- Loading State (inline) -->
        <div id="form-loading" class="hidden py-12 flex flex-col items-center justify-center gap-5 text-center">
          <div class="w-12 h-12 bg-blue-50 border border-blue-200 rounded-2xl flex items-center justify-center text-blue-600 shadow-xs">
            <div class="w-6 h-6 border-[3px] border-blue-600 border-t-transparent rounded-full animate-spin"></div>
          </div>
          <div class="space-y-1">
            <h3 id="loading-status" class="text-base font-bold text-slate-900">Enviando postulación...</h3>
            <p id="loading-substatus" class="text-xs text-slate-500">Conectando con el servidor de correo...</p>
          </div>
          <div class="w-full max-w-xs bg-slate-100 h-2 rounded-full overflow-hidden">
            <div id="sending-progress-bar" class="bg-blue-600 h-full w-[25%] transition-all duration-500 ease-out"></div>
          </div>
        </div>

        <!-- Error State (inline) -->
        <div id="form-error" class="hidden py-10 flex flex-col items-center justify-center gap-4 text-center">
          <div class="w-11 h-11 bg-red-50 border border-red-200 rounded-2xl flex items-center justify-center text-red-500">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          </div>
          <h2 class="text-lg font-bold text-slate-900">Error al enviar</h2>
          <p class="text-slate-500 text-xs max-w-xs leading-relaxed">Ocurrió un problema al enviar tu postulación. Por favor escribinos directamente por WhatsApp.</p>
          <div class="flex gap-2.5">
            <a href="https://wa.me/5493476245523" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-5 py-3 rounded-xl transition-all">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M11.99 2h-.02A9.99 9.99 0 0 0 2 12c0 1.77.465 3.43 1.27 4.876L2 22l5.247-1.247A9.947 9.947 0 0 0 12.01 22H12c5.514 0 10-4.486 10-10S17.514 2 11.99 2z"/></svg>
              WhatsApp
            </a>
            <button type="button" id="retry-btn" class="text-xs font-semibold px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">Intentar de nuevo</button>
          </div>
        </div>

        <!-- Disqualified State Card (Condicional) -->
        <div id="form-disqualified" class="hidden text-center py-6 animate-fade-in">
          <div class="w-11 h-11 bg-amber-50 border border-amber-200 rounded-2xl flex items-center justify-center mx-auto mb-3.5 text-amber-600 shadow-xs">
            <AlertTriangle class="w-5.5 h-5.5" />
          </div>
          <h2 id="dq-title" class="text-lg md:text-xl font-bold text-slate-900 mb-2">No podemos tomar tu proyecto en esta etapa</h2>
          <p id="dq-message" class="text-slate-600 text-xs md:text-sm max-w-md mx-auto mb-5 leading-relaxed">
            Para garantizar resultados positivos en Meta Ads, únicamente trabajamos con marcas que ya tienen una oferta validada y ventas activas en su tienda online.
          </p>

          <div class="bg-slate-50 border border-slate-200 p-4 rounded-2xl text-left max-w-md mx-auto mb-5 text-xs text-slate-600 space-y-1">
            <p class="font-semibold text-slate-900">💡 Se ha notificado a nuestro equipo</p>
            <p>Guardamos tus datos para contactarte cuando abramos programas para etapas iniciales. Te invitamos a seguir nuestro contenido gratuito en Instagram.</p>
          </div>

          <div class="flex flex-col sm:flex-row gap-2.5 justify-center">
            <a href="https://www.instagram.com/algoritmia.ads" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-5 py-3 rounded-xl transition-all shadow-md">
              <Instagram class="w-4 h-4 text-pink-300" />
              <span>Instagram de Algoritmia</span>
            </a>
            <button type="button" onclick="window.location.reload()" class="inline-flex items-center justify-center text-xs font-semibold px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">
              Reiniciar Formulario
            </button>
          </div>
        </div>

        <!-- Success State Card -->
        <div id="form-success" class="hidden text-center py-6 animate-fade-in">
          <div class="w-11 h-11 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center justify-center mx-auto mb-3.5 text-emerald-600 shadow-xs">
            <CheckCircle2 class="w-5.5 h-5.5" />
          </div>
          <h2 class="text-lg md:text-xl font-bold text-slate-900 mb-2">¡Tu perfil califica!</h2>
          <p class="text-slate-600 text-xs md:text-sm max-w-md mx-auto mb-5 leading-relaxed">
            Recibimos tu postulación correctamente. Evaluaremos tus datos y te escribiremos por WhatsApp en <strong class="text-slate-900">menos de 24 horas</strong>.
          </p>
          <div class="flex flex-col sm:flex-row gap-2.5 justify-center">
            <a href="https://wa.me/5493476245523" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-3 rounded-xl font-bold text-xs transition-all shadow-md">
              <MessageCircle class="w-4 h-4" />
              <span>Hablar por WhatsApp Ahora</span>
            </a>
            <a href="/" class="inline-flex items-center justify-center px-5 py-3 rounded-xl font-semibold text-xs bg-slate-100 hover:bg-slate-200 text-slate-800 transition-all">
              Volver al Inicio
            </a>
          </div>
        </div>

        <!-- Main Interactive Form -->
        <form id="stepForm" class="space-y-4" novalidate>
          
          <!-- PASO 1: Tipo de Negocio -->
          <div class="form-step" data-step="1">
            <div class="flex items-center justify-between text-xs font-medium text-slate-400 mb-3">
              <div><!-- Sin Atrás en Paso 1 --></div>
              <span>Paso 1 de 6</span>
            </div>

            <div class="mb-5">
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 leading-tight">¿A qué se dedica tu negocio?</h2>
            </div>

            <div class="grid grid-cols-1 gap-3">
              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-blue-600 flex items-center justify-center transition-colors shrink-0">
                  <ShoppingBag class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Ecommerce / Productos Físicos</span>
                <input type="radio" name="businessType" value="Ecommerce" required class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-purple-600 flex items-center justify-center transition-colors shrink-0">
                  <Briefcase class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Servicios B2B / Agencia</span>
                <input type="radio" name="businessType" value="Servicios B2B" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-amber-600 flex items-center justify-center transition-colors shrink-0">
                  <GraduationCap class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Infoproductos / Cursos</span>
                <input type="radio" name="businessType" value="Infoproductos" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-indigo-600 flex items-center justify-center transition-colors shrink-0">
                  <Laptop class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Software / SaaS / App</span>
                <input type="radio" name="businessType" value="Software" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-emerald-600 flex items-center justify-center transition-colors shrink-0">
                  <Store class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Negocio Local / Físico</span>
                <input type="radio" name="businessType" value="Local" class="sr-only" />
              </label>
            </div>
          </div>

          <!-- PASO 2: Validación de Ventas Activas (CONDICIONAL) -->
          <div class="form-step hidden" data-step="2">
            <div class="flex items-center justify-between text-xs font-medium text-slate-400 mb-3">
              <button type="button" class="prev-step-btn inline-flex items-center gap-1 text-slate-500 hover:text-blue-600 font-semibold transition-colors">
                <ArrowLeft class="w-3.5 h-3.5" />
                <span>Atrás</span>
              </button>
              <span>Paso 2 de 6</span>
            </div>

            <div class="mb-5">
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 leading-tight">¿Tenés una oferta validada y ventas activas?</h2>
            </div>

            <div class="grid grid-cols-1 gap-3">
              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-emerald-600 flex items-center justify-center transition-colors shrink-0">
                  <CheckCircle2 class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Sí, tengo ventas activas (online, local físico o canal directo)</span>
                <input type="radio" name="hasValidatedOffer" value="yes_active" required class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-amber-600 flex items-center justify-center transition-colors shrink-0">
                  <Clock class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Tengo tienda o local pero todavía NO tengo ventas regulares</span>
                <input type="radio" name="hasValidatedOffer" value="no_sales" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-rose-600 flex items-center justify-center transition-colors shrink-0">
                  <XCircle class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">No tengo ventas activas ni oferta validada aún</span>
                <input type="radio" name="hasValidatedOffer" value="no_store" class="sr-only" />
              </label>
            </div>
          </div>

          <!-- PASO 3: Plataforma de Tienda / Web -->
          <div class="form-step hidden" data-step="3">
            <div class="flex items-center justify-between text-xs font-medium text-slate-400 mb-3">
              <button type="button" class="prev-step-btn inline-flex items-center gap-1 text-slate-500 hover:text-blue-600 font-semibold transition-colors">
                <ArrowLeft class="w-3.5 h-3.5" />
                <span>Atrás</span>
              </button>
              <span>Paso 3 de 6</span>
            </div>

            <div class="mb-5">
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 leading-tight">¿Dónde tenés alojada tu tienda online o sitio?</h2>
            </div>

            <div class="grid grid-cols-1 gap-3">
              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 flex items-center justify-center transition-colors shrink-0">
                  <img src="/images/platforms/tiendanubeoscuro.png" alt="Tiendanube Logo" class="w-5.5 h-5.5 object-contain" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Tiendanube</span>
                <input type="radio" name="platform" value="Tiendanube" required class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 flex items-center justify-center transition-colors shrink-0">
                  <img src="/images/platforms/shopify-bag.webp" alt="Shopify Logo" class="w-5.5 h-5.5 object-contain" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Shopify</span>
                <input type="radio" name="platform" value="Shopify" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 flex items-center justify-center transition-colors shrink-0">
                  <img src="/images/platforms/logowordpress.webp" alt="WooCommerce / WordPress Logo" class="w-5.5 h-5.5 object-contain" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">WooCommerce / WordPress</span>
                <input type="radio" name="platform" value="WooCommerce" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-slate-700 flex items-center justify-center transition-colors shrink-0">
                  <Code2 class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Desarrollo Propio / Vercel / Webflow / Otro</span>
                <input type="radio" name="platform" value="Custom" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-slate-600 flex items-center justify-center transition-colors shrink-0">
                  <MessageSquare class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">No aplica / Canal directo (WhatsApp, Instagram, etc.)</span>
                <input type="radio" name="platform" value="No aplica" class="sr-only" />
              </label>
            </div>
          </div>

          <!-- PASO 4: Inversión en Meta Ads -->
          <div class="form-step hidden" data-step="4">
            <div class="flex items-center justify-between text-xs font-medium text-slate-400 mb-3">
              <button type="button" class="prev-step-btn inline-flex items-center gap-1 text-slate-500 hover:text-blue-600 font-semibold transition-colors">
                <ArrowLeft class="w-3.5 h-3.5" />
                <span>Atrás</span>
              </button>
              <span>Paso 4 de 6</span>
            </div>

            <div class="mb-5">
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 leading-tight">¿Invertís actualmente en Meta Ads?</h2>
            </div>

            <div class="grid grid-cols-1 gap-3">
              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-slate-500 flex items-center justify-center transition-colors shrink-0">
                  <Ban class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">No invierto actualmente</span>
                <input type="radio" name="adSpend" value="never" required class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-indigo-600 flex items-center justify-center transition-colors shrink-0">
                  <TrendingUp class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Entre $0 a $500 USD / mes</span>
                <input type="radio" name="adSpend" value="0_500" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-blue-600 flex items-center justify-center transition-colors shrink-0">
                  <TrendingUp class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Entre $500 a $1.500 USD / mes</span>
                <input type="radio" name="adSpend" value="500_1500" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-teal-600 flex items-center justify-center transition-colors shrink-0">
                  <TrendingUp class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Entre $1.500 a $5.000 USD / mes</span>
                <input type="radio" name="adSpend" value="1500_5000" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-emerald-600 flex items-center justify-center transition-colors shrink-0">
                  <Zap class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Más de $5.000 USD / mes</span>
                <input type="radio" name="adSpend" value="plus_5000" class="sr-only" />
              </label>
            </div>
          </div>

          <!-- PASO 5: Facturación Mensual Promedio -->
          <div class="form-step hidden" data-step="5">
            <div class="flex items-center justify-between text-xs font-medium text-slate-400 mb-3">
              <button type="button" class="prev-step-btn inline-flex items-center gap-1 text-slate-500 hover:text-blue-600 font-semibold transition-colors">
                <ArrowLeft class="w-3.5 h-3.5" />
                <span>Atrás</span>
              </button>
              <span>Paso 5 de 6</span>
            </div>

            <div class="mb-5">
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 leading-tight">¿Cuál es tu facturación mensual promedio?</h2>
            </div>

            <div class="grid grid-cols-1 gap-3">
              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-blue-600 flex items-center justify-center transition-colors shrink-0">
                  <DollarSign class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Entre $0 a $5.000 USD / mes</span>
                <input type="radio" name="revenue" value="0_5k" required class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-teal-600 flex items-center justify-center transition-colors shrink-0">
                  <Coins class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Entre $5.000 a $20.000 USD / mes</span>
                <input type="radio" name="revenue" value="5k_20k" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-indigo-600 flex items-center justify-center transition-colors shrink-0">
                  <Wallet class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Entre $20.000 a $50.000 USD / mes</span>
                <input type="radio" name="revenue" value="20k_50k" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-emerald-600 flex items-center justify-center transition-colors shrink-0">
                  <BarChart3 class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Entre $50.000 a $100.000 USD / mes</span>
                <input type="radio" name="revenue" value="50k_100k" class="sr-only" />
              </label>

              <label class="option-card group flex items-center gap-3.5 p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-xs cursor-pointer transition-all bg-white">
                <div class="icon-box w-10 h-10 rounded-xl bg-slate-100 border border-slate-200/80 text-amber-600 flex items-center justify-center transition-colors shrink-0">
                  <Trophy class="w-5 h-5" />
                </div>
                <span class="text-sm md:text-base font-semibold text-slate-900 flex-1 leading-snug">Más de $100.000 USD / mes</span>
                <input type="radio" name="revenue" value="plus_100k" class="sr-only" />
              </label>
            </div>
          </div>

          <!-- PASO 6: Datos de Contacto -->
          <div class="form-step hidden" data-step="6">
            <div class="flex items-center justify-between text-xs font-medium text-slate-400 mb-3">
              <button type="button" class="prev-step-btn inline-flex items-center gap-1 text-slate-500 hover:text-blue-600 font-semibold transition-colors">
                <ArrowLeft class="w-3.5 h-3.5" />
                <span>Atrás</span>
              </button>
              <span>Paso 6 de 6</span>
            </div>

            <div class="mb-5">
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 leading-tight">Completá tus datos para ser contactado</h2>
            </div>

            <div class="space-y-4">
              <div>
                <label for="nombre" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nombre Completo *</label>
                <input 
                  type="text" 
                  id="nombre" 
                  name="nombre" 
                  required 
                  placeholder="Ej: Juan Pérez"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-600 focus:bg-white transition-all text-xs md:text-sm"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email Profesional *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="juan@tunegocio.com"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-600 focus:bg-white transition-all text-xs md:text-sm"
                />
              </div>

              <div>
                <label for="telefono" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">WhatsApp / Teléfono *</label>
                <input 
                  type="tel" 
                  id="telefono" 
                  name="telefono" 
                  required 
                  placeholder="+54 9 11 1234 5678"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-600 focus:bg-white transition-all text-xs md:text-sm"
                />
              </div>

              <div>
                <label for="comments" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Comentarios o URL de tu Tienda / Web (Opcional)</label>
                <textarea 
                  id="comments" 
                  name="comments" 
                  rows="2" 
                  placeholder="https://tutienda.com o detalles adicionales sobre tu negocio..."
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-600 focus:bg-white transition-all text-xs md:text-sm resize-none"
                ></textarea>
              </div>

              <div class="pt-4">
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 px-6 rounded-xl transition-all shadow-md shadow-blue-500/20 text-xs md:text-sm flex items-center justify-center gap-2">
                  <span>Enviar Postulación</span>
                  <Send class="w-4 h-4" />
                </button>
              </div>
            </div>
          </div>

        </form>

      </div>
    </main>

  </div>
</Layout>

<style>
  /* Visual selection state for radio card labels */
  .option-card:has(input[type="radio"]:checked) {
    border-color: #2563eb;
    background-color: #eff6ff;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
  }
  .option-card:has(input[type="radio"]:checked) .icon-box {
    border-color: #93c5fd;
    background-color: #dbeafe;
  }

  /* Step transitions */
  .form-step {
    animation: stepFadeIn 0.22s ease-out forwards;
  }
  @keyframes stepFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Loading/error/success states */
  #form-loading, #form-error {
    animation: stepFadeIn 0.2s ease-out forwards;
  }

  /* Button spinner */
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .btn-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255,255,255,0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    flex-shrink: 0;
  }

  /* Tap feedback on option cards */
  .option-card:active {
    transform: scale(0.98);
  }
</style>

<script>
  function initForm() {
    const form = document.getElementById('stepForm') as HTMLFormElement | null;
    if (!form) return;

    // Avoid double-initialization on re-renders
    if (form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const steps = Array.from(document.querySelectorAll('.form-step')) as HTMLElement[];
    const prevBtns = document.querySelectorAll('.prev-step-btn');
    
    const progressBar = document.getElementById('progress-bar');
    const progressContainer = document.getElementById('progress-container');

    const formDisqualified = document.getElementById('form-disqualified');
    const dqTitle = document.getElementById('dq-title');
    const dqMessage = document.getElementById('dq-message');

    let currentStepIndex = 0;

    const stepPercentages = ['16%', '33%', '50%', '66%', '83%', '100%'];

    const updateStepUI = (index: number) => {
      steps.forEach((step, i) => {
        if (i === index) {
          step.classList.remove('hidden');
          // Reset animation so it replays on each step
          step.style.animation = 'none';
          step.offsetHeight; // force reflow
          step.style.animation = '';
        } else {
          step.classList.add('hidden');
        }
      });

      if (progressBar) progressBar.style.width = stepPercentages[index];

      // Scroll to top of the form area smoothly
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // FUNCIÓN PARA ENVIAR MAIL DE DESCALIFICACIÓN
    const sendDisqualificationEmail = async (reason: string) => {
      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData);
        data.disqualificationReason = reason;

        await fetch('/api/qualify-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
      } catch (err) {
        console.warn('Disqualification email dispatch attempt:', err);
      }
    };

    const showDisqualification = (title: string, message: string) => {
      form.classList.add('hidden');
      if (progressContainer) progressContainer.classList.add('hidden');
      if (dqTitle) dqTitle.textContent = title;
      if (dqMessage) dqMessage.textContent = message;
      if (formDisqualified) formDisqualified.classList.remove('hidden');
      
      // Enviar mail automático al descalificar
      sendDisqualificationEmail(title + ': ' + message);
    };

    const handleStepAdvance = () => {
      const formData = new FormData(form);

      // Check Paso 2 (Index 1): Sin Ventas / Sin Oferta Validada
      if (currentStepIndex === 1) {
        const hasOffer = formData.get('hasValidatedOffer');
        if (hasOffer === 'no_sales' || hasOffer === 'no_store') {
          showDisqualification(
            'Disculpanos, por el momento no somos el match adecuado',
            'Para garantizar un retorno positivo de la inversión en Meta Ads, trabajamos únicamente con marcas que ya tienen una oferta validada con ventas activas (online, local físico o canal directo).'
          );
          return;
        }
      }

      // Check Paso 5 (Index 4): Menos de $5.000 USD Facturación
      if (currentStepIndex === 4) {
        const revenue = formData.get('revenue');
        if (revenue === '0_5k') {
          showDisqualification(
            'Gracias por tu interés en Algoritmia',
            'Actualmente nos enfocamos en marcas que facturan a partir de $5.000 USD mensuales. Esto nos asegura que el presupuesto de pauta no ahogue el margen de tu negocio.'
          );
          return;
        }
      }

      // Avance directo al siguiente paso
      if (currentStepIndex < steps.length - 1) {
        currentStepIndex++;
        updateStepUI(currentStepIndex);
      }
    };

    // Auto-avance al hacer clic en cualquier opción (event delegation)
    form.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      const card = target.closest('.option-card') as HTMLElement | null;
      if (!card) return;

      const radio = card.querySelector('input[type="radio"]') as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
        // Dispatch change so :has() CSS selector updates immediately
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }

      // 80ms: just enough for visual feedback, feels instant
      setTimeout(() => {
        handleStepAdvance();
      }, 80);
    });

    prevBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (currentStepIndex > 0) {
          currentStepIndex--;
          updateStepUI(currentStepIndex);
        }
      });
    });

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const errorDiv = document.getElementById('form-error');
    const retryBtn = document.getElementById('retry-btn');
    const sendingProgressBar = document.getElementById('sending-progress-bar');
    const loadingStatus = document.getElementById('loading-status');
    const loadingSubstatus = document.getElementById('loading-substatus');

    // Retry button resets form to step 6
    retryBtn?.addEventListener('click', () => {
      if (errorDiv) errorDiv.classList.add('hidden');
      if (progressContainer) progressContainer.classList.remove('hidden');
      form.classList.remove('hidden');
    });

    let isSubmitting = false;

    const doSubmit = async () => {
      if (isSubmitting) return;

      const nombreInput = document.getElementById('nombre') as HTMLInputElement | null;
      const emailInput = document.getElementById('email') as HTMLInputElement | null;
      const telefonoInput = document.getElementById('telefono') as HTMLInputElement | null;

      let hasFieldError = false;
      if (!nombreInput || !nombreInput.value.trim()) {
        nombreInput?.classList.add('border-red-500', 'bg-red-50');
        hasFieldError = true;
      } else {
        nombreInput?.classList.remove('border-red-500', 'bg-red-50');
      }

      if (!emailInput || !emailInput.value.trim()) {
        emailInput?.classList.add('border-red-500', 'bg-red-50');
        hasFieldError = true;
      } else {
        emailInput?.classList.remove('border-red-500', 'bg-red-50');
      }

      if (!telefonoInput || !telefonoInput.value.trim()) {
        telefonoInput?.classList.add('border-red-500', 'bg-red-50');
        hasFieldError = true;
      } else {
        telefonoInput?.classList.remove('border-red-500', 'bg-red-50');
      }

      if (hasFieldError) {
        alert('Por favor completá tu Nombre, Email y WhatsApp para enviar la postulación.');
        return;
      }

      isSubmitting = true;
      const loading = document.getElementById('form-loading');
      const success = document.getElementById('form-success');

      // Recolectar datos ANTES de ocultar el form
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      console.log('📤 Enviando postulación:', data);

      // Disable submit button and show spinner
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<div class="btn-spinner"></div><span>Enviando...</span>';
      }

      // Show inline loading UI with progress bar
      form.classList.add('hidden');
      if (progressContainer) progressContainer.classList.add('hidden');
      if (loading) loading.classList.remove('hidden');

      // Progress bar animation steps
      if (sendingProgressBar) sendingProgressBar.style.width = '25%';
      if (loadingStatus) loadingStatus.textContent = 'Procesando datos...';
      if (loadingSubstatus) loadingSubstatus.textContent = 'Validando tu perfil de marca';

      setTimeout(() => {
        if (sendingProgressBar) sendingProgressBar.style.width = '70%';
        if (loadingStatus) loadingStatus.textContent = 'Enviando email de notificación...';
        if (loadingSubstatus) loadingSubstatus.textContent = 'Enviando a algoritmiadesarrollos@gmail.com';
      }, 400);

      try {
        const res = await fetch('/api/qualify-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        console.log('📬 Respuesta API:', res.status, res.ok);

        if (res.ok) {
          if (sendingProgressBar) sendingProgressBar.style.width = '100%';
          if (loadingStatus) loadingStatus.textContent = '¡Mail enviado con éxito!';
          if (loadingSubstatus) loadingSubstatus.textContent = 'Postulación registrada correctamente';

          setTimeout(() => {
            if (loading) loading.classList.add('hidden');
            if (success) success.classList.remove('hidden');
          }, 500);
        } else {
          isSubmitting = false;
          if (loading) loading.classList.add('hidden');
          if (errorDiv) errorDiv.classList.remove('hidden');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Enviar Postulación</span>';
          }
        }
      } catch (err) {
        isSubmitting = false;
        console.error('Submit error:', err);
        if (loading) loading.classList.add('hidden');
        if (errorDiv) errorDiv.classList.remove('hidden');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Enviar Postulación</span>';
        }
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      doSubmit();
    });

    submitBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      doSubmit();
    });
  }

  // Support both normal load and Astro View Transitions
  document.addEventListener('DOMContentLoaded', initForm);
  document.addEventListener('astro:page-load', initForm);
</script>
