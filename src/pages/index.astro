	/* -------------------------------------------------------------
	   ANIMACIÓN DE CURSOR MOUSE & INTERACCIÓN DE CLIC 
	   ------------------------------------------------------------- */
	.animated-mouse {
		position: absolute;
		z-index: 20;
		pointer-events: none;
		filter: drop-shadow(0 4px 6px rgba(0,0,0,0.15));
	}

	.click-ripple {
		position: absolute;
		top: -4px;
		left: -4px;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: rgba(99, 102, 241, 0.5);
		transform: scale(0);
		opacity: 0;
	}

	/* Animación Mouse 01 (Búsqueda & Auditoría) */
	.mouse-step-01 {
		animation: moveMouse01 4.5s ease-in-out infinite;
	}
	.mouse-step-01 .click-ripple {
		animation: rippleClick01 4.5s ease-in-out infinite;
	}

	@keyframes moveMouse01 {
		0% { top: 80%; left: 85%; opacity: 0; }
		15% { top: 80%; left: 85%; opacity: 1; }
		45% { top: 22%; left: 45%; }
		50% { top: 22%; left: 45%; transform: scale(0.85); }
		55% { top: 22%; left: 45%; transform: scale(1); }
		75% { top: 62%; left: 50%; }
		80% { top: 62%; left: 50%; transform: scale(0.85); }
		85% { top: 62%; left: 50%; transform: scale(1); }
		100% { top: 80%; left: 85%; opacity: 0; }
	}

	@keyframes rippleClick01 {
		50% { transform: scale(1.6); opacity: 0.8; }
		55% { transform: scale(2.2); opacity: 0; }
		80% { transform: scale(1.6); opacity: 0.8; }
		85% { transform: scale(2.2); opacity: 0; }
	}

	/* Animación Mouse 02 (Segmentos & Audiencias) */
	.mouse-step-02 {
		animation: moveMouse02 4.5s ease-in-out infinite;
	}
	.mouse-step-02 .click-ripple {
		animation: rippleClick02 4.5s ease-in-out infinite;
	}

	@keyframes moveMouse02 {
		0% { top: 85%; left: 10%; opacity: 0; }
		15% { top: 85%; left: 10%; opacity: 1; }
		50% { top: 58%; left: 40%; }
		55% { top: 58%; left: 40%; transform: scale(0.85); }
		60% { top: 58%; left: 40%; transform: scale(1); }
		100% { top: 85%; left: 10%; opacity: 0; }
	}

	@keyframes rippleClick02 {
		55% { transform: scale(1.8); opacity: 0.8; }
		60% { transform: scale(2.4); opacity: 0; }
	}

	/* Animación Mouse 03 (Interruptor EN VIVO) */
	.mouse-step-03 {
		animation: moveMouse03 4.5s ease-in-out infinite;
	}
	.mouse-step-03 .click-ripple {
		animation: rippleClick03 4.5s ease-in-out infinite;
	}

	@keyframes moveMouse03 {
		0% { top: 80%; left: 85%; opacity: 0; }
		15% { top: 80%; left: 85%; opacity: 1; }
		45% { top: 18%; left: 78%; }
		50% { top: 18%; left: 78%; transform: scale(0.85); }
		55% { top: 18%; left: 78%; transform: scale(1); }
		100% { top: 80%; left: 85%; opacity: 0; }
	}

	@keyframes rippleClick03 {
		50% { transform: scale(1.8); opacity: 0.9; }
		55% { transform: scale(2.4); opacity: 0; }
	}

	/* Animación Mouse 04 (Ajuste & Escala) */
	.mouse-step-04 {
		animation: moveMouse04 4.5s ease-in-out infinite;
	}
	.mouse-step-04 .click-ripple {
		animation: rippleClick04 4.5s ease-in-out infinite;
	}

	@keyframes moveMouse04 {
		0% { top: 85%; left: 20%; opacity: 0; }
		15% { top: 85%; left: 20%; opacity: 1; }
		50% { top: 20%; left: 45%; }
		55% { top: 20%; left: 45%; transform: scale(0.85); }
		60% { top: 20%; left: 45%; transform: scale(1); }
		100% { top: 85%; left: 20%; opacity: 0; }
	}

	@keyframes rippleClick04 {
		55% { transform: scale(1.8); opacity: 0.8; }
		60% { transform: scale(2.4); opacity: 0; }
	}

