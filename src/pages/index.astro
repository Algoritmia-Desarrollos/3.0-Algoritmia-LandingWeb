---

<Layout
	title="Algoritmia | Expertos en Meta Ads"
	description="Multiplicamos la facturación de tu negocio en Meta Ads con nuestro método probado y anuncios de alto rendimiento."
	ogTitle="Algoritmia | Expertos en Meta Ads"
	ogDescription="Multiplicamos la facturación de tu negocio en Meta Ads con nuestro método probado y anuncios de alto rendimiento."
>

	<!-- Header de Navegación -->
	<header class="floating-header" aria-label="Navegación principal">
		<a class="logo-bubble" href="#inicio" aria-label="Algoritmia, volver al inicio">
			<img loading="eager" decoding="async" src="/logoAlgoritmia.webp" alt="Algoritmia Logo" width="42" height="42" decoding="async"/>
		</a>
		<nav class="nav-links">
			<a href="#testimonios">Testimonios</a>
			<a href="#como-funciona">Cómo funciona</a>
			<a href="#faq">Preguntas</a>
			<a href="/contacto">Contacto</a>
		</nav>
		<div class="header-actions">
			<a class="outline-cta" href="/contacto">Comencemos <span>→</span></a>
			<a class="header-cta-mobile" href="/contacto">Comencemos</a>
		</div>
	</header>

	<main class="landing-content">
		<!-- Hero Section -->
		<section class="hero-section" id="inicio">
			<div class="hero-wrapper">
				<h1 class="hero-title">
					<span class="hero-line">Escalá la facturación de tu marca</span>
					<span class="hero-line">con <em>campañas rentables</em> en Meta.</span>
				</h1>
				
				<!-- Hero Video Container con video alojado en Supabase -->
				<div class="hero-video-container" id="heroVideoContainer">
					<div class="video-border-effect"></div>
					<video 
						id="heroVideo"
						src="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/creattia-media/heroVideoAlgoritmia.mp4"
						autoplay 
						muted 
						playsinline 
						loop
						preload="auto"
						class="hero-native-video"
					></video>
					<button class="sound-overlay-badge" id="soundBadge" aria-label="Activar sonido">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H2v6h4l5 4V5zM23 9l-6 6M17 9l6 6"/></svg>
						<span>Tocar para activar sonido</span>
					</button>
				</div>

				<div class="hero-content-block">
					<p class="hero-subtitle">
						Multiplicamos la facturación de tu negocio en Meta Ads con nuestro método probado para conseguir resultados escalables y predecibles.
					</p>
					<div class="hero-actions">
						<a class="gradient-cta" href="/contacto">
							<span>Quiero escalar mi marca</span>
							<svg class="cta-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path></svg>
						</a>
					</div>
				</div>

				<div class="hero-rating-wrapper">
					<div class="rating-stars">
						<div class="avatars-group">
							<img class="rating-avatar-img" src="https://tryholo.ai/rootPage/assets/SocialProof/footer-1.webp" alt="User 1" decoding="async" loading="lazy"/>
							<img class="rating-avatar-img" src="https://tryholo.ai/rootPage/assets/SocialProof/footer-2.webp" alt="User 2" decoding="async" loading="lazy"/>
							<img class="rating-avatar-img" src="https://tryholo.ai/rootPage/assets/SocialProof/footer-3.webp" alt="User 3" decoding="async" loading="lazy"/>
							<img class="rating-avatar-img" src="https://tryholo.ai/rootPage/assets/SocialProof/footer-4.webp" alt="User 4" decoding="async" loading="lazy"/>
						</div>
						<span class="rating-text"><strong>4.9</strong>/5 de más de <strong>92</strong> negocios</span>
						<svg class="rating-star-icon" viewBox="0 0 24 24" width="18" height="18" fill="url(#starGrad)"><defs><linearGradient id="starGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#f59e0b"/><stop offset="100%" stop-color="#fbbf24"/></linearGradient></defs><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
					</div>
				</div>
			</div>
		</section>

		<!-- Showcase Section / Testimonials Carousel -->
		<section class="showcase-section" id="testimonios">
			<div class="showcase-container">
				<div class="showcase-header-wrapper" style="text-align: left; margin-bottom: 40px;">
					<h2 class="banner-heading" style="font-size: clamp(18px, 4.8vw, 38px); font-weight: 800; line-height: 1.25; letter-spacing: -0.03em; color: var(--text-dark); margin: 0;">
						Probablemente ya viste nuestro trabajo.<br />
						Solo que no sabías que era de Algoritmia.
					</h2>
				</div>

				<div class="showcase-marquee" aria-label="Testimonios en video de Algoritmia">
					<div class="showcase-track">
						{videoTestimonials.map((item) => (
							<div class="showcase-card testimonial-video-card">
								<img class="video-cover-img" src={item.cover} alt={`Portada de ${item.title}`} loading="lazy" />
								<video class="testimonial-video" preload="none" playsinline loop controls>
									<source src={item.video} type="video/mp4" />
								</video>
								<div class="card-overlay">
									<span class="card-tag">{item.tag}</span>
									<div class="card-info-bottom">
										<h3 class="card-title">{item.title}</h3>
										<span class="card-stat">{item.stat}</span>
									</div>
									<button class="play-btn" aria-label="Reproducir">
										<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
									</button>
								</div>
							</div>
						))}
					</div>
				</div>
				
				<div class="showcase-footer-nav">
					<div class="carousel-nav-arrows">
						<button class="arrow-nav-btn prev-btn" aria-label="Anterior">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
						</button>
						<button class="arrow-nav-btn next-btn" aria-label="Siguiente">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Manifesto Section with Inline Animating Videos -->
		<section class="manifesto-section">
			<div class="manifesto-container">
				<p class="manifesto-line">
					En Algoritmia estamos revolucionando cómo los negocios
					<span class="inline-video-wrapper">
						<video autoplay loop muted playsinline preload="metadata">
							<source src="https://tryholo.ai/rootPage/assets/integrationText/Bulb.mp4" type="video/mp4" />
						</video>
					</span>
					escalan.
				</p>
				<p class="manifesto-line">
					Usando nuestro método probado de pauta y creativos de alto rendimiento impulsamos
					<span class="inline-video-wrapper">
						<video autoplay loop muted playsinline preload="metadata">
							<source src="https://tryholo.ai/rootPage/assets/integrationText/brain.mp4" type="video/mp4" />
						</video>
					</span>
					la facturación de tu marca logrando resultados predecibles en todas las
					<span class="inline-video-wrapper">
						<video autoplay loop muted playsinline preload="metadata">
							<source src="https://tryholo.ai/rootPage/assets/integrationText/socials.mp4" type="video/mp4" />
						</video>
					</span>
					plataformas.
				</p>
				<p class="manifesto-line">
					Para que puedas hacer crecer tu negocio de forma sostenida
					<span class="inline-video-wrapper">
						<video autoplay loop muted playsinline preload="metadata">
							<source src="https://tryholo.ai/rootPage/assets/integrationText/team.mp4" type="video/mp4" />
						</video>
					</span>
					sin depender de la suerte.
				</p>
			</div>
		</section>

		<!-- Product Video Walkthrough Section (Hidden temporarily) -->
		<!-- <section class="walkthrough-video-section" style="display: none;">
			<div class="walkthrough-video-wrapper">
				<div class="walkthrough-video-container">
					<video autoplay muted loop playsinline preload="metadata">
						<source src="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/creattia-media/walkthrough.mp4" type="video/mp4" />
					</video>
				</div>
			</div>
		</section> -->

		<!-- How It Works Section (TryHolo Vertical Clone) -->
		<section class="how-it-works" id="como-funciona">
			<div class="section-header">
				<span class="section-tag font-bold">CÓMO FUNCIONA</span>
				<h2>Método Algor paso a paso</h2>
			</div>
			
			<div class="steps-vertical-container">
				{steps.map((step, idx) => (
					<div class="step-vertical-row">
						<!-- Left indicator column -->
						<div class="step-left-line-col">
							<span class="step-vertical-number">{step.number}</span>
							{idx < steps.length - 1 && (
								<div class="step-vertical-line" style={`background-image: linear-gradient(to bottom, ${idx === 0 ? '#3e86c6, #a666aa' : idx === 1 ? '#a666aa, #ec4492' : '#ee4454, #f05427'})`}></div>
							)}
						</div>
						
						<!-- Content and Demo columns -->
						<div class="step-vertical-content-wrapper">
							<div class="step-vertical-text">
								<h3>{step.title}</h3>
								<p>{step.copy}</p>
							</div>
							
							<div class="step-vertical-demo-box">
								{step.number === '01' && (
									<div class="step-card-mockup step-card-video-wrapper">
										<video 
											src="/videos/step01.mp4" 
											autoplay 
											loop 
											muted 
											playsinline 
											class="remotion-step-video"
										></video>
									</div>
								)}

								{step.number === '02' && (
