---
import Layout from '../layouts/Layout.astro';
import { CheckCircle2, MessageCircle, ArrowLeft } from 'lucide-astro';
---

<Layout 
  title="¡Postulación Recibida! | Algoritmia" 
  description="Recibimos tu postulación correctamente. Evaluaremos tus datos y te contactaremos en menos de 24 hs."
>
  <div class="min-h-screen bg-white text-slate-900 font-sans flex flex-col justify-between">
    
    <!-- Header Navigation -->
    <header class="max-w-lg mx-auto w-full px-5 sm:px-8 pt-8 pb-4">
      <div class="inline-flex items-center gap-2.5">
        <img loading="eager" decoding="async" src="/logoAlgoritmia.webp" alt="Algoritmia Logo" class="w-8 h-8 object-contain" />
        <span class="font-bold text-xl tracking-tight text-slate-900">Algoritmia</span>
      </div>
    </header>

    <!-- Main Thank You Content -->
    <main class="flex-1 w-full px-5 sm:px-8 py-12 flex items-center justify-center">
      <div class="w-full max-w-md mx-auto text-center space-y-6">
        
        <div class="w-16 h-16 bg-emerald-50 border border-emerald-200 rounded-3xl flex items-center justify-center mx-auto text-emerald-600 shadow-sm animate-bounce-short">
          <CheckCircle2 class="w-9 h-9" />
        </div>

        <div class="space-y-2">
          <span class="inline-block px-3 py-1 bg-emerald-100/80 text-emerald-800 font-semibold text-xs rounded-full">
            Notificación Enviada
          </span>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
            ¡Tu perfil califica y recibimos tu postulación!
          </h1>
        </div>

        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed max-w-sm mx-auto">
          Analizaremos las métricas de tu marca y te escribiremos por <strong class="text-slate-900 font-semibold">WhatsApp</strong> en menos de 24 horas para agendar tu llamada estratégica.
        </p>

        <div class="pt-4 flex flex-col sm:flex-row gap-3 justify-center">
          <a 
            href="https://wa.me/5493476245523" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-xl transition-all shadow-md shadow-emerald-600/20 text-xs sm:text-sm"
          >
            <MessageCircle class="w-4.5 h-4.5" />
            <span>Hablar por WhatsApp Ahora</span>
          </a>
          
          <a 
            href="/" 
            class="inline-flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3.5 px-6 rounded-xl transition-all text-xs sm:text-sm"
          >
            <ArrowLeft class="w-4 h-4" />
            <span>Volver al Inicio</span>
          </a>
        </div>

      </div>
    </main>

    <!-- Footer Simple -->
    <footer class="py-6 text-center text-xs text-slate-400 space-y-1">
      <p>© {new Date().getFullYear()} Algoritmia · QUILLSTONE DIGITAL LLC. Todos los derechos reservados.</p>
      <p>1057 NW 136TH AVE, MIAMI, FL 33182</p>
    </footer>

  </div>
</Layout>

<style>
  @keyframes bounceShort {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .animate-bounce-short {
    animation: bounceShort 2s ease-in-out infinite;
  }
</style>
