---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="¡Gracias! — Algoritmia" 
  description="Gracias por tu interés. Revisamos tu perfil y te contactamos en menos de 24 hs."
  noindex={true}
>
  <main class="min-h-screen bg-white flex flex-col items-center justify-center px-6 text-center">
    
    <div class="max-w-xl mx-auto reveal">
      <div class="w-20 h-20 bg-rose-50 rounded-full flex items-center justify-center mx-auto mb-8 border border-rose-100">
        <span class="material-symbols-outlined text-4xl text-rose-500 animate-bounce">check_circle</span>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-primary mb-6">
        ¡Recibimos tu solicitud!
      </h1>
      
      <p class="text-lg text-primary/60 mb-10 leading-relaxed">
        Nuestro equipo está revisando tu marca. Te contactaremos por <span class="font-bold text-primary">WhatsApp</span> en las próximas 24 horas para agendar una llamada si calificas para el sistema.
      </p>

      <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
        <a href="/" class="cta-btn px-8 py-4 rounded-full text-white font-semibold text-sm transition-all flex items-center gap-2">
          Volver al inicio
          <span class="material-symbols-outlined text-sm">home</span>
        </a>
        <a href="https://wa.me/5493476245523" target="_blank" class="px-8 py-4 rounded-full border border-emerald-500/20 text-emerald-600 bg-emerald-50/50 font-semibold text-sm hover:bg-emerald-50 transition-all flex items-center gap-2">
          Escribinos por WhatsApp
          <span class="material-symbols-outlined text-sm">chat</span>
        </a>
      </div>
    </div>

  </main>

  <style>
    .cta-btn {
      background: #f43f5e;
      box-shadow: 0 4px 15px rgba(244, 63, 94, 0.3);
    }
    .cta-btn:hover {
      box-shadow: 0 6px 22px rgba(244, 63, 94, 0.4);
      transform: translateY(-1px);
    }
  </style>

</Layout>
