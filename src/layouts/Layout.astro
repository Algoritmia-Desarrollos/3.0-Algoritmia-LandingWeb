---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';

interface Props {
	title: string;
	description?: string;
    noindex?: boolean;
}

const { title, description = "Algoritmia: agencia experta en Meta Ads para negocios establecidos en Argentina. Escalamos ventas con método probado. ROAS 43–70. Casos reales. Consulta gratuita.", noindex = false } = Astro.props;
const canonicalURL = Astro.url.href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "Algoritmia",
      "url": "https://algoritmiadesarrollos.com.ar",
      "logo": "https://algoritmiadesarrollos.com.ar/logoAlgoritmia.webp",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+54-9-3476-24-5523",
        "email": "algoritmiadesarrollos@gmail.com",
        "contactType": "customer service"
      },
      "sameAs": [
        "https://www.instagram.com/algoritmia.ads"
      ]
    },
    {
      "@type": "ProfessionalService",
      "name": "Algoritmia",
      "description": "Agencia experta en Meta Ads para negocios establecidos en Argentina y Latinoamérica. Escalamos ventas con método probado. ROAS 43–70.",
      "url": "https://algoritmiadesarrollos.com.ar",
      "telephone": "+54-9-3476-24-5523",
      "email": "algoritmiadesarrollos@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "AR",
        "addressRegion": "Buenos Aires"
      },
      "priceRange": "$$$"
    }
  ]
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
		<meta name="author" content="Algoritmia" />

		<!-- Preconnect hints -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://connect.facebook.net" />

		<!-- Open Graph -->
		<meta property="og:title" content="Algoritmia | Expertos en Meta Ads" />
		<meta property="og:description" content="Escalamos negocios establecidos con Meta Ads. ROAS 43–70. Método probado. Casos reales." />
		<meta property="og:url" content="https://algoritmiadesarrollos.com.ar" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:image" content="https://algoritmiadesarrollos.com.ar/og-image.jpg" />
		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Algoritmia | Expertos en Meta Ads" />
		<meta name="twitter:description" content="Escalamos negocios establecidos con Meta Ads. ROAS 43–70. Método probado." />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!-- Material Symbols — async (non render-blocking) -->
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
		<noscript><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" /></noscript>
        
		<ClientRouter />

		<!-- Meta Pixel Code -->
		<script is:inline>
			!function(f,b,e,v,n,t,s)
			{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
			n.callMethod.apply(n,arguments):n.queue.push(arguments)};
			if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
			n.queue=[];t=b.createElement(e);t.async=!0;
			t.src=v;s=b.getElementsByTagName(e)[0];
			s.parentNode.insertBefore(t,s)}(window, document,'script',
			'https://connect.facebook.net/en_US/fbevents.js');
			fbq('init', '4451217315114761');
			fbq('track', 'PageView');
		</script>
		<noscript>
			<img height="1" width="1" style="display:none"
			src="https://www.facebook.com/tr?id=4451217315114761&ev=PageView&noscript=1"/>
		</noscript>
		<!-- End Meta Pixel Code -->

		<!-- Meta Pixel: Re-fire PageView on Astro View Transitions -->
		<script is:inline>
			// Astro View Transitions triggers 'astro:page-load' on every navigation.
			// We re-fire PageView so Meta Pixel tracks all virtual page changes.
			document.addEventListener('astro:page-load', function() {
				if (window.fbq) {
					window.fbq('track', 'PageView');
				}
			});
		</script>
		<!-- End Meta Pixel View Transitions -->
	</head>
	<body class="antialiased text-gray-900 bg-white">
    <!-- Preloader -->
    <div id="preloader" class="fixed inset-0 z-[999] bg-white flex items-center justify-center transition-opacity duration-500">
        <div class="w-8 h-8 border-4 border-primary/20 border-t-primary rounded-full animate-spin"></div>
    </div>

    <slot />

    <script>
      // Fix Instagram IAB viewport height bug:
      // Capturamos el --vh UNA SOLA VEZ al cargar la página.
      // Así, cuando Instagram muestra su barra inferior al hacer scroll up,
      // el viewport cambia pero los elementos que usan --vh no se recalculan.
      (function() {
        var vh = window.innerHeight * 0.01;
        document.documentElement.style.setProperty('--vh', vh + 'px');
      })();

      // Preloader Logic
      document.addEventListener('astro:page-load', () => {
        // Short timeout to ensure smooth transition
        setTimeout(() => {
            const preloader = document.getElementById('preloader');
            if (preloader) {
                preloader.style.opacity = '0';
                setTimeout(() => {
                    preloader.remove();
                }, 500);
            }
        }, 100);
      });
    </script>
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
	}

	html {
		font-family: 'Inter Variable', sans-serif;
		background: #13151a;
		scroll-behavior: auto; /* Se activa via JS solo cuando NO hay resize */
        width: 100%;
        overflow-x: hidden;
        overscroll-behavior-y: none; /* Evita el bounce/jump en Safari e Instagram */
	}

    /* Solo activar smooth scroll en desktop o cuando no hay movimiento reducido */
    @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
        html {
            scroll-behavior: smooth;
        }
    }

    /* Fix para Instagram IAB y Safari: usa --vh fija para evitar el salto
       cuando aparece/desaparece la barra de navegación inferior.
       IMPORTANTE: calc(var(--vh)*100) debe ir ÚLTIMO para ganar el cascade.
       --vh se setea UNA SOLA VEZ al cargar, por eso no salta. */
    .min-h-screen-fix {
        min-height: 100dvh;                    /* fallback para browsers viejos */
        min-height: calc(var(--vh, 1vh) * 100); /* gana en browsers modernos - valor ESTÁTICO */
    }

    /* SISTEMA DE ANIMACIONES */
    .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        filter: blur(5px);
    }
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
    }
    .delay-100 { transition-delay: 0.1s; }
    .delay-200 { transition-delay: 0.2s; }
    .delay-300 { transition-delay: 0.3s; }
</style>

<script>
    // ANIMACIONES
    const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
    };
    
    const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
                observer.unobserve(entry.target); 
            }
        });
    }, observerOptions);

    function initAnimations() {
        const revealElements = document.querySelectorAll('.reveal');
        revealElements.forEach(el => observer.observe(el));
    }

    document.addEventListener('astro:page-load', initAnimations);
    document.addEventListener('DOMContentLoaded', initAnimations);


</script>
