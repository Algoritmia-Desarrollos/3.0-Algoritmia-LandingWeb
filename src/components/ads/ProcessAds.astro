---
const steps = [
  {
    number: "01",
    title: "Auditoría & Objetivos",

    description: "Analizamos tu situación actual y definimos metas claras. Estudiamos a tu competencia para diseñar una hoja de ruta ganadora."
  },
  {
    number: "02",
    title: "Estrategia & Estructura",

    description: "Implementamos la estructura del Método Algoritmia en Meta Ads. Configuramos la medición, definimos tu segmento y creamos los activos para generar resultados."
  },
  {
    number: "03",
    title: "Lanzamiento",

    description: "Activamos las campañas siguiendo nuestra metodología. Medimos cada resultado desde el día 1 para validar la estrategia."
  },
  {
    number: "04",
    title: "Ajuste & Escala",

    description: "Analizamos y optimizamos los resultados semanalmente. Ajustamos la trayectoria para asegurar los objetivos y maximizar el potencial de tu negocio."
  }
];
---

<section class="py-32 px-6 md:px-12 max-w-[1440px] mx-auto bg-white" id="process">
  <div class="mb-20 text-center reveal">
    <h2 class="text-3xl md:text-5xl font-semibold tracking-tight mb-6 text-primary">Método Algoritmia</h2>
    <p class="text-primary/60 text-lg max-w-2xl mx-auto">
      Un sistema probado para escalar sin depender de la suerte.
    </p>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative">
    
    <!-- Connection Line (Desktop) -->
    <div class="hidden lg:block absolute top-12 left-[12%] right-[12%] h-0.5 bg-gradient-to-r from-primary/5 via-primary/20 to-primary/5 z-0"></div>

    {steps.map((step, index) => (
      <div class="group relative bg-surface p-8 rounded-3xl border border-primary/5 hover:border-primary/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg reveal z-10" style={`transition-delay: ${index * 100}ms`}>
        <div class="w-16 h-16 rounded-2xl bg-primary flex items-center justify-center mb-6 shadow-md group-hover:scale-105 transition-transform duration-300">
          <span class="text-2xl font-black text-white tracking-tight">{step.number}</span>
        </div>
        <h3 class="text-xl font-bold tracking-tight mb-4 text-primary">{step.title}</h3>
        


        <p class="text-base text-primary/70 leading-relaxed">
          {step.description}
        </p>
      </div>
    ))}
  </div>
</section>
