---
import Layout from '../../layouts/Layout.astro';

interface Props {
  qualified: boolean;
}

const { qualified } = Astro.props;
const title = qualified ? 'Tu marca califica — Sistema C.A.R' : 'Resultado de tu aplicación — Sistema C.A.R';
---

<Layout
  title={title}
  description="Resultado de la aplicación al Sistema C.A.R para marcas de cosmética."
  noindex={true}
>
  <main class:list={['result-page', { qualified }] }>
    <section class="result-card" aria-labelledby="result-title">
      <div class="result-icon" aria-hidden="true">{qualified ? '✓' : '↗'}</div>
      <p class="eyebrow">{qualified ? 'Tu marca califica' : 'Resultado de tu aplicación'}</p>
      <h1 id="result-title">
        {qualified ? 'Tu negocio está listo para dar el siguiente paso.' : 'Todavía no es el momento indicado.'}
      </h1>

      {qualified ? (
        <>
          <p class="description">Por lo que nos contaste, tu marca cumple con los requisitos para aplicar al Sistema C.A.R.</p>
          <div class="notice">
            <strong>Recibimos tu solicitud.</strong>
            <span>Nuestro equipo va a revisar tu caso y te contactará por WhatsApp dentro de las próximas 24 horas.</span>
          </div>
        </>
      ) : (
        <>
          <p class="description">El Sistema C.A.R está diseñado para marcas que ya cuentan con una base mínima para poder escalar.</p>
          <div class="requirements" aria-label="Requisitos para calificar">
            <div><span aria-hidden="true">01</span><p><strong>Tienda online activa</strong> para poder medir y optimizar las ventas.</p></div>
            <div><span aria-hidden="true">02</span><p><strong>Facturación mensual desde USD 8.000</strong> para que el sistema tenga margen real de crecimiento.</p></div>
          </div>
          <p class="encouragement">Cuando cumplas ambos requisitos, podés volver a aplicar.</p>
        </>
      )}

      <a href="/skincare">Volver a la página principal <span aria-hidden="true">→</span></a>
    </section>
  </main>
</Layout>

<style>
  :global(body) { margin: 0; background: #fff8f6; }
  .result-page { min-height: 100svh; box-sizing: border-box; padding: 32px 20px; display: grid; place-items: center; color: #1b1619; background: radial-gradient(circle at 50% 0%, rgba(255,194,209,.48), transparent 38%), linear-gradient(180deg, #fff9f7, #fff); }
  .result-card { width: min(680px, 100%); box-sizing: border-box; padding: clamp(34px, 6vw, 64px); border: 1px solid rgba(40,25,32,.09); border-radius: 32px; background: rgba(255,255,255,.9); box-shadow: 0 32px 90px rgba(83,34,52,.14); text-align: center; }
  .result-icon { width: 62px; height: 62px; margin: 0 auto 23px; border-radius: 50%; display: grid; place-items: center; color: #b94462; background: #ffe8ee; font-size: 26px; font-weight: 850; }
  .qualified .result-icon { color: #fff; background: #f43f5e; box-shadow: 0 14px 34px rgba(244,63,94,.28); }
  .eyebrow { margin: 0 0 15px; color: #df3158; font-size: 11px; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin: 0 auto; max-width: 570px; font-size: clamp(39px, 7vw, 62px); line-height: .98; letter-spacing: -.06em; text-wrap: balance; }
  .description { max-width: 520px; margin: 24px auto 0; color: #746a70; font-size: 17px; line-height: 1.6; text-wrap: balance; }
  .notice { margin: 30px auto 0; padding: 21px 23px; border: 1px solid #f5d7df; border-radius: 18px; display: grid; gap: 6px; color: #63565c; background: #fff7f9; font-size: 14px; line-height: 1.5; }
  .notice strong { color: #20191d; font-size: 16px; }
  .requirements { margin: 30px auto 0; display: grid; gap: 11px; text-align: left; }
  .requirements > div { padding: 17px 18px; border: 1px solid #eee4e8; border-radius: 16px; display: flex; align-items: flex-start; gap: 14px; background: #fff; }
  .requirements span { width: 32px; height: 32px; flex: 0 0 auto; border-radius: 50%; display: grid; place-items: center; color: #d83258; background: #fff0f4; font-size: 10px; font-weight: 850; }
  .requirements p { margin: 0; color: #71666c; font-size: 14px; line-height: 1.5; }
  .requirements strong { color: #251e22; }
  .encouragement { margin: 20px 0 0; color: #81767c; font-size: 13px; }
  a { min-height: 52px; margin: 30px auto 0; padding: 0 23px; width: fit-content; border-radius: 999px; display: inline-flex; align-items: center; gap: 10px; color: #fff; background: #1b1619; text-decoration: none; font-size: 13px; font-weight: 800; transition: transform .2s ease, background .2s ease; }
  a:hover { background: #f43f5e; transform: translateY(-2px); }
  @media (max-width: 560px) {
    .result-page { padding: 18px 14px; }
    .result-card { padding: 34px 20px; border-radius: 24px; }
    .result-icon { width: 54px; height: 54px; margin-bottom: 20px; }
    .description { font-size: 15px; }
    .requirements > div { padding: 15px; }
  }
</style>
